<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorPrimaryVariant">@color/pink</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pink</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowAnimationStyle">
            @style/activityTransition
        </item>
    </style>

    <style name="AlertDialogTransparent" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="FullWidthDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowElevation">24dp</item>
    </style>

    <style name="RoundedDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <item name="materialAlertDialogTheme">@style/RoundedDialogTheme</item>
        <item name="cornerRadius">16dp</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogPinkButton</item>
    </style>

    <style name="DialogPinkButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>

    <!-- Professional Splash Screen Theme -->
    <!--
        Parents Theme.SplashScreen so Android 12+ uses AndroidX's splash pipeline.
        The system splash is unavoidable on API 31+, so we make it invisible:
          - windowSplashScreenAnimatedIcon is 1x1 transparent (no logo).
          - windowSplashScreenBackground matches the center of splash_gradient_background
            (same pink) so there's no color flash when SplashScreenActivity takes over.
          - windowSplashScreenAnimationDuration=0 dismisses the system splash ASAP.
          - postSplashScreenTheme swaps to AppTheme when the activity is interactive.
    -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/pink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pink</item>
        <item name="android:navigationBarColor">@color/pink</item>
    </style>

