<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <!-- BUG 8 — the text cursor, both selection handles and the selection highlight are
         all tinted from colorControlActivated. Nothing in the app used to declare it, so
         each screen inherited its parent theme's default: the Material family on
         activities (blue/purple) and the Design/AppCompat family on bottom sheets
         (teal/green). That is the reported blue-vs-green split.

         Declaring it once here pins every text field in the app — including the dozen
         that carry no android:textCursorDrawable at all. The same two items are repeated
         on each dialog/sheet theme below, because a Dialog window builds its own theme
         from its own parent and does NOT inherit these from AppTheme.

         Deliberate side effect (owner-approved 28-Jul): the checked/active state of
         checkboxes, radios, switches and seekbars also becomes brand pink instead of the
         inherited default. colorPrimary is intentionally NOT set — buttons, tabs and the
         bottom nav keep the explicit colours in their own styles. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <!-- BUG 29 — the app targets SDK 35, and Android 15 turns
             Window.setStatusBarColor()/setNavigationBarColor() into no-ops: it forces
             edge-to-edge and makes both bars transparent. The app sets those colours in
             46 places, so the SAME APK painted its bars on Android <=14 and showed the
             screen through them on 15+. QA photographed two handsets side by side and
             read it as "the same screen changes colour". Opting out restores the
             setters so every Android version renders identically, which is the whole
             point of the ticket.
             This attribute only exists while we target SDK 35 — Google removes it at
             SDK 36, at which point the real fix is proper edge-to-edge with insets and
             scrims on every screen. Treat this as a dated bridge, not a resting place. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorPrimaryVariant">@color/pink</item>
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:textColorHighlight">@color/pink_selection</item>
        <!-- BUG 29 — white, not pink. ~12 activities never set a bar colour at all and
             silently inherited this default, so they showed a pink status bar above a
             white navigation bar while every screen that DID set one used white. Making
             the default match the light rule means a new screen is uniform without
             having to remember anything; only genuinely dark screens now opt out, via
             applyImmersiveSystemBars(). -->
        <item name="android:statusBarColor" tools:targetApi="l">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowAnimationStyle">
            @style/activityTransition
        </item>
    </style>

    <!-- Bug #2 (27-Jul) — opaque variant of AppTheme for the call-connecting screens.
         AppTheme sets windowIsTranslucent=true app-wide, so a launching activity's
         window stays see-through until it paints its own opaque content; on the heavy
         connecting layout that left the previous Chat/Profile page visible for ~2-3s.
         Making JUST these two activities opaque with a dark windowBackground lets the
         framework draw that background the instant the window appears — covering the
         old page immediately — while the rest of the app keeps its existing theme.
         windowBackground matches the connecting layout's own #0D0D10 root, so there
         is zero visual change other than it appearing sooner. -->
    <style name="AppTheme.CallConnecting" parent="AppTheme">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@color/call_connecting_bg</item>
    </style>

    <!-- BUG 29 — FullscreenImageActivity is the one screen of ours on a raw framework
         theme, so it does not inherit AppTheme's edge-to-edge opt-out. Same parent as
         before (a DARK AppCompat theme — switching it to AppTheme would restyle its
         widgets), plus the opt-out so its bars behave like every other screen on
         Android 15. -->
    <style name="AppTheme.FullscreenImage" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
    </style>

    <style name="AlertDialogTransparent" parent="Theme.MaterialComponents.Dialog.Alert">
        <!-- BUG 8 — see AppTheme; dialog themes don't inherit it. -->
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:textColorHighlight">@color/pink_selection</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">88%</item>
        <item name="android:windowMinWidthMinor">88%</item>
    </style>

    <style name="FullWidthDialog" parent="Theme.MaterialComponents.Light.Dialog">
        <!-- BUG 8 — see AppTheme; dialog themes don't inherit it. -->
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:textColorHighlight">@color/pink_selection</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowElevation">24dp</item>
    </style>

    <style name="RoundedDialogTheme" parent="Theme.MaterialComponents.Light.Dialog">
        <!-- BUG 8 — colorPrimary below already pinks this dialog's buttons, but the
             cursor and handles read colorControlActivated, so it needs that too. -->
        <item name="colorControlActivated">@color/colorAccent</item>
        <item name="android:textColorHighlight">@color/pink_selection</item>
        <item name="materialAlertDialogTheme">@style/RoundedDialogTheme</item>
        <item name="cornerRadius">16dp</item>
        <item name="colorPrimary">@color/colorAccent</item>
        <item name="buttonBarPositiveButtonStyle">@style/DialogPinkButton</item>
    </style>

    <style name="DialogPinkButton" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/colorAccent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
    </style>

    <!-- Professional Splash Screen Theme -->
    <!--
        Parents Theme.SplashScreen so Android 12+ uses AndroidX's splash pipeline.
        The system splash is unavoidable on API 31+, so we make it invisible:
          - windowSplashScreenAnimatedIcon is 1x1 transparent (no logo).
          - windowSplashScreenBackground matches the center of splash_gradient_background
            (same pink) so there's no color flash when SplashScreenActivity takes over.
          - windowSplashScreenAnimationDuration=0 dismisses the system splash ASAP.
          - postSplashScreenTheme swaps to AppTheme when the activity is interactive.
    -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <!-- BUG 29 — splash does not inherit AppTheme, so it needs the opt-out too or
             its pink bars vanish on Android 15 and the app opens with a different
             looking first frame per device. -->
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:targetApi="35">true</item>
        <item name="windowSplashScreenBackground">@color/pink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pink</item>
        <item name="android:navigationBarColor">@color/pink</item>
    </style>

