<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="colorPrimaryVariant">@color/pink</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pink</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowAnimationStyle">
            @style/activityTransition
        </item>
    </style>

    <!-- Professional Splash Screen Theme -->
    <style name="SplashTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_gradient_background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:statusBarColor" tools:targetApi="l">@color/pink_bold</item>
        <item name="android:navigationBarColor">@color/pink_bold</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds" tools:targetApi="lollipop">true</item>
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

<!--    &lt;!&ndash; Theme for dark mode &ndash;&gt;-->
<!--    <style name="AppTheme.Dark" parent="Theme.MaterialComponents.DayNight.NoActionBar">-->
<!--        <item name="android:windowIsTranslucent">true</item>-->
