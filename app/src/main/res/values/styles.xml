    <!-- B_042 — one canonical primary/secondary button size across screens (Submit Ticket,
         Delete Account, Unblock, post-call feedback). Standard: 56dp tall, 12dp corners,
         16sp semibold. layout_width/height/weight/margins + backgroundTint/stroke stay
         per-button (full-width CTA vs weighted dialog pair). -->
    <style name="Widget.Hima.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@android:color/white</item>
        <!-- Creator QA bug #4 — the fill belongs in the style. B_042 deliberately left
             backgroundTint per-button, and the result was exactly what QA reported: five
             CTAs in three different colours (two gradient variants at two angles, plus a
             flat accent). A screen can still override for a genuine one-off, but the
             default is now brand pink with the #D1D5DB disabled state that
             delete_account_button_text_color was contrast-tuned against. -->
        <item name="backgroundTint">@color/btn_primary_bg_tint</item>
    </style>

    <style name="Widget.Hima.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
    </style>

