<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:background="@color/grey_extra_light">

    <!-- Professional Header — soft pink gradient. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_recent_header_gradient"
        android:elevation="2dp"
        android:paddingTop="10dp"
        app:elevation="2dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Decorative dating-themed icon collage on top-right of header.
                 Modern sparkles + chat / video / call / heart / kiss. -->

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:alpha="0.5"
                android:src="@drawable/ic_sparkle"
                app:tint="#E91E63" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="30dp"
                android:alpha="0.35"
                android:src="@drawable/ic_chat_bubble"
                app:tint="#9C27B0" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="56dp"
                android:alpha="0.32"
                android:src="@drawable/video"
                app:tint="#9C27B0" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="14dp"
                android:alpha="0.35"
                android:src="@drawable/audio"
                app:tint="#E91E63" />

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="44dp"
                android:layout_marginEnd="48dp"
                android:alpha="0.4"
                android:src="@drawable/ic_heart_filled"
                app:tint="#E91E63" />

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="32dp"
                android:layout_marginEnd="78dp"
                android:alpha="0.3"
                android:src="@drawable/ic_kiss_lips"
                app:tint="#E91E63" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="68dp"
                android:layout_marginEnd="34dp"
                android:alpha="0.45"
                android:src="@drawable/ic_sparkle"
                app:tint="#9C27B0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp">

            <!-- Title + subtitle (matches Favourite styling). -->
            <TextView
                android:id="@+id/tv_recent_calls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:letterSpacing="-0.02"
                android:text="@string/recent_calls"
                android:textColor="#000000"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/poppins_regular"
                android:includeFontPadding="false"
                android:text="Your call history"
                android:textColor="#4A5568"
                android:textSize="13sp" />

            <!-- Filter pills — MaterialButtons styled exactly like Home tab pills. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingEnd="8dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/chip_group_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_all"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:paddingHorizontal="16dp"
                        android:text="All"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:elevation="2dp"
                        app:icon="@drawable/ic_filter_all"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="match_parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_missed"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:paddingHorizontal="16dp"
                        android:text="Missed"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:elevation="2dp"
                        app:icon="@drawable/ic_missed_call"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="match_parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_talk_time"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:paddingHorizontal="16dp"
                        android:text="Talk Time"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:elevation="2dp"
                        app:icon="@drawable/ic_clock"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="match_parent" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/chip_a_z"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:fontFamily="@font/plus_jakarta_sans_semibold"
                        android:paddingHorizontal="16dp"
                        android:text="A → Z"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        app:cornerRadius="14dp"
                        app:elevation="2dp"
                        app:icon="@drawable/ic_sort"
                        app:iconGravity="textStart"
                        app:iconPadding="6dp"
                        app:iconSize="16dp" />

                </LinearLayout>
            </HorizontalScrollView>

            <!-- Search Bar — white with pink stroke, 6dp corner, search icon on right. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_search"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="10dp"
                app:cardElevation="0dp"
                app:rippleColor="#1AE91E63"
                app:strokeColor="#E91E63"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <EditText
                        android:id="@+id/et_search"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/plus_jakarta_sans_medium"
                        android:hint="Search"
                        android:imeOptions="actionSearch"
                        android:includeFontPadding="false"
                        android:paddingEnd="12dp"
                        android:singleLine="true"
                        android:textColor="@color/black_light"
                        android:textColorHint="#8E8E93"
                        android:textSize="15sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Search"
                        android:src="@drawable/ic_search_modern"
                        app:tint="#1F2937" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
        </FrameLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_calls"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:layoutAnimation="@anim/layout_animation_fall_down"
            android:paddingHorizontal="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="72dp"
            android:visibility="gone" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/pink"
        android:indeterminateTintMode="src_in"
        android:visibility="gone" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/tl_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_bg_grey"
            android:gravity="center"
            android:text="📞"
            android:textSize="32sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/no_data_found"
            android:textColor="@color/black_light"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Your call history will appear here"
            android:textColor="@color/grey_medium"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Offline: show instead of "No data" when there is no connectivity -->
    <LinearLayout
        android:id="@+id/layout_no_internet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:background="@drawable/circle_bg_grey"
            android:gravity="center"
            android:text="📶"
            android:textSize="28sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/no_internet_connection"
            android:textColor="@color/black_light"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:paddingHorizontal="24dp"
            android:text="@string/check_connection_retry_hint"
            android:textColor="@color/grey_medium"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry_no_network"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/retry"
            android:textAllCaps="false"
            app:cornerRadius="22dp"
            app:strokeColor="@color/colorAccent" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>