<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- Camera preview fills screen -->
    <androidx.camera.view.PreviewView
        android:id="@+id/preview_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="@string/back"
            android:padding="11dp"
            android:src="@drawable/ic_back"
            app:tint="@color/pink"
            android:background="@drawable/bg_back_button"
            android:elevation="2dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/star_creator_record_video_title"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/iv_flip_camera"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@string/star_creator_flip_camera"
            android:padding="4dp"
            android:src="@drawable/ic_flip_camera"
            app:tint="@color/white" />
    </LinearLayout>

    <!-- Recording timer badge -->
    <LinearLayout
        android:id="@+id/ll_timer_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="#CC000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="5dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/star_creator_mic_bg_recording" />

        <TextView
            android:id="@+id/tv_record_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="00:00"
            android:textColor="#EF4444"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Speech text overlay (always visible so user can read while recording) -->
    <LinearLayout
        android:id="@+id/ll_speech_overlay"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:background="#EE1F2937"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_controls"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_mic"
                app:tint="#ff1383" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/star_creator_speech_title"
                android:textColor="#ff1383"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_speech_overlay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:lineSpacingMultiplier="1.4"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Bottom controls -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC000000"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- After recording: success badge -->
        <LinearLayout
            android:id="@+id/ll_recorded_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="#33FFFFFF"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_check_circle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/star_creator_video_recorded_success"
                android:textColor="#10B981"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- Retake — clearly visible white outline button -->
            <TextView
                android:id="@+id/tv_retake"
                android:layout_width="88dp"
                android:layout_height="44dp"
                android:background="@drawable/star_creator_retake_btn"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="@string/star_creator_retake"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Record / Stop button -->
            <FrameLayout
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginHorizontal="24dp">

                <View
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:alpha="0.30"
                    android:background="@drawable/star_creator_mic_bg" />

                <ImageView
                    android:id="@+id/iv_record_btn"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center"
                    android:background="@drawable/star_creator_mic_bg_recording"
                    android:padding="14dp"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/white" />
            </FrameLayout>

            <!-- Upload (was "Use Video") -->
            <TextView
                android:id="@+id/tv_use_video"
                android:layout_width="88dp"
                android:layout_height="44dp"
                android:background="@drawable/star_creator_upload_btn"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="@string/star_creator_upload_btn"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_record_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/star_creator_tap_to_record_video"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
