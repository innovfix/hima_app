<?xml version="1.0" encoding="utf-8"?>
<!-- Professional Login screen — mirrors Home theme:
     white/grey-extra-light background, pink hero, cabinet_grotesk logo,
     clean white phone input, gradient pink CTA. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_extra_light"
    tools:context=".activities.LoginActivity">

    <!-- ===== Pink Hero with brand logo + tagline ===== -->
    <FrameLayout
        android:id="@+id/hero_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/hero_background"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/bg_login_hero_curve" />

        <!-- Decorative sparkles (top-right, low opacity) -->
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="40dp"
            android:layout_marginEnd="28dp"
            android:alpha="0.45"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/white" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="70dp"
            android:layout_marginEnd="62dp"
            android:alpha="0.35"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/white" />

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="60dp"
            android:layout_marginStart="44dp"
            android:alpha="0.3"
            android:src="@drawable/ic_sparkle"
            app:tint="@color/white" />

        <!-- Logo + brand name (centered) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="80dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/logo"
                    app:tint="#FF1383" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/cabinet_grotesk_extrabold"
                android:letterSpacing="-0.01"
                android:text="@string/app_name"
                android:textColor="@color/white"
                android:textSize="28sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:alpha="0.9"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Where Feelings Connect"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- ===== Title + Subtitle ===== -->
    <TextView
        android:id="@+id/tl_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="-0.02"
        android:text="@string/login_to_get_started"
        android:textColor="@color/black_light"
        android:textSize="24sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/hero_container" />

    <TextView
        android:id="@+id/tv_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Enter your mobile number to continue"
        android:textColor="@color/grey_medium"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tl_title" />

    <!-- ===== Phone Number Field ===== -->
    <TextView
        android:id="@+id/tv_field_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="28dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Mobile Number"
        android:textColor="@color/black_light"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_subtitle" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_login"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_field_label">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_login_input_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp">

            <!-- Flag -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_country"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false">

                <ImageView
                    android:id="@+id/iv_flag"
                    android:layout_width="28dp"
                    android:layout_height="20dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/india"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/iv_down_arrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_down_arrow"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_flag"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/grey_medium"
                    tools:ignore="ContentDescription" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Country Code -->
            <TextView
                android:id="@+id/tv_country_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="+91"
                android:textColor="@color/black_light"
                android:textSize="15sp" />

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="28dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:background="#E5E7EB" />

            <!-- Mobile Number EditText -->
            <EditText
                android:id="@+id/et_mobile_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autofillHints="phone"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_medium"
                android:hint="98765 43210"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLength="10"
                android:paddingStart="10dp"
                android:paddingEnd="4dp"
                android:textColor="@color/black_light"
                android:textColorHint="#C5CAD5"
                android:textCursorDrawable="@drawable/color_cursor"
                android:textSize="15sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_otp_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/you_will_receive_an_otp_on_this_number"
        android:textColor="@color/grey_medium"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_login" />

    <!-- ===== Terms and Conditions ===== -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:gravity="top"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/btn_send_otp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <CheckBox
            android:id="@+id/cb_terms_and_conditions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#FF1383"
            android:checked="true"
            android:focusable="false" />

        <TextView
            android:id="@+id/tv_terms_and_conditions"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/terms_and_conditions_text"
            android:textColor="@color/grey_medium"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ===== Send OTP CTA ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_send_otp"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/login_send_btn_bg"
        android:enabled="false"
        android:fontFamily="@font/poppins_semibold"
        android:letterSpacing="0.02"
        android:text="@string/send_otp"
        android:textAllCaps="false"
        android:textColor="@color/login_send_btn_text"
        android:textSize="15sp"
        app:cornerRadius="27dp"
        app:elevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/pb_send_otp_loader"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:elevation="8dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/white"
        android:indeterminateTintMode="src_in"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/btn_send_otp"
        app:layout_constraintEnd_toEndOf="@+id/btn_send_otp"
        app:layout_constraintStart_toStartOf="@+id/btn_send_otp"
        app:layout_constraintTop_toTopOf="@+id/btn_send_otp" />

</androidx.constraintlayout.widget.ConstraintLayout>
