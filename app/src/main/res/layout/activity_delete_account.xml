<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true">

    <!-- App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:fitsSystemWindows="true"
        app:elevation="2dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/toolbar_inner"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@string/account_privacy"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#212121" />

            <TextView
                android:id="@+id/tv_edit_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/delete_account"
                android:textColor="#212121"
                android:textSize="20sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_back"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <!-- B_035: stack the scroll area and the fixed bottom bar in a vertical container
         so the scroll view sits ABOVE the bar (no overlap). Previously the scroll view
         was match_parent and overlapped the bottom bar, so on keyboard-open adjustResize
         scrolled the focused description field behind the bar / under the keyboard. -->
    <LinearLayout
        android:id="@+id/content_column"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/sv_details"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Warning Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_delete_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="#FFF3E0"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:strokeColor="#FFE0B2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Warning Icon -->
                    <ImageView
                        android:id="@+id/iv_delete_account"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="8dp"
                        android:contentDescription="@string/edit"
                        android:src="@drawable/ic_warning_delete_account_amber" />

                    <!-- Warning Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="16dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Important Information"
                        android:textColor="#E65100"
                        android:textSize="16sp" />

                    <!-- Warning Items Container -->
                    <LinearLayout
                        android:id="@+id/cv_warnings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Warning Item 1 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_hint_1"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="10dp"
                                android:background="@android:color/black"
                                android:contentDescription="bullet" />

                            <TextView
                                android:id="@+id/tv_hint_1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/delete_warning_1"
                                android:textColor="#424242"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Warning Item 2 -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="top"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_hint_2"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="10dp"
                                android:background="@android:color/black"
                                android:contentDescription="bullet" />

                            <TextView
                                android:id="@+id/tv_hint_2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/delete_warning_2"
                                android:textColor="#424242"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Warning Item 3 (collapsible) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_hint_3"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="10dp"
                                android:background="@android:color/black"
                                android:contentDescription="bullet" />

                            <TextView
                                android:id="@+id/tv_hint_3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/delete_warning_3"
                                android:textColor="#424242"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Warning Item 4 (collapsible) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_hint_4"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="10dp"
                                android:background="@android:color/black"
                                android:contentDescription="bullet" />

                            <TextView
                                android:id="@+id/tv_hint_4"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/delete_warning_4"
                                android:textColor="#424242"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Warning Item 5 (collapsible) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_hint_5"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="10dp"
                                android:background="@android:color/black"
                                android:contentDescription="bullet" />

                            <TextView
                                android:id="@+id/tv_hint_5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/delete_warning_5"
                                android:textColor="#424242"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Warning Item 6 (collapsible) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="14dp"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_hint_6"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="10dp"
                                android:background="@android:color/black"
                                android:contentDescription="bullet" />

                            <TextView
                                android:id="@+id/tv_hint_6"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/delete_warning_6"
                                android:textColor="#424242"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <!-- Warning Item 7 (collapsible) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="top"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_hint_7"
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:layout_marginTop="6dp"
                                android:layout_marginEnd="10dp"
                                android:background="@android:color/black"
                                android:contentDescription="bullet" />

                            <TextView
                                android:id="@+id/tv_hint_7"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_regular"
                                android:lineSpacingExtra="3dp"
                                android:text="@string/delete_warning_7"
                                android:textColor="#424242"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                    <!-- View More Button -->
                    <LinearLayout
                        android:id="@+id/cl_view_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/tv_view_more"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="@string/view_more"
                            android:textColor="#F57C00"
                            android:textSize="13sp" />

                        <ImageView
                            android:id="@+id/iv_view_more"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_down_arrow"
                            app:tint="#F57C00" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Reasons Section -->
            <TextView
                android:id="@+id/tl_reasons_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/delete_reason_text"
                android:textColor="#212121"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/cv_delete_account" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_reasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tl_reasons_title" />

            <!-- Description Section (for "Other" option) -->
            <TextView
                android:id="@+id/tv_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/give_us_a_description"
                android:textColor="#212121"
                android:textSize="16sp"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_reasons" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:backgroundTint="#FAFAFA"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_description"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <EditText
                        android:id="@+id/et_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="top"
                        android:hint="@string/tell_us_about_your_issue"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="250"
                        android:minHeight="120dp"
                        android:paddingStart="16dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp"
                        android:textCursorDrawable="@drawable/color_cursor"
                        android:textColor="#212121"
                        android:textColorHint="#9E9E9E"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/tv_remaining_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="12dp"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingBottom="4dp"
                        android:text="@string/description_remaining_text"
                        android:textColor="#757575"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Section with Help and Delete Button (fixed below the scroll area) -->
    <LinearLayout
        android:id="@+id/ll_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0" />

        <!-- Help Text -->
        <LinearLayout
            android:id="@+id/cl_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_need_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/contact_support_mail"
                android:textColor="#616161"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_support_mail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="#1976D2"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- BUG 16 — was an AppCompatButton on bg_btn_primary: 52dp, r14, and filled with a
             #EC4899 -> #D946EF pink-to-PURPLE gradient rather than brand colorAccent. QA
             flagged both the shape and the colour against the Block/Cancel buttons.

             Now on Widget.Hima.Button.Primary — the style B_042 already declared canonical
             and whose own comment names "Delete Account" as a target it was never migrated
             to (only Submit Ticket and the feedback dialog had adopted it).

             Fill is btn_primary_bg_tint (a ColorStateList), not a flat tint, so the #D1D5DB
             disabled fill survives — delete_account_button_text_color is tuned against it. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_delete_account"
            style="@style/Widget.Hima.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:enabled="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:text="@string/delete_account"
            android:textColor="@color/delete_account_button_text_color"
            android:stateListAnimator="@null"
            app:backgroundTint="@color/btn_primary_bg_tint"
            app:elevation="0dp" />

    </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>