<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_marginVertical="@dimen/_6sdp"
    android:layout_marginHorizontal="@dimen/_5sdp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10sdp"
        app:cardCornerRadius="16dp"
        android:elevation="2dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        app:cardUseCompatPadding="false">

        <RelativeLayout
            android:id="@+id/main"
            android:layout_width="@dimen/_104sdp"
            android:layout_height="@dimen/_122sdp"
            android:background="@drawable/bg_card_clean"
            android:orientation="vertical">

            <!-- Content Section -->
            <LinearLayout
                android:id="@+id/ll_coin_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_8sdp">

                <!-- Coin Icon -->
                <ImageView
                    android:id="@+id/iv_coins"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/coin_svg"
                    tools:ignore="ContentDescription" />

                <!-- Coin Amount -->
                <TextView
                    android:id="@+id/tv_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:text="xxx"
                    android:textColor="#2D3436"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins_bold" />

                <!-- Coins Label -->
                <TextView
                    android:id="@+id/tv_coinstxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:text="@string/coins"
                    android:textColor="#95A5A6"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Price Section -->
            <LinearLayout
                android:layout_alignParentBottom="true"
                android:id="@+id/ll_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_teal"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="@dimen/_6sdp">

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="xxx"
                    android:textColor="@color/white"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Save Badge -->
            <TextView
                android:layout_centerHorizontal="true"
                android:id="@+id/tv_discount_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_orange"
                android:elevation="2dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="xxx"
                android:layout_marginBottom="@dimen/_20sdp"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_3sdp"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:layout_alignParentBottom="true" />

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Popular Badge -->
    <TextView
        android:layout_centerHorizontal="true"
        android:id="@+id/tv_popular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_blue_light"
        android:elevation="3dp"
        android:gravity="center"
        android:text="★ Popular"
        android:fontFamily="@font/poppins_bold"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_3sdp"
        android:textColor="@color/white"
        android:textSize="9sp" />

</RelativeLayout>
