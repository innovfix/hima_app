<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:layout_marginVertical="@dimen/_4sdp"
    android:layout_marginHorizontal="@dimen/_5sdp"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_coin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:cardCornerRadius="16dp"
        android:elevation="6dp"
        app:cardElevation="6dp"
        app:strokeWidth="0dp"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="@dimen/_93sdp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_clean"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_coin_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingTop="@dimen/_6sdp"
                android:paddingBottom="0dp">

                <ImageView
                    android:id="@+id/iv_coins"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:scaleType="fitXY"
                    android:src="@drawable/coin_svg"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tv_coins"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_4sdp"
                    android:text="xxx"
                    android:textColor="#2D3436"
                    android:textSize="20sp"
                    android:fontFamily="@font/poppins_bold" />

                <TextView
                    android:id="@+id/tv_coinstxt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="@string/coins"
                    android:textColor="#95A5A6"
                    android:fontFamily="@font/poppins_medium"
                    android:textSize="10sp"
                    android:letterSpacing="0.02" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_discount_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_3sdp"
                android:layout_marginBottom="-8dp"
                android:background="@drawable/bg_gradient_orange"
                android:elevation="6dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_8sdp"
                android:paddingVertical="@dimen/_2sdp"
                android:textColor="@color/white"
                android:textSize="9sp"
                android:visibility="gone"
                tools:text="Save 30 %"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/ll_price"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_gradient_teal"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/_8sdp"
                android:paddingBottom="@dimen/_7sdp"
                android:paddingHorizontal="@dimen/_4sdp">

                <TextView
                    android:id="@+id/tv_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:text="xxx"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_centerHorizontal="true"
        android:id="@+id/tv_popular"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_gradient_blue_light"
        android:elevation="3dp"
        android:gravity="center"
        android:text="★ Popular"
        android:fontFamily="@font/poppins_bold"
        android:paddingHorizontal="@dimen/_10sdp"
        android:paddingVertical="@dimen/_3sdp"
        android:textColor="@color/white"
        android:textSize="9sp" />

</RelativeLayout>
