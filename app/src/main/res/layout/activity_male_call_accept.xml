<?xml version="1.0" encoding="utf-8"?>
<!-- 
    PROFESSIONAL INCOMING CALL UI DESIGN FOR MALE USERS
    
    Design Features:
    - Modern dark gradient background (elegant navy blue gradient)
    - Status text at top showing call type
    - Large circular avatar with pulsing rings
    - Caller name prominently displayed
    - Professional call controls at bottom
    - Clean, minimal design inspired by iOS/Material Design
-->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/professional_incoming_call_bg"
    android:fitsSystemWindows="true">

    <!-- Status Bar Spacer -->
    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Call Type Container -->
    <LinearLayout
        android:id="@+id/call_type_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Call Type Icon -->
        <ImageView
            android:id="@+id/call_type_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_mic"
            android:alpha="0.7"
            android:contentDescription="Call Type Icon" />

        <!-- Call Type Text -->
        <TextView
            android:id="@+id/calltype"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Incoming Voice Call"
            android:textColor="#B0FFFFFF"
            android:textSize="16sp"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Avatar Container with Pulse Rings -->
    <FrameLayout
        android:id="@+id/avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/call_type_container">

        <!-- Outermost Pulse Ring -->
        <View
            android:id="@+id/pulse_ring_outer"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:layout_gravity="center"
            android:background="@drawable/pulse_animation_ring" />

        <!-- Middle Pulse Ring -->
        <View
            android:id="@+id/pulse_ring_middle"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center"
            android:background="@drawable/pulse_animation_ring" />

        <!-- Avatar Ring (Static White Border) -->
        <View
            android:id="@+id/avatar_ring"
            android:layout_width="168dp"
            android:layout_height="168dp"
            android:layout_gravity="center"
            android:background="@drawable/professional_avatar_ring" />

        <!-- Caller Profile Image -->
        <androidx.cardview.widget.CardView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            app:cardCornerRadius="80dp"
            app:cardElevation="8dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/profile"
                tools:src="@drawable/avatar1" />
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <!-- Caller Name -->
    <TextView
        android:id="@+id/callerName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginHorizontal="32dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Jane Doe"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/avatar_container" />

    <!-- Call Status Text -->
    <TextView
        android:id="@+id/call_status_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Ringing..."
        android:textColor="#80FFFFFF"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/callerName" />

    <!-- Hidden Progress Bar (for matching animation) -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Hidden Text Views (for compatibility) -->
    <TextView
        android:id="@+id/tv_you"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/tl_wait_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/iv_double_arrow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Call Action Buttons Container -->
    <LinearLayout
        android:id="@+id/call_actions_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Decline Button Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Decline Button -->
            <FrameLayout
                android:id="@+id/reject"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/incoming_call_decline_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:rotation="135"
                    android:src="@drawable/ic_call_decline"
                    android:contentDescription="Decline Call" />
            </FrameLayout>

            <!-- Decline Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Decline"
                android:textColor="#F44336"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Accept Button Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Accept Button -->
            <FrameLayout
                android:id="@+id/accpet"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/incoming_call_accept_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_call_accept"
                    android:contentDescription="Accept Call" />
            </FrameLayout>

            <!-- Accept Label -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_medium"
                android:text="Accept"
                android:textColor="#4CAF50"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Instruction Text (Optional) -->
    <TextView
        android:id="@+id/instruction_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Swipe to answer"
        android:textColor="#60FFFFFF"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>


