<?xml version="1.0" encoding="utf-8"?>
<!-- 
    PROFESSIONAL VIDEO CALLING UI DESIGN
    
    Design Features:
    - Clean dark gradient background (elegant navy blue gradient)
    - Centered timer with icon at the top
    - Professional user avatar cards with shadows
    - Control buttons at bottom in horizontal layout
    - Improved spacing and alignment throughout
    - Minimalist design with focus on call functionality
-->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@drawable/professional_call_background">

    <!-- Ambient color blobs -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginStart="-80dp"
        android:layout_marginTop="-80dp"
        android:background="@drawable/bg_radar_blob_pink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginEnd="-60dp"
        android:layout_marginBottom="-100dp"
        android:background="@drawable/bg_radar_blob_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Video Containers -->
    <androidx.cardview.widget.CardView
        android:id="@+id/localCardView"
        android:layout_width="@dimen/_120sdp"
        android:layout_height="190dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginRight="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_6sdp"
        app:cardElevation="5dp">

        <FrameLayout
            android:id="@+id/local_video_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black">

            <!-- Front/back camera flip — overlaid on the local preview so it
                 only appears when the user is actively sending video. -->
            <ImageButton
                android:id="@+id/btn_camera_flip"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="6dp"
                android:background="#80000000"
                android:contentDescription="Flip camera"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_camera_flip" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>
    
    <FrameLayout
        android:id="@+id/remote_video_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_centerHorizontal="true"
        android:background="@android:color/darker_gray" />

    <!-- Top Bar Container -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Connection Quality Indicator -->
        <ImageView
            android:id="@+id/iv_signal_strength"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_signal_strong"
            android:contentDescription="Signal Strength"
            android:layout_marginEnd="8dp"/>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Timer Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/timer_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/professional_timer_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Timer Icon -->
            <ImageView
                android:id="@+id/iv_timer_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_timer_professional"
                android:layout_marginEnd="6dp"
                android:contentDescription="Timer"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Timer Text -->
            <TextView
                android:id="@+id/tvRemainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                app:layout_constraintStart_toEndOf="@id/iv_timer_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Plus Icon (for adding time) -->
            <ImageView
                android:id="@+id/iv_plus"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/baseline_add_24"
                android:visibility="gone"
                android:contentDescription="Add Time"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toEndOf="@id/tvRemainingTime"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Menu Button (Hidden) -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="invisible"
            android:contentDescription="Menu"/>

    </LinearLayout>

    <!-- "Reconnecting…" card — toggled by CallQualityUi from Agora onConnectionStateChanged. -->
    <LinearLayout
        android:id="@+id/reconnect_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_reconnect_pill"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <ProgressBar
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:indeterminate="true"
            android:indeterminateTint="#FF1383" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Reconnecting…"
                android:textColor="#0F172A"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="Check your network"
                android:textColor="#64748B"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- User Avatars Container (Center) -->
    <LinearLayout
        android:id="@+id/users_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- Female User Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="24dp">

            <!-- Female Avatar with Team Color Border -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/female_team_ring"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:background="@drawable/bg_team_circle" />

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="12dp">

                    <ImageView
                        android:id="@+id/iv_female_user"
                        android:layout_width="106dp"
                        android:layout_height="106dp"
                        android:scaleType="centerCrop"
                        android:padding="3dp"
                        android:background="#FFFFFF"
                        android:contentDescription="Female User"/>

                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Female Name -->
            <TextView
                android:id="@+id/tv_female_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="120dp"/>

            <!-- Female IPL Team Badge -->
            <LinearLayout
                android:id="@+id/female_ipl_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_ipl_call_team_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/female_ipl_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_team_circle" />

                <TextView
                    android:id="@+id/tv_female_ipl_team"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Female Mute Indicator -->
            <ImageView
                android:id="@+id/femaleMute"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/mute_img"
                android:visibility="gone"
                android:contentDescription="Muted"/>

        </LinearLayout>

        <!-- Male User Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="24dp">

            <!-- Male Avatar with Team Color Border -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/male_team_ring"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:background="@drawable/bg_team_circle" />

                <com.gmwapp.hima.widgets.ConicRingView
                    android:layout_width="126dp"
                    android:layout_height="126dp"
                    android:layout_gravity="center" />

                <androidx.cardview.widget.CardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:cardCornerRadius="55dp"
                    app:cardElevation="12dp">

                    <ImageView
                        android:id="@+id/iv_male_user"
                        android:layout_width="106dp"
                        android:layout_height="106dp"
                        android:scaleType="centerCrop"
                        android:padding="3dp"
                        android:background="#FFFFFF"
                        android:contentDescription="Male User"/>

                </androidx.cardview.widget.CardView>
            </FrameLayout>

            <!-- Male Name -->
            <TextView
                android:id="@+id/tv_male_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="120dp"/>

            <!-- Male IPL Team Badge -->
            <LinearLayout
                android:id="@+id/male_ipl_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_ipl_call_team_badge"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/male_ipl_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_team_circle" />

                <TextView
                    android:id="@+id/tv_male_ipl_team"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/white"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Male Mute Indicator -->
            <ImageView
                android:id="@+id/maleMute"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginTop="4dp"
                android:src="@drawable/mute_img"
                android:visibility="gone"
                android:contentDescription="Muted"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Control Buttons Container (Bottom) -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="40dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Microphone Toggle Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/btn_MuteUnmute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/ic_call_mic"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Microphone"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- Speaker Toggle Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/btn_speaker"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/ic_call_speaker_on"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Speaker"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- End Call Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:id="@+id/btn_endCall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_end_call_bg"
                    android:src="@drawable/ic_call_end"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="End Call"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>

        <!-- Video Toggle Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_buttons"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/video_button_frame"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/btn_video_call"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/ic_call_audio"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Video"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                app:layout_constraintTop_toBottomOf="@id/video_button_frame"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/icebreakerHintButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="24dp"
        app:cardElevation="10dp"
        app:layout_constraintBottom_toBottomOf="@id/ludo_button_card"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ludo_button_card">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/icebreaker_circle_button_bg">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="Icebreaker Questions"
                android:src="@drawable/ic_help"
                app:tint="#FFFFFFFF" />
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/ludo_button_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/users_container"
        app:layout_constraintVertical_bias="0.75">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ludo_button_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/ludo_badge_bg"
                android:gravity="center"
                android:text="L"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Play Ludo"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/iv_gift_image"
        android:layout_width="@dimen/_95sdp"
        android:layout_height="95dp"
        android:elevation="32dp"
        android:src="@drawable/gift_png"
        android:translationZ="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Gift Animation"/>

    <!-- Debug Buttons (Hidden in production) -->
    <Button
        android:id="@+id/JoinButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Join"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/LeaveButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leave"
        tools:ignore="MissingConstraints" />

    <!-- Black Screen Overlay (for transitions) -->
    <ImageView
        android:id="@+id/blackscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/black"
        android:visibility="gone"
        android:contentDescription="Loading"/>

    <include
        android:id="@+id/remoteBlurOverlay"
        layout="@layout/overlay_remote_blur_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Face Detection Overlay -->
    <include
        android:id="@+id/faceDetectionOverlay"
        layout="@layout/overlay_face_detection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>