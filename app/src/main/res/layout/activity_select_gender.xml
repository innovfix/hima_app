<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_onboarding_light"
    tools:context=".activities.SelectGenderActivity">

    <!-- ===== Top bar: back button + 4-step progress ===== -->
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_back_btn_square"
        android:contentDescription="@string/account_privacy"
        android:padding="11dp"
        android:rotation="180"
        android:src="@drawable/right_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/onboarding_title" />

    <LinearLayout
        android:id="@+id/ll_steps"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="@id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_back"
        app:layout_constraintTop_toTopOf="@id/iv_back">

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_step_active" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_step_inactive" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_step_inactive" />

        <View
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_step_inactive" />
    </LinearLayout>

    <!-- ===== Title + subtitle ===== -->
    <TextView
        android:id="@+id/tv_personalise"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Who are you?"
        android:textColor="@color/onboarding_title"
        android:textSize="30sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_back" />

    <TextView
        android:id="@+id/tv_pick_your_gender"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Choose your gender to personalize your experience"
        android:textColor="@color/grey_medium"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_personalise" />

    <!-- ===== Gender cards ===== -->
    <LinearLayout
        android:id="@+id/ll_gender_cards"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="20dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pick_your_gender">

        <!-- Male Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_male"
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/onboarding_card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/icon_male"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/circle_bg_grey"
                    android:gravity="center"
                    android:text="♂"
                    android:textColor="@color/black_light"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/btn_male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/male"
                    android:textColor="@color/onboarding_title"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_male_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Connect with creators"
                    android:textColor="@color/grey_medium"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Female Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_female"
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/onboarding_card_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/icon_female"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/circle_bg_grey"
                    android:gravity="center"
                    android:text="♀"
                    android:textColor="@color/black_light"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/btn_female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/female"
                    android:textColor="@color/onboarding_title"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/tv_female_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Become a creator"
                    android:textColor="@color/grey_medium"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- ===== Avatar section header ===== -->
    <TextView
        android:id="@+id/tv_avatar_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="26dp"
        android:fontFamily="@font/poppins_semibold"
        android:text="Pick your avatar"
        android:textColor="@color/onboarding_title"
        android:textSize="17sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_gender_cards" />

    <TextView
        android:id="@+id/tv_swipe_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Swipe to explore →"
        android:textColor="@color/grey_medium"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/tv_avatar_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_avatar_label" />

    <!-- ===== Avatar carousel ===== -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_avatars"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/ll_gender_hint"
        app:layout_constraintTop_toBottomOf="@id/tv_avatar_label"
        tools:listitem="@layout/adapter_avatar" />

    <!-- ===== Footer: info hint + continue ===== -->
    <LinearLayout
        android:id="@+id/ll_gender_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/fl_continue"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/circle_bg_accent"
            android:gravity="center"
            android:text="i"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold|italic"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/tv_gender_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/gender_change_warning"
            android:textColor="@color/colorAccent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Continue Button -->
    <FrameLayout
        android:id="@+id/fl_continue"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/colorAccent"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/continue_text"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:cornerRadius="28dp"
            app:elevation="0dp" />

        <ProgressBar
            android:id="@+id/pb_continue_loader"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone" android:indeterminateDrawable="@drawable/heart_loader_white" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
