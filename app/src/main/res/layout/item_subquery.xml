<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="false"
    app:rippleColor="#E0E0E0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Icon Circle Background -->
        <View
            android:id="@+id/icon_bg_subquery"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/circle_background"
            android:backgroundTint="@color/pink_extra_light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_subquery_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="Subquery icon"
            android:src="@drawable/ic_help"
            app:layout_constraintBottom_toBottomOf="@+id/icon_bg_subquery"
            app:layout_constraintEnd_toEndOf="@+id/icon_bg_subquery"
            app:layout_constraintStart_toStartOf="@+id/icon_bg_subquery"
            app:layout_constraintTop_toTopOf="@+id/icon_bg_subquery"
            app:tint="@color/pink" />

        <TextView
            android:id="@+id/tv_subquery_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:text="How to resolve payment issues?"
            android:textColor="#212121"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="2"
            android:ellipsize="end"
            app:layout_constraintEnd_toStartOf="@+id/iv_subquery_arrow"
            app:layout_constraintStart_toEndOf="@+id/icon_bg_subquery"
            app:layout_constraintTop_toTopOf="@+id/icon_bg_subquery"
            app:layout_constraintBottom_toBottomOf="@+id/icon_bg_subquery" />

        <ImageView
            android:id="@+id/iv_subquery_arrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Arrow"
            android:src="@drawable/right_arrow"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/icon_bg_subquery"
            app:layout_constraintBottom_toBottomOf="@+id/icon_bg_subquery"
            app:tint="#9E9E9E" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>



