<?xml version="1.0" encoding="utf-8"?>
<!-- Friends-Gated Chat: male "Friends" hub (was Favourite). Variant A — 4 underline tabs. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:id="@+id/friends_hub_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/ll_friends_titles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.02"
                android:text="@string/friends"
                android:textColor="@color/black_light"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Your friends and requests"
                android:textColor="@color/grey_medium"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Decorative hearts + sparkles cluster (top-right) -->
        <FrameLayout
            android:layout_width="124dp"
            android:layout_height="80dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.95"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FF5E9F" />

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="22dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FF6FAB" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="34dp"
                android:alpha="0.85"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FF85B8" />

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="46dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_outline"
                app:tint="#FF85B8" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="46dp"
                android:layout_marginEnd="28dp"
                android:alpha="0.8"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FF85B8" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="64dp"
                android:alpha="0.75"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FFA0C6" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="78dp"
                android:alpha="0.8"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                app:tint="#FFB3D4" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="42dp"
                android:layout_marginEnd="92dp"
                android:alpha="0.65"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                app:tint="#FFB3D4" />
        </FrameLayout>
    </RelativeLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_friends_hub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/friends_hub_header"
        app:tabContentStart="12dp"
        app:tabGravity="fill"
        app:tabIndicatorColor="@color/colorAccent"
        app:tabMode="scrollable"
        app:tabPaddingEnd="14dp"
        app:tabPaddingStart="14dp"
        app:tabSelectedTextColor="@color/colorAccent"
        app:tabTextColor="@color/grey_medium" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_friends_hub"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabs_friends_hub" />

</androidx.constraintlayout.widget.ConstraintLayout>
