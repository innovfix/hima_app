<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_height="match_parent"
    tools:context=".activities.PaymentActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_12sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginRight="@dimen/_12sdp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/edit"
            android:rotation="180"
            android:src="@drawable/right_arrow"
            android:padding="4dp"
            app:tint="@color/black"/>

        <TextView
            android:id="@+id/tv_payment"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Payment"
            android:textColor="@color/black"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_bold"/>

        <TextView
            android:id="@+id/tv_change"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Change"
            android:textColor="@color/pink"
            android:textSize="14sp"/>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:backgroundTint="#F8F9FA"
        app:cardCornerRadius="@dimen/_8sdp"
        app:cardElevation="2dp"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginRight="@dimen/_16sdp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/_12sdp"
            android:paddingTop="@dimen/_12sdp"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp"
                android:layout_marginRight="@dimen/_12sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingTop="@dimen/_12sdp"
                    android:paddingBottom="@dimen/_12sdp"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="@dimen/_4sdp">
                        <TextView
                            android:id="@+id/tv_CoinsText"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="16sp"
                            android:textColor="#2D3436"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""/>

                        <TextView
                            android:id="@+id/tv_totalAmount"
                            android:textColor="#2D3436"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_bold"
                            android:layout_width="match_parent"
                            android:layout_gravity="end"
                            android:gravity="end"
                            android:layout_height="wrap_content"
                            android:text=""/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_savePercent"
                        android:textColor="#00C853"
                        android:fontFamily="@font/poppins_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="13sp"
                        android:text=""/>

                </LinearLayout>


            </androidx.cardview.widget.CardView>

            <!-- Discount Section (Optional - shows when coupon applied) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_discount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp"
                android:visibility="gone"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_12sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingVertical="@dimen/_12sdp"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:textColor="#2D3436"
                        android:layout_height="wrap_content"
                        android:text="Discount"
                        android:fontFamily="@font/poppins_semibold"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/tv_discount"
                        android:layout_width="match_parent"
                        android:layout_gravity="end"
                        android:gravity="end"
                        android:textColor="#00C853"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:textSize="15sp"
                        android:text="-₹60"/>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp"
                android:backgroundTint="#6D31ED"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="@dimen/_12sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingTop="@dimen/_14sdp"
                    android:paddingBottom="@dimen/_14sdp"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:textColor="@color/white"
                            android:layout_height="wrap_content"
                            android:text="Final Amount"
                            android:fontFamily="@font/poppins_semibold"
                            android:textSize="16sp"/>

                        <TextView
                            android:id="@+id/tv_finalAmount"
                            android:layout_width="match_parent"
                            android:layout_gravity="end"
                            android:gravity="end"
                            android:textColor="@color/white"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="22sp"
                            android:text=""/>

                    </LinearLayout>


                </LinearLayout>


            </androidx.cardview.widget.CardView>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apply Coupon"
                android:layout_marginHorizontal="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_14sdp"
                android:textColor="@color/black"
                android:fontFamily="@font/poppins_bold"
                android:textSize="15sp"/>


            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_12sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="1dp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginRight="@dimen/_12sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:paddingHorizontal="@dimen/_16sdp"
                    android:paddingTop="@dimen/_4sdp"
                    android:background="@android:color/white"
                    android:paddingBottom="@dimen/_4sdp"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/_6sdp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:padding="@dimen/_2sdp"
                            android:src="@drawable/baseline_percent_24"
                            android:background="@drawable/d_pink_rounded_circle"/>

                        <EditText
                            android:id="@+id/et_couponCode"
                            style="@style/EditTextStyle"
                            android:hint="Enter Coupon"
                            android:textCursorDrawable="@drawable/color_cursor"
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:enabled="false"
                            android:background="@android:color/transparent"
                            android:layout_weight="1"
                            android:paddingStart="@dimen/_8sdp"
                            android:fontFamily="@font/poppins_medium"
                            android:inputType="textNoSuggestions" />

                        <TextView
                            android:id="@+id/tv_applied"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Applied!"
                            android:visibility="invisible"
                            android:textColor="#6D31ED"
                            android:fontFamily="@font/poppins_bold"
                            android:textSize="13sp"
                            android:layout_marginEnd="6dp"/>
                        
                        <ImageView
                            android:id="@+id/iv_correct"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:visibility="invisible"
                            android:src="@drawable/baseline_check_24"
                            android:background="@drawable/d_green_rounded_circle"/>


                    </LinearLayout>


                </LinearLayout>


            </androidx.cardview.widget.CardView>


           <LinearLayout
               android:id="@+id/ll_allCoupons"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_gravity="center"
               android:gravity="center"
               android:layout_marginTop="@dimen/_12sdp"
               android:paddingVertical="@dimen/_6sdp"
               android:orientation="horizontal">

               <TextView
                   android:id="@+id/tv_allCoupons"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:textSize="14sp"
                   android:textColor="@color/pink"
                   android:fontFamily="@font/poppins_bold"
                   android:text="View all coupons"/>

               <ImageView
                   android:id="@+id/iv_allCoupons"
                   android:layout_width="20dp"
                   android:layout_height="20dp"
                   android:layout_marginLeft="@dimen/_4sdp"
                   android:padding="@dimen/_3sdp"
                   android:src="@drawable/baseline_arrow_forward_24"
                   android:background="@drawable/d_pink_rounded_circle"/>

           </LinearLayout>


        </LinearLayout>




    </androidx.cardview.widget.CardView>

    <!-- UPI Selection Section (Only for Cashfree) -->
    <LinearLayout
        android:id="@+id/ll_upi_selection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_16sdp"
        android:layout_marginRight="@dimen/_16sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- PAY USING Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAY USING"
            android:textSize="11sp"
            android:textColor="#6B7280"
            android:fontFamily="@font/poppins_semibold"
            android:letterSpacing="0.08"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp" />

        <!-- Main Payment Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <!-- UPI App Selection Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_upi_selection"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:id="@+id/ll_selected_upi"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:id="@+id/iv_selected_upi_icon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:scaleType="fitCenter"
                        android:layout_marginEnd="10dp"
                        android:adjustViewBounds="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/tv_selected_upi_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select UPI App"
                            android:textSize="15sp"
                            android:textColor="#111827"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:minWidth="0dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tap to change"
                            android:textSize="9sp"
                            android:textColor="#9CA3AF"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="1dp"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:minWidth="0dp" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_dropdown_arrow"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/baseline_arrow_forward_24"
                        android:tint="#9CA3AF"
                        android:rotation="90"
                        android:layout_marginStart="2dp" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Pay Now Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pay_upi"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:minWidth="140dp"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="20dp"
                app:cornerRadius="16dp"
                android:text="Pay Now"
                android:textColor="@color/white"
                android:backgroundTint="@color/pink"
                app:elevation="4dp"
                app:strokeWidth="0dp"
                android:letterSpacing="0.01" />

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/_20sdp"
        android:layout_marginRight="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_24sdp"
        android:layout_marginBottom="@dimen/_20sdp"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_bold"
        android:paddingVertical="@dimen/_14sdp"
        app:cornerRadius="@dimen/_12sdp"
        android:text="Proceed to Pay"
        android:textColor="@color/white"
        android:backgroundTint="@color/pink"
        android:elevation="4dp"/>






</LinearLayout>