<?xml version="1.0" encoding="utf-8"?>
<!-- Modern pink-themed Talk Time range picker dialog. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_pink"
    android:paddingHorizontal="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="20dp">

    <!-- Header: clock icon + title -->
    <FrameLayout
        android:id="@+id/header_icon_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_dialog_icon_circle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_clock"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Talk Time Range"
        android:textColor="@color/black_light"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@id/tv_dialog_subtitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/header_icon_bg"
        app:layout_constraintTop_toTopOf="@id/header_icon_bg"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/tv_dialog_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:fontFamily="@font/poppins_regular"
        android:text="Pick a time range"
        android:textColor="@color/grey_medium"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@id/header_icon_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/header_icon_bg"
        app:layout_constraintTop_toBottomOf="@id/tv_dialog_title" />

    <!-- Options group -->
    <LinearLayout
        android:id="@+id/options_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/header_icon_bg">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/option_7"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#F8F9FB"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:rippleColor="#1AFF2E9A"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Last 7 days"
                    android:textColor="@color/black_light"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/check_7"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_dialog_radio_off"
                    android:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/option_15"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#F8F9FB"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:rippleColor="#1AFF2E9A"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Last 15 days"
                    android:textColor="@color/black_light"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/check_15"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_dialog_radio_off" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/option_30"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#F8F9FB"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:rippleColor="#1AFF2E9A"
            app:strokeColor="#E5E7EB"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Last 30 days"
                    android:textColor="@color/black_light"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/check_30"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_dialog_radio_off" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/options_container">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:fontFamily="@font/poppins_semibold"
            android:paddingHorizontal="20dp"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/grey_medium"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
