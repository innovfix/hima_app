<?xml version="1.0" encoding="utf-8"?>
<!-- Earnings — themed to match female-home: grey bg, white sticky header,
     white rounded cards with colored badge headers, poppins fonts.
     All IDs preserved for EarningsActivity view-binding. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_extra_light"
    android:fitsSystemWindows="true">

    <!-- ══ FIXED sticky header ══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/grey_extra_light"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/edit"
                android:rotation="180"
                android:src="@drawable/right_arrow"
                app:tint="@color/black_light" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/cv_back"
            app:layout_constraintStart_toEndOf="@+id/cv_back"
            app:layout_constraintTop_toTopOf="@+id/cv_back">

            <TextView
                android:id="@+id/tv_earnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="-0.01"
                android:text="@string/earnings"
                android:textColor="@color/black_light"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Track your balance &amp; payouts"
                android:textColor="@color/grey_medium"
                android:textSize="11sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══ Loading progress (centered) ══ -->
    <ProgressBar
        android:id="@+id/pb_earnings"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/colorAccent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_header" />

    <!-- ══ Scroll content ══ -->
    <ScrollView
        android:id="@+id/sv_earnings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_header">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_left_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.04" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/gl_right_margin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.96" />

            <!-- ── Balance card (white theme card) ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cl_earnings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#E9EDF2"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="@id/gl_right_margin"
                app:layout_constraintStart_toStartOf="@id/gl_left_margin"
                app:layout_constraintTop_toTopOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingTop="16dp"
                    android:paddingBottom="18dp">

                    <!-- header row: pink wallet badge + label -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/circle_bg_accent">

                            <ImageView
                                android:id="@+id/iv_wallet_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="@string/earnings"
                                android:src="@drawable/wallet"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_current_balance_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/current_balance"
                                android:textColor="@color/black"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="Available to withdraw"
                                android:textColor="@color/grey_medium"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:background="@color/grey_extra_light" />

                    <!-- big balance (with small loader until it arrives) -->
                    <FrameLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:minHeight="44dp">

                        <TextView
                            android:id="@+id/tv_current_balance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="start|center_vertical"
                            android:fontFamily="@font/poppins_bold"
                            android:letterSpacing="0.01"
                            android:text="₹0"
                            android:textColor="@color/colorAccent"
                            android:textSize="34sp"
                            android:visibility="invisible" />

                        <ProgressBar
                            android:id="@+id/pb_balance"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="start|center_vertical"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/colorAccent" />
                    </FrameLayout>

                    <!-- withdraw button (pink filled) + inline loader -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="14dp">

                        <com.gmwapp.hima.widgets.DButton
                            android:id="@+id/btn_withdraw"
                            android:layout_width="match_parent"
                            android:layout_height="50dp"
                            android:background="@drawable/d_button_bg"
                            android:backgroundTint="@color/colorAccent"
                            android:fontFamily="@font/poppins_semibold"
                            android:letterSpacing="0.02"
                            android:text="@string/withdraw"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="15sp" />

                        <ProgressBar
                            android:id="@+id/pb_withdraw"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/white"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- info hint (pastel pink) -->
                    <LinearLayout
                        android:id="@+id/ll_balance_hint_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/d_button_bg"
                        android:backgroundTint="#FCE4F0"
                        android:gravity="start"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:id="@+id/iv_balance"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/info"
                            app:tint="@color/colorAccent" />

                        <TextView
                            android:id="@+id/tl_balance_hint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/balance_hint_text"
                            android:textColor="#9D215C"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── PAN / KYC card (white) ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_panDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#E9EDF2"
                app:strokeWidth="1dp"
                app:layout_constraintEnd_toEndOf="@+id/gl_right_margin"
                app:layout_constraintStart_toStartOf="@+id/gl_left_margin"
                app:layout_constraintTop_toBottomOf="@+id/cl_earnings">

                <LinearLayout
                    android:id="@+id/ll_"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">

                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/d_button_bg"
                        android:backgroundTint="#FFF3E0">

                        <ImageView
                            android:id="@+id/iv_pan"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/edit"
                            android:src="@drawable/pan"
                            app:tint="#F59E0B" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="@string/complete_Kyc"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/iv_add_pan"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_add_upi"
                        android:contentDescription="@string/edit"
                        app:tint="@color/colorAccent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── History header label ── -->
            <LinearLayout
                android:id="@+id/ll_history_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="@+id/gl_right_margin"
                app:layout_constraintStart_toStartOf="@+id/gl_left_margin"
                app:layout_constraintTop_toBottomOf="@+id/cv_panDetails">

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/d_button_bg"
                    android:backgroundTint="#E8F5E9">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription=""
                        android:src="@drawable/coin_d"
                        app:tint="@color/green" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="Earnings History"
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text="Your recent payouts &amp; sessions"
                        android:textColor="@color/grey_medium"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── History list (rows are white cards) ── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_earnings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/ll_history_header" />

            <!-- ── Empty state ── -->
            <LinearLayout
                android:id="@+id/ll_empty_earnings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="@+id/gl_right_margin"
                app:layout_constraintStart_toStartOf="@+id/gl_left_margin"
                app:layout_constraintTop_toBottomOf="@+id/ll_history_header">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/circle_bg_grey"
                    android:gravity="center"
                    android:text="💸"
                    android:textSize="28sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="No earnings yet"
                    android:textColor="@color/black_light"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="Your payouts will appear here once you start earning"
                    android:textColor="@color/grey_medium"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- ── Help footer ── -->
            <LinearLayout
                android:id="@+id/cl_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_earnings">

                <TextView
                    android:id="@+id/tv_need_help"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/for_any_queries"
                    android:textColor="@color/grey_medium"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_support_mail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/colorAccent"
                    android:textSize="12sp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
