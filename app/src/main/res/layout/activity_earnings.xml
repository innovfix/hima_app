<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FB"
    tools:context=".activities.LoginActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_left_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.04" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_right_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.96" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_top_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.027" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_bottom_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.92" />

    <!-- BUG 21 — header band ported from activity_transactions.xml so the creator and the
         user "Transactions" screens finally share one header: white band, 16dp padding all
         round, back card + title block vertically centred inside it. The band's paddingTop
         replaces cv_back's old marginTop, so the top offset stays exactly where 90f2aa2b
         put it. elevation gives the bottom edge the content sits under. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        android:elevation="3dp"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button Card with Subtle Shadow -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/edit"
                android:src="@drawable/ic_back"
                app:tint="#374151" />

        </androidx.cardview.widget.CardView>

        <!-- Title and Subtitle Container -->
        <LinearLayout
            android:id="@+id/ll_title_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/cv_back"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_earnings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/transactions"
                android:textColor="#111827"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="-0.01" />

            <TextView
                android:id="@+id/tv_earnings_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track your balance &amp; payouts"
                android:textColor="@color/grey_medium"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_regular"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cl_earnings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintEnd_toEndOf="@id/gl_right_margin"
        app:layout_constraintStart_toStartOf="@id/gl_left_margin"
        app:layout_constraintTop_toBottomOf="@+id/header_layout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:padding="20dp">

            <ImageView
                android:id="@+id/iv_wallet_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/circle_bg_accent"
                android:padding="11dp"
                android:src="@drawable/wallet"
                android:contentDescription="@string/earnings"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_current_balance_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="@string/current_balance"
                android:textColor="#111827"
                android:fontFamily="@font/poppins_semibold"
                android:textSize="17sp"
                app:layout_constraintStart_toEndOf="@+id/iv_wallet_icon"
                app:layout_constraintTop_toTopOf="@+id/iv_wallet_icon" />

            <TextView
                android:id="@+id/tv_balance_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="Available to withdraw"
                android:textColor="@color/grey_medium"
                android:fontFamily="@font/poppins_regular"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@+id/iv_wallet_icon"
                app:layout_constraintTop_toBottomOf="@+id/tv_current_balance_title"
                tools:ignore="HardcodedText" />

            <View
                android:id="@+id/v_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#ECECEF"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/iv_wallet_icon" />

            <TextView
                android:id="@+id/tv_current_balance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text=""
                android:textColor="@color/colorAccent"
                android:textSize="34sp"
                android:letterSpacing="0.01"
                android:fontFamily="@font/poppins_bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/v_divider"
                tools:text="₹1284.0" />

            <com.gmwapp.hima.widgets.DButton
                android:id="@+id/btn_withdraw"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:letterSpacing="0.02"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_current_balance"
                android:background="@drawable/bg_btn_pink_pill"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/withdraw"
                android:textColor="@color/white" />

            <LinearLayout
                android:id="@+id/ll_balance_hint_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btn_withdraw">

                <ImageView
                    android:id="@+id/iv_balance"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center_vertical"
                    android:src="@drawable/info"
                    app:tint="@color/grey_medium"
                    tools:ignore="MissingConstraints" />

                <TextView
                    android:id="@+id/tl_balance_hint"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/balance_hint_text"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/grey_medium"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- Earnings History section header -->
    <LinearLayout
        android:id="@+id/ll_earnings_history_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="@id/gl_right_margin"
        app:layout_constraintStart_toStartOf="@id/gl_left_margin"
        app:layout_constraintTop_toBottomOf="@+id/cl_earnings">

        <View
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/circle_bg_green_light" />

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginStart="-22dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/circle_bg_green" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="Transactions History"
                android:textColor="#111827"
                android:textSize="17sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Your recent payouts &amp; sessions"
                android:textColor="@color/grey_medium"
                android:textSize="13sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_earnings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_10sdp"
        app:layout_constraintBottom_toTopOf="@+id/cl_help"
        app:layout_constraintEnd_toEndOf="@+id/gl_right_margin"
        app:layout_constraintStart_toStartOf="@+id/gl_left_margin"
        app:layout_constraintTop_toBottomOf="@+id/ll_earnings_history_header" />


    <androidx.cardview.widget.CardView
        android:visibility="gone"
        android:id="@+id/cv_panDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="@dimen/_15sdp"
        app:cardBackgroundColor="@color/grey_extra_light"
        app:cardCornerRadius="10dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="@+id/gl_right_margin"
        app:layout_constraintStart_toStartOf="@+id/gl_left_margin"
        app:layout_constraintTop_toBottomOf="@+id/cl_earnings">


        <LinearLayout
            android:id="@+id/ll_"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_pan"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_margin="8dp"
                android:contentDescription="@string/edit"
                android:src="@drawable/pan"
                app:tint="@color/pink" />


            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center_vertical"
                android:text="@string/complete_Kyc"
                android:textColor="@color/black_light"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@id/gl_right_margin"
                app:layout_constraintStart_toStartOf="@id/gl_left_margin"
                app:layout_constraintTop_toBottomOf="@+id/cv_amount" />


            <ImageView
                android:id="@+id/iv_add_pan"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical"
                android:layout_margin="8dp"
                android:contentDescription="@string/edit"
                android:background="@drawable/ic_add_upi"
                app:tint="@color/pink" />
        </LinearLayout>


    </androidx.cardview.widget.CardView>





    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_help"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tv_need_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/for_any_queries"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tv_support_mail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_need_help" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>