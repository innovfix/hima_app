<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dnd_dialog"
    android:padding="24dp">

    <!-- Bug #7: match the DND confirm card — pink bell inside the soft-pink
         (#FDE7EF) badge — so the Enable and Turn-off popups render the icon
         identically instead of red-no-badge here vs pink-in-badge there. -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dnd_confirm_icon">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifications_off"
            app:tint="@color/pink" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dnd_enable_title"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:layout_marginTop="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dnd_enable_desc"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="4dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dnd_1h"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="@string/dnd_duration_1h"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/white"
        app:backgroundTint="@color/pink"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dnd_2h"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/dnd_duration_2h"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/white"
        app:backgroundTint="@color/pink"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dnd_4h"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/dnd_duration_4h"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="@color/white"
        app:backgroundTint="@color/pink"
        app:cornerRadius="14dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dnd_cancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/dnd_cancel"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="#6B7280" />

</LinearLayout>
