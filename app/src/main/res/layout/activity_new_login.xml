<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/outerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/grey_extra_light">

    <!-- Login OTP layout: the login card (ll_login_section) is pinned to the
         bottom, ABOVE the keyboard, so Send OTP is always fully visible on
         every device. The hero (logo/orbs) lives in this scroll, which flexes
         between the top and the card and scrolls only if the space above the
         keyboard is tight — so the card is never pushed under the IME. -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/heroScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/ll_login_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <!-- ===== Hidden compatibility views (kept for ViewBinding) ===== -->
    <View
        android:id="@+id/circle1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/circle2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerOnboarding"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <!-- ===== Floating decorative feature badges + sparkles (top area) =====
         BUG 4 — these were each positioned independently with percentage
         horizontal_bias / vertical_bias while being fixed-dp squares. A bias
         resolves to bias * (parentSize - viewSize), so the gap between two
         neighbours is (Δbias * parentSize - iconSize): it shrinks with the
         parent and never scales with the icons. The values were tuned on one
         device where the clearances came out at 0.4-2.5dp, so any narrower or
         shorter screen pushed them negative and the orbs visibly overlapped.

         Now every orb is anchored to its neighbour (and the cluster to
         ll_logo_section) with fixed dp margins, so the gaps are constants and
         overlap is impossible at any size, density or font scale. The sparkles
         hang off their own orb for the same reason.

         Sizes + the top margins below are re-applied in NewLoginActivity's
         applyOrbSizing() when the keyboard compacts the logo; the ANCHORS never
         change, so the cluster can only get tighter, never tangled. -->

    <!-- Chat -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:id="@+id/orb_chat"
        android:layout_marginStart="14dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="#FDE7F1"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ll_logo_section">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_chat_bubble"
            app:tint="#FF1383"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Star -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:id="@+id/orb_star"
        android:layout_marginStart="8dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#FFF1D6"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toEndOf="@id/orb_chat"
        app:layout_constraintTop_toBottomOf="@id/orb_chat">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_star"
            app:tint="#F5A623"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Connect (infinity) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:id="@+id/orb_connect"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="8dp"
        app:cardBackgroundColor="#FFEAD9"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toStartOf="@id/orb_video"
        app:layout_constraintTop_toBottomOf="@id/orb_video">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_infinity"
            app:tint="#FF6A2B"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Video -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:id="@+id/orb_video"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="4dp"
        app:cardBackgroundColor="#E3EDFF"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/ll_logo_section">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_videocam"
            app:tint="#3B82F6"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Voice / Phone -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:id="@+id/orb_phone"
        android:layout_marginStart="14dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#E4F8EA"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/orb_star">
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_phone"
            app:tint="#22C55E"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Heart -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:id="@+id/orb_heart"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#EFEAFF"
        app:cardCornerRadius="15dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/orb_connect">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_heart_filled"
            app:tint="#8B5CF6"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- Sparkles -->
    <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:id="@+id/spark1"
        android:layout_marginStart="6dp"
        android:src="@drawable/ic_sparkle"
        app:tint="#F5A623"
        app:layout_constraintStart_toEndOf="@id/orb_star"
        app:layout_constraintTop_toTopOf="@id/orb_star"
        tools:ignore="ContentDescription" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:id="@+id/spark2"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_sparkle"
        app:tint="#FF1383"
        app:layout_constraintEnd_toStartOf="@id/orb_video"
        app:layout_constraintTop_toTopOf="@id/orb_video"
        tools:ignore="ContentDescription" />

    <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:id="@+id/spark3"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="14dp"
        android:src="@drawable/ic_sparkle"
        app:tint="#FF6A2B"
        app:layout_constraintEnd_toStartOf="@id/orb_connect"
        app:layout_constraintTop_toTopOf="@id/orb_connect"
        tools:ignore="ContentDescription" />

    <ImageView
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:id="@+id/spark4"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_sparkle"
        app:tint="#34D399"
        app:layout_constraintStart_toEndOf="@id/orb_star"
        app:layout_constraintTop_toBottomOf="@id/orb_star"
        tools:ignore="ContentDescription" />

    <ImageView
        android:layout_width="13dp"
        android:layout_height="13dp"
        android:id="@+id/spark5"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:src="@drawable/ic_sparkle"
        app:tint="#A78BFA"
        app:layout_constraintEnd_toStartOf="@id/orb_connect"
        app:layout_constraintTop_toBottomOf="@id/orb_connect"
        tools:ignore="ContentDescription" />

    <!-- Back button shown only on OTP step, top-left -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_otp_back"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/iv_otp_back"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="#374151" />

    </androidx.cardview.widget.CardView>

    <!-- ===== Logo + Brand + Feature row ===== -->
    <!-- BUG #3 — this block is centred between the top and the pinned login card, so the gap
         under the feature row is leftover free space: (available - hero) / 2 + paddingBottom.
         On short/dense screens the leftover goes to ~0 and only paddingBottom is left, which
         put the Chat/Video/Voice/Connect labels against the card. 16dp -> 28dp raises that floor. -->
    <LinearLayout
        android:id="@+id/ll_logo_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Square brand logo -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logoContainer"
            android:layout_width="94dp"
            android:layout_height="94dp"
            android:layout_gravity="center"
            android:elevation="9dp"
            app:cardBackgroundColor="@color/colorAccent"
            app:cardCornerRadius="27dp"
            app:cardElevation="9dp"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:id="@+id/logoInner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/imageViewLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:src="@drawable/logo"
                    android:contentDescription="@string/app_name" />

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- BUG 6 — needs an id: the keyboard compaction has to be able to resize
             this wordmark. Without one it could not participate in the hero tiers
             and got sliced off whenever the hero band was shorter than the stack. -->
        <TextView
            android:id="@+id/tv_brand_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="30sp"
            android:textColor="#1F2430"
            android:fontFamily="@font/poppins_bold"
            android:letterSpacing="-0.01"
            android:layout_marginBottom="1dp" />

        <TextView
            android:id="@+id/tv_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Where Feelings Connect"
            android:textSize="14sp"
            android:textColor="@color/grey_medium"
            android:fontFamily="@font/poppins_regular" />

        <!-- Feature row -->
        <LinearLayout
            android:id="@+id/ll_feature_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp"
            android:gravity="center">

            <!-- Chat -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="10dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/feat_chat"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="6dp"
                    android:outlineSpotShadowColor="#FF1383"
                    android:outlineAmbientShadowColor="#FF1383">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_feat_chat" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat_bubble"
                        app:tint="#FFFFFF"
                        tools:ignore="ContentDescription" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tile_gloss" />
                    <View
                        android:id="@+id/shine_chat"
                        android:layout_width="16dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_shine"
                        android:rotation="20"
                        android:translationX="-60dp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Chat"
                    android:textSize="12sp"
                    android:textColor="#4B5563"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>

            <!-- Video -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="10dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/feat_video"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="6dp"
                    android:outlineSpotShadowColor="#2F6BFF"
                    android:outlineAmbientShadowColor="#2F6BFF">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_feat_video" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_videocam"
                        app:tint="#FFFFFF"
                        tools:ignore="ContentDescription" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tile_gloss" />
                    <View
                        android:id="@+id/shine_video"
                        android:layout_width="16dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_shine"
                        android:rotation="20"
                        android:translationX="-60dp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Video"
                    android:textSize="12sp"
                    android:textColor="#4B5563"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>

            <!-- Voice -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="10dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/feat_voice"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="6dp"
                    android:outlineSpotShadowColor="#12B76A"
                    android:outlineAmbientShadowColor="#12B76A">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_feat_voice" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_phone"
                        app:tint="#FFFFFF"
                        tools:ignore="ContentDescription" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tile_gloss" />
                    <View
                        android:id="@+id/shine_voice"
                        android:layout_width="16dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_shine"
                        android:rotation="20"
                        android:translationX="-60dp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Voice"
                    android:textSize="12sp"
                    android:textColor="#4B5563"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>

            <!-- Connect -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginHorizontal="10dp">
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/feat_connect"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="15dp"
                    app:cardElevation="6dp"
                    android:outlineSpotShadowColor="#7C4DFF"
                    android:outlineAmbientShadowColor="#7C4DFF">
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_feat_connect" />
                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_heart_filled"
                        app:tint="#FFFFFF"
                        tools:ignore="ContentDescription" />
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_tile_gloss" />
                    <View
                        android:id="@+id/shine_connect"
                        android:layout_width="16dp"
                        android:layout_height="96dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_shine"
                        android:rotation="20"
                        android:translationX="-60dp" />
                </com.google.android.material.card.MaterialCardView>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Connect"
                    android:textSize="12sp"
                    android:textColor="#4B5563"
                    android:fontFamily="@font/poppins_medium" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== Form sheet (rounded top) — pinned above the keyboard ===== -->
    <LinearLayout
        android:id="@+id/ll_login_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/login_form_background"
        android:paddingTop="28dp"
        android:paddingBottom="28dp"
        android:paddingHorizontal="24dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ===== Login Section =====
             BUG #5 — this card is wrap_content pinned to the bottom, so ConstraintLayout
             measures it with AT_MOST(spaceAboveKeyboard) and LinearLayout.resolveSizeAndState()
             CLAMPS it to that. Children were still laid out top-down, so once the referral row
             (+70dp) was revealed the tail of the card - bottom padding, terms line and part of
             Send OTP itself - fell outside the clamped bounds and was simply never drawn. There
             was nothing to scroll either: heroScroll wraps the hero, not this form.

             Fix: the fields live in loginFieldsScroll, which is the ONLY weighted child here.
             A vertical LinearLayout under AT_MOST computes delta = allowed - content and
             distributes it to weighted children ONLY. delta >= 0 (form fits) -> nothing is
             distributed and the card looks exactly as before. delta < 0 -> the whole shortfall
             comes out of the scroll, which scrolls instead of clipping. Send OTP + terms sit
             outside the scroll with no weight, so they can never shrink or be cut, at any
             scroll position, on any screen size or font scale. -->
        <LinearLayout
            android:id="@+id/login_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/loginFieldsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Get Started"
                android:textSize="26sp"
                android:textColor="#1F2430"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="22dp"
                android:text="Enter your mobile number to continue"
                android:textSize="14sp"
                android:textColor="@color/grey_medium"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp"
                android:layout_marginBottom="8dp"
                android:textColor="#1F2430"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/mobile_number" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_login"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                app:cardElevation="0dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#C7CDD9"
                app:strokeWidth="1.4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cl_country"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:clickable="false"
                        android:focusable="false">

                        <ImageView
                            android:id="@+id/iv_flag"
                            android:layout_width="26dp"
                            android:layout_height="18dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:src="@drawable/india"
                            tools:ignore="ContentDescription" />

                        <ImageView
                            android:id="@+id/iv_down_arrow"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            app:layout_constraintStart_toEndOf="@+id/iv_flag"
                            android:layout_marginStart="4dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:src="@drawable/ic_down_arrow"
                            app:tint="@color/colorPrimaryDark"
                            android:visibility="gone"
                            tools:ignore="ContentDescription" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <TextView
                        android:id="@+id/tv_country_code"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:textColor="#1F2430"
                        android:textSize="16sp"
                        android:text="+91"
                        android:fontFamily="@font/poppins_semibold" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="12dp"
                        android:background="#E3E6EC" />

                    <EditText
                        android:id="@+id/et_mobile_number"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:autofillHints="phone"
                        android:background="@android:color/transparent"
                        android:textCursorDrawable="@drawable/color_cursor"
                        android:textColor="#1F2430"
                        android:hint="Enter mobile number"
                        android:textColorHint="#9AA0AC"
                        android:textSize="16sp"
                        android:imeOptions="actionDone"
                        android:inputType="phone"
                        android:maxLength="10"
                        android:fontFamily="@font/poppins_medium" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- B_059: OTP helper text sits directly under the mobile number field
                 (it refers to the number, not the referral code below). -->
            <TextView
                android:id="@+id/tv_otp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/grey_medium"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/you_will_receive_an_otp_on_this_number" />

            <!-- Referral code checkbox -->
            <CheckBox
                android:id="@+id/referCode_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Have a referral code?"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:buttonTint="@color/colorAccent"
                android:fontFamily="@font/poppins_regular"
                android:visibility="visible" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_referCode"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                app:cardElevation="0dp"
                app:cardCornerRadius="14dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#C7CDD9"
                app:strokeWidth="1.4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp">
                    <EditText
                        android:id="@+id/et_referCode"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="match_parent"
                        android:hint="Enter referral code"
                        android:textSize="15sp"
                        android:textColor="#1F2430"
                        android:textColorHint="#9AA0AC"
                        android:fontFamily="@font/poppins_medium"
                        android:background="@android:color/transparent"
                        android:textCursorDrawable="@drawable/color_cursor"
                        android:imeOptions="actionDone" />
                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/applyReferral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apply"
                            android:textSize="13sp"
                            android:textColor="@color/white"
                            android:fontFamily="@font/poppins_semibold"
                            android:minHeight="0dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            app:cornerRadius="8dp"
                            app:backgroundTint="@color/colorAccent" />

                        <ProgressBar
                            android:id="@+id/pb_apply_referral_loader"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:elevation="8dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            android:indeterminateTint="@color/white"
                            android:layout_centerInParent="true" />

                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Send OTP Button — PINNED. Outside loginFieldsScroll and carries no
                 layout_weight, so the shortfall can never be taken out of it. -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_otp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textAllCaps="false"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/send_otp"
                    android:textSize="16sp"
                    app:cornerRadius="14dp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/colorAccent" />

                <ProgressBar
                    android:id="@+id/pb_send_otp_loader"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:elevation="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:indeterminateTint="@color/white"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <!-- Terms and Conditions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="start"
                android:layout_marginTop="2dp">

                <CheckBox
                    android:id="@+id/cb_terms_and_conditions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/colorAccent"
                    android:checked="true"
                    android:focusable="false"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:padding="0dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_terms_and_conditions"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/terms_and_conditions_text"
                    android:textColor="@color/grey_medium"
                    android:textSize="11sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- ===== OTP Section ===== -->
        <LinearLayout
            android:id="@+id/otp_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Verify OTP"
                android:textSize="26sp"
                android:textColor="#1F2430"
                android:fontFamily="@font/poppins_bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="14dp"
                android:textColor="@color/grey_medium"
                android:fontFamily="@font/poppins_regular"
                android:text="OTP sent to" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_otp_mobile_number"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textColor="#1F2430"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="7010565083" />

                <TextView
                    android:id="@+id/iv_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/colorAccent"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Change"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingVertical="4dp"
                    android:paddingHorizontal="8dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="13sp"
                android:layout_marginBottom="10dp"
                android:textColor="@color/grey_medium"
                android:fontFamily="@font/poppins_medium"
                android:text="Enter 6-digit OTP" />

            <com.chaos.view.PinView
                android:id="@+id/pv_otp"
                style="@style/PinWidget.PinView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="18dp"
                android:cursorVisible="true"
                android:inputType="number"
                android:itemBackground="@color/grey_extra_light"
                android:textColor="@color/colorAccent"
                android:textSize="18sp"
                app:hideLineWhenFilled="true"
                app:itemCount="6"
                app:itemHeight="46dp"
                app:itemRadius="8dp"
                app:itemSpacing="4dp"
                app:itemWidth="42dp"
                app:lineColor="@color/colorAccent"
                app:lineWidth="2dp" />

            <!-- Verify OTP Button -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_verify_otp"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:textAllCaps="false"
                    android:enabled="false"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Verify OTP"
                    android:textSize="16sp"
                    app:cornerRadius="14dp"
                    android:textColor="@color/white"
                    app:backgroundTint="@color/colorAccent" />

                <ProgressBar
                    android:id="@+id/pb_verify_otp_loader"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:elevation="8dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    android:indeterminateTint="@color/white"
                    android:layout_centerInParent="true" />
            </RelativeLayout>

            <!-- Resend OTP Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Didn't receive the OTP? "
                    android:textSize="13sp"
                    android:textColor="@color/grey_medium"
                    android:fontFamily="@font/poppins_regular" />

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_resend_otp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAllCaps="false"
                        android:text="Resend"
                        android:textSize="13sp"
                        android:textColor="@color/colorAccent"
                        android:fontFamily="@font/poppins_semibold"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="8dp"
                        app:backgroundTint="@android:color/transparent"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"
                        android:enabled="false" />

                    <ProgressBar
                        android:id="@+id/pb_loader"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerInParent="true"
                        android:indeterminate="true"
                        android:visibility="gone"
                        android:indeterminateTint="@color/colorAccent" />
                </RelativeLayout>
            </LinearLayout>

            <!-- Hidden duplicate terms for compatibility -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <CheckBox
                    android:id="@+id/cb_otp_terms_and_conditions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <TextView
                    android:id="@+id/tv_otp_terms_and_conditions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
