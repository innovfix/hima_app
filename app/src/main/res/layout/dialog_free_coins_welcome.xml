<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    android:layout_margin="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/dialog_premium_gradient_background"
        android:paddingBottom="20dp">

        <!-- Top Decorative Section with Gradient -->
        <View
            android:id="@+id/v_top_gradient"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:background="@drawable/dialog_top_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Floating Gift Box with Shadow -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_gift_container"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="50dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/iv_gift_box"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_gift_box"
                android:scaleType="fitCenter"
                tools:ignore="ContentDescription" />

        </androidx.cardview.widget.CardView>

        <!-- Decorative Stars/Sparkles -->
        <ImageView
            android:id="@+id/iv_star_left"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_star"
            android:alpha="0.8"
            app:layout_constraintTop_toTopOf="@+id/cv_gift_container"
            app:layout_constraintEnd_toStartOf="@+id/cv_gift_container"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            tools:ignore="ContentDescription" />

        <ImageView
            android:id="@+id/iv_star_right"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_star"
            android:alpha="0.8"
            app:layout_constraintTop_toTopOf="@+id/cv_gift_container"
            app:layout_constraintStart_toEndOf="@+id/cv_gift_container"
            android:layout_marginStart="12dp"
            android:layout_marginTop="25dp"
            tools:ignore="ContentDescription" />

        <!-- Welcome Gift Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_welcome_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="@color/pink"
            app:layout_constraintTop_toBottomOf="@+id/cv_gift_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_gift_white"
                    android:layout_marginEnd="5dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tv_welcome_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WELCOME GIFT"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_bold"
                    android:letterSpacing="0.08"/>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Title Section -->
        <TextView
            android:id="@+id/tv_first_minute_free"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="First Minute for Free"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1E1E1E"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            app:layout_constraintTop_toBottomOf="@+id/cv_welcome_badge"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subtitle with Icon -->
        <LinearLayout
            android:id="@+id/ll_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@+id/tv_first_minute_free"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check_circle"
                android:layout_marginEnd="5dp"
                app:tint="#4CAF50"
                tools:ignore="ContentDescription" />

            <TextView
                android:id="@+id/tv_no_payment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Payment Required"
                android:textSize="13sp"
                android:textColor="#4CAF50"
                android:fontFamily="@font/poppins_semibold"/>

        </LinearLayout>

        <!-- Coins Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_coins_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:strokeWidth="1dp"
            app:strokeColor="#F0F0F0"
            app:cardBackgroundColor="#FAFAFA"
            app:layout_constraintTop_toBottomOf="@+id/ll_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/iv_coin_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/coin_d"
                    android:layout_marginEnd="8dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tv_coins_will_be_added"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="10 coins will be added"
                    android:textSize="12sp"
                    android:textColor="#555555"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_medium" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Premium Claim Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_claim_free_minute"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:text="Claim Free Minute"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:backgroundTint="@color/pink"
            android:letterSpacing="0.01"
            app:cornerRadius="14dp"
            app:elevation="6dp"
            app:icon="@drawable/ic_gift_white"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconSize="20dp"
            app:layout_constraintTop_toBottomOf="@+id/cv_coins_info"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Dismiss hint -->
        <TextView
            android:id="@+id/tv_dismiss_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Tap outside to dismiss"
            android:textSize="10sp"
            android:textColor="#AAAAAA"
            android:fontFamily="@font/poppins_regular"
            app:layout_constraintTop_toBottomOf="@+id/btn_claim_free_minute"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>
