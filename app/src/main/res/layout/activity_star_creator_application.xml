<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF5F8">

    <!-- ─── Hero Header ─────────────────────────────────────────── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/star_creator_header_gradient"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:paddingHorizontal="20dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/ripple_effect"
            android:contentDescription="@string/back"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/iv_back"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_star_filled"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="@string/star_creator_form_title"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="@string/star_creator_form_subtitle"
                android:textColor="#FFE0EF"
                android:textSize="13sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ─── Scrollable Form Body ──────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="20dp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp">

            <!-- ─── Step 1 · Experience ────────────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="#FCE4EC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Step header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/star_creator_step_circle"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="1"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_q1_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="#1F2937"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tv_q1_sublabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Full question label (always fully visible) -->
                    <TextView
                        android:id="@+id/tv_q1_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/star_creator_speech_card_bg"
                        android:fontFamily="@font/poppins_medium"
                        android:padding="12dp"
                        android:textColor="#BE185D"
                        android:textSize="13sp" />

                    <!-- Answer field -->
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_experience"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/star_creator_exp_answer_hint"
                        app:boxCornerRadiusBottomEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp"
                        app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusTopStart="10dp"
                        app:boxStrokeColor="@color/colorAccent"
                        app:hintTextColor="@color/colorAccent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_experience"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:inputType="textMultiLine"
                            android:maxLines="4"
                            android:minLines="2" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Step 2 · Call Preference ──────────────────── -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="#FCE4EC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/star_creator_step_circle"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="2"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_q2_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="#1F2937"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tv_q2_sublabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Question label -->
                    <TextView
                        android:id="@+id/tv_q2_question"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/star_creator_speech_card_bg"
                        android:fontFamily="@font/poppins_medium"
                        android:padding="12dp"
                        android:textColor="#BE185D"
                        android:textSize="13sp" />

                    <!-- Option chips -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <TextView
                            android:id="@+id/chip_audio"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/star_creator_chip_unselected"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:text="@string/audio"
                            android:textColor="#BE185D"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chip_video"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginHorizontal="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/star_creator_chip_unselected"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:text="@string/video"
                            android:textColor="#BE185D"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/chip_both"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/star_creator_chip_unselected"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:text="@string/star_creator_both_option"
                            android:textColor="#BE185D"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ─── Step 3 · Record (shown after chip) ────────── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_record_section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="4dp"
                app:strokeColor="#FCE4EC"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <!-- Step 3 header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/star_creator_step_circle"
                            android:fontFamily="@font/poppins_bold"
                            android:gravity="center"
                            android:text="3"
                            android:textColor="@color/white"
                            android:textSize="13sp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_record_step_title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_bold"
                                android:textColor="#1F2937"
                                android:textSize="15sp" />

                            <TextView
                                android:id="@+id/tv_record_step_subtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:textColor="#9CA3AF"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Speech card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/star_creator_speech_card_bg"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginBottom="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_mic"
                                app:tint="@color/colorAccent" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/star_creator_speech_title"
                                android:textColor="@color/colorAccent"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#FCE4EC"
                            android:layout_marginBottom="10dp"/>

                        <TextView
                            android:id="@+id/tv_speech_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingMultiplier="1.4"
                            android:textColor="#374151"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <!-- Audio record UI -->
                    <LinearLayout
                        android:id="@+id/ll_audio_record"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <FrameLayout
                            android:id="@+id/fl_mic_ripple"
                            android:layout_width="100dp"
                            android:layout_height="100dp"
                            android:layout_gravity="center">

                            <ImageView
                                android:id="@+id/iv_mic_ripple1"
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:alpha="0.15"
                                android:background="@drawable/star_creator_mic_bg" />

                            <FrameLayout
                                android:id="@+id/fl_mic_btn"
                                android:layout_width="72dp"
                                android:layout_height="72dp"
                                android:layout_gravity="center"
                                android:background="@drawable/star_creator_mic_bg">

                                <ImageView
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_mic"
                                    app:tint="@color/white" />
                            </FrameLayout>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tv_mic_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/star_creator_tap_record"
                            android:textColor="@color/colorAccent"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tv_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="00:00"
                            android:textColor="@color/colorAccent"
                            android:textSize="22sp"
                            android:visibility="gone" />

                        <!-- Playback controls after recording -->
                        <LinearLayout
                            android:id="@+id/ll_playback"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/star_creator_speech_card_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:visibility="gone">

                            <ImageView
                                android:id="@+id/iv_play_pause"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="@drawable/star_creator_mic_bg"
                                android:padding="8dp"
                                android:src="@drawable/play"
                                app:tint="@color/white" />

                            <ProgressBar
                                android:id="@+id/pb_audio"
                                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_marginHorizontal="12dp"
                                android:layout_weight="1"
                                android:progressTint="@color/colorAccent"
                                android:progressBackgroundTint="#FCE4EC" />

                            <TextView
                                android:id="@+id/tv_playback_time"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_medium"
                                android:text="0:00"
                                android:textColor="@color/colorAccent"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_record_again"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="@string/record_again"
                            android:textColor="@color/colorAccent"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Video record UI -->
                    <LinearLayout
                        android:id="@+id/ll_video_record"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <!-- Success state (after video recorded) -->
                        <LinearLayout
                            android:id="@+id/ll_video_success"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/star_creator_speech_card_bg"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="12dp"
                            android:visibility="gone">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_check_circle" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:fontFamily="@font/poppins_semibold"
                                android:text="@string/star_creator_video_recorded_success"
                                android:textColor="#10B981"
                                android:textSize="13sp" />

                            <!-- Play preview button -->
                            <TextView
                                android:id="@+id/btn_play_video_preview"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:background="@drawable/star_creator_chip_selected"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="@font/poppins_semibold"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="▶  Play"
                                android:textColor="@color/white"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btn_open_video_recorder"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/star_creator_record_btn"
                            android:fontFamily="@font/poppins_semibold"
                            android:gravity="center"
                            android:text="@string/star_creator_record_video_btn"
                            android:textColor="@color/white"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tv_video_status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/poppins_medium"
                            android:gravity="center"
                            android:textColor="@color/colorAccent"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Submit button -->
            <TextView
                android:id="@+id/btn_continue"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:background="@drawable/star_creator_continue_btn"
                android:elevation="4dp"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:text="@string/star_creator_submit"
                android:textColor="@color/white"
                android:textSize="16sp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
