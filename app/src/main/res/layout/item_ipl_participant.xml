<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_participant_card"
    android:padding="8dp">

    <!-- Speaking Ring (visible when speaking) -->
    <View
        android:id="@+id/view_speaking_ring"
        android:layout_width="82dp"
        android:layout_height="82dp"
        android:background="@drawable/bg_speaking_ring"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_participant_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4"/>

    <!-- Avatar Circle with Initials -->
    <FrameLayout
        android:id="@+id/fl_avatar"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_participant_name"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <View
            android:id="@+id/view_avatar_bg"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_avatar_placeholder"/>

        <TextView
            android:id="@+id/tv_avatar_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:fontFamily="@font/poppins_bold"
            tools:text="RF"/>
    </FrameLayout>

    <!-- Mute Indicator (overlaid on avatar bottom-right) -->
    <FrameLayout
        android:id="@+id/fl_mute_indicator"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/fl_avatar"
        app:layout_constraintEnd_toEndOf="@id/fl_avatar">

        <View
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/professional_control_button_bg"/>

        <ImageView
            android:id="@+id/iv_mute_indicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/mute_img"
            android:contentDescription="Muted"/>
    </FrameLayout>

    <!-- Team Badge (overlaid on avatar top-right) -->
    <FrameLayout
        android:id="@+id/fl_team_badge"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="@id/fl_avatar"
        app:layout_constraintEnd_toEndOf="@id/fl_avatar"
        android:layout_marginTop="-4dp"
        android:layout_marginEnd="-4dp">

        <View
            android:id="@+id/view_team_badge_bg"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_team_circle"/>

        <TextView
            android:id="@+id/tv_team_badge_abbr"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="9sp"
            android:fontFamily="@font/poppins_bold"
            tools:text="MI"/>
    </FrameLayout>

    <!-- HOST Badge (above avatar, centered) -->
    <TextView
        android:id="@+id/tv_creator_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOST"
        android:textColor="@color/white"
        android:textSize="9sp"
        android:fontFamily="@font/poppins_bold"
        android:letterSpacing="0.08"
        android:background="@drawable/bg_host_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:visibility="gone"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toTopOf="@id/fl_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Participant Name -->
    <TextView
        android:id="@+id/tv_participant_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="4dp"
        app:layout_constraintBottom_toTopOf="@id/tv_remaining_minutes"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Rohit Fan"/>

    <!-- Remaining minutes (coins) -->
    <TextView
        android:id="@+id/tv_remaining_minutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#80FFFFFF"
        android:textSize="9sp"
        android:fontFamily="@font/poppins_regular"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="3 min left"/>

    <!-- ===== EMPTY STATE ===== -->
    <ImageView
        android:id="@+id/iv_empty_cricket_ball"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_cricket_ball"
        android:alpha="0.3"
        android:visibility="gone"
        android:contentDescription="Empty slot"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tv_empty_label"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4"/>

    <TextView
        android:id="@+id/tv_empty_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/waiting_for_player"
        android:textColor="#60FFFFFF"
        android:textSize="10sp"
        android:fontFamily="@font/poppins_regular"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
