<?xml version="1.0" encoding="utf-8"?>
<!-- 
    PROFESSIONAL AUDIO CALLING UI DESIGN
    
    Design Features:
    - Clean dark gradient background (elegant navy blue gradient)
    - Centered timer with icon at the top
    - Large professional user avatar cards prominently displayed
    - Control buttons at bottom in horizontal layout
    - Improved spacing and alignment throughout
    - Minimalist design with focus on audio call
-->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@drawable/professional_call_background">

    <!-- Drifting "smoke" glows (animated in code), behind all content -->
    <View
        android:id="@+id/glow_tl"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginStart="-90dp"
        android:layout_marginTop="-90dp"
        android:background="@drawable/bg_call_glow_pink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glow_br"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="-110dp"
        android:background="@drawable/bg_call_glow_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Video Containers -->
    <androidx.cardview.widget.CardView
        android:id="@+id/localCardView"
        android:layout_width="@dimen/_120sdp"
        android:layout_height="190dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginRight="@dimen/_6sdp"
        android:layout_marginTop="@dimen/_6sdp"
        app:cardElevation="5dp">

        <FrameLayout
            android:id="@+id/local_video_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
    </androidx.cardview.widget.CardView>
    
    <FrameLayout
        android:id="@+id/remote_video_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_centerHorizontal="true"
        android:background="@android:color/darker_gray" />

    <!-- Top Bar Container -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Connection Quality Indicator -->
        <ImageView
            android:id="@+id/iv_signal_strength"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_signal_strong"
            android:contentDescription="Signal Strength"
            android:layout_marginEnd="8dp"/>

        <!-- B060 — explicit call-type label so the user can tell at a glance
             this is an Audio call (not Video), avoiding confusion when the
             screen briefly looks generic during connect. -->
        <TextView
            android:id="@+id/tv_call_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/call_type_audio"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"/>

        <!-- Spacer pushes the (invisible) menu button to the right edge.
             B041: timer_container was previously between two weighted spacers
             inside this row, which centered it within the *leftover* space,
             not the screen. Moved out to the root ConstraintLayout below so
             it sits at the true horizontal center of the screen. -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Menu Button (Hidden) -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="invisible"
            android:contentDescription="Menu"/>

    </LinearLayout>

    <!-- B041: Timer pinned to true horizontal center of the screen, vertically
         centered on the top_bar row. Independent of tv_call_type / btn_menu
         widths, so it no longer drifts when the call-type label is localized. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/timer_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/professional_timer_bg"
        android:elevation="11dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="@id/top_bar"
        app:layout_constraintBottom_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Timer Icon -->
        <ImageView
            android:id="@+id/iv_timer_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_timer_professional"
            android:layout_marginEnd="6dp"
            android:contentDescription="Timer"
            app:tint="#1A237E"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Timer Text -->
        <TextView
            android:id="@+id/tvRemainingTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="#1A237E"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.05"
            app:layout_constraintStart_toEndOf="@id/iv_timer_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Plus Icon (for adding time) -->
        <ImageView
            android:id="@+id/iv_plus"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/baseline_add_24"
            android:visibility="gone"
            android:contentDescription="Add Time"
            app:tint="#FFFFFF"
            app:layout_constraintStart_toEndOf="@id/tvRemainingTime"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Video-mode mute indicators (icon-only): peer (left) + self (right),
         shown at the TOP during video so they don't float over the remote
         video at the old avatar positions. Audio mode keeps using the
         per-avatar femaleMute/maleMute badges in users_container. -->
    <LinearLayout
        android:id="@+id/ll_video_mute_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:elevation="12dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/timer_container">

        <ImageView
            android:id="@+id/iv_peer_mute_top"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="10dp"
            android:padding="6dp"
            android:background="@drawable/bg_circle_mute_top"
            android:src="@drawable/mute_img"
            android:visibility="gone"
            android:contentDescription="Other person muted" />

        <ImageView
            android:id="@+id/iv_self_mute_top"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:padding="6dp"
            android:background="@drawable/bg_circle_mute_top"
            android:src="@drawable/mute_img"
            android:visibility="gone"
            android:contentDescription="You are muted" />

    </LinearLayout>

    <!-- "Reconnecting…" pill — toggled by CallQualityUi from Agora onConnectionStateChanged. -->
    <TextView
        android:id="@+id/reconnect_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_reconnect_pill"
        android:elevation="10dp"
        android:text="@string/call_reconnecting"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar" />

    <!-- B196 — visible while a SIM phone call is in progress so the user
         knows the Hima call is paused, not just silently broken. Toggled
         from muteForInterrupt(). -->
    <TextView
        android:id="@+id/on_hold_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_reconnect_pill"
        android:elevation="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/call_on_hold_phone_busy"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/reconnect_banner" />

    <!-- Shown to the OTHER party when the peer puts the call on hold to take a
         cellular / VoIP call (HOLD signal over the Agora data stream). Text is
         set at runtime via call_peer_on_hold with the peer's name. -->
    <TextView
        android:id="@+id/peer_on_hold_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_reconnect_pill"
        android:elevation="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/on_hold_banner" />

    <!-- B055 — top-bar "Peer is muted" pill was removed; the unsized
         drawableStart icon rendered huge on real devices. The small
         per-avatar femaleMute/maleMute badges in users_container are the
         remaining mute indicator. -->
    <View
        android:id="@+id/remote_mic_muted_pill"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/on_hold_banner" />

    <!-- I021 — low-balance warning banner. Reveals when the in-call timer
         drops below 60s. Tap a chip or "Go to wallet" to recharge mid-call;
         CallingService keeps audio alive while the user is in payment flow. -->
    <include
        android:id="@+id/low_balance_banner_root"
        layout="@layout/banner_low_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/remote_mic_muted_pill" />

    <!-- User Avatars Container (Center) -->
    <LinearLayout
        android:id="@+id/users_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="visible"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/quick_gift_section"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.45">

        <!-- Male User Section -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp">

            <LinearLayout
                android:id="@+id/male_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Male Avatar with Team Color Border -->
                <FrameLayout
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Male Wave Animation (centered on avatar) -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/male_wave"
                        android:layout_width="170dp"
                        android:layout_height="170dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:scaleType="fitCenter"
                        app:lottie_fileName="wave.json"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="true" />

                    <View
                        android:id="@+id/male_team_ring"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:background="@drawable/bg_team_circle" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:cardCornerRadius="65dp"
                        app:cardElevation="16dp">

                        <ImageView
                            android:id="@+id/iv_male_user"
                            android:layout_width="126dp"
                            android:layout_height="126dp"
                            android:scaleType="centerCrop"
                            android:padding="3dp"
                            android:background="#FFFFFF"
                            android:contentDescription="Male User"/>

                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <!-- Male Name -->
                <TextView
                    android:id="@+id/tv_male_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    tools:text="User"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="140dp"
                    android:gravity="center"/>

                <!-- Male IPL Team Badge -->
                <LinearLayout
                    android:id="@+id/male_ipl_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_ipl_call_team_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/male_ipl_dot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_team_circle" />

                    <TextView
                        android:id="@+id/tv_male_ipl_team"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Male Mute Indicator -->
                <ImageView
                    android:id="@+id/maleMute"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/mute_img"
                    android:visibility="invisible"
                    android:contentDescription="Muted"/>

            </LinearLayout>

        </RelativeLayout>

        <!-- Female User Section -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp">

            <LinearLayout
                android:id="@+id/female_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <!-- Female Avatar with Team Color Border -->
                <FrameLayout
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    android:layout_marginBottom="16dp"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- Female Wave Animation (centered on avatar) -->
                    <com.airbnb.lottie.LottieAnimationView
                        android:id="@+id/female_wave"
                        android:layout_width="170dp"
                        android:layout_height="170dp"
                        android:layout_gravity="center"
                        android:alpha="0"
                        android:scaleType="fitCenter"
                        app:lottie_fileName="wave.json"
                        app:lottie_autoPlay="false"
                        app:lottie_loop="true" />

                    <View
                        android:id="@+id/female_team_ring"
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center"
                        android:visibility="gone"
                        android:background="@drawable/bg_team_circle" />

                    <!-- Rotating neon gradient ring hugging the female avatar edge -->
                    <View
                        android:id="@+id/female_gradient_ring"
                        android:layout_width="148dp"
                        android:layout_height="148dp"
                        android:layout_gravity="center"
                        android:background="@drawable/ring_call_neon" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        app:cardCornerRadius="65dp"
                        app:cardElevation="16dp">

                        <ImageView
                            android:id="@+id/iv_female_user"
                            android:layout_width="126dp"
                            android:layout_height="126dp"
                            android:scaleType="centerCrop"
                            android:padding="3dp"
                            android:background="#FFFFFF"
                            android:contentDescription="Female User"/>

                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <!-- Female Name -->
                <TextView
                    android:id="@+id/tv_female_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    tools:text="User"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:maxWidth="140dp"
                    android:gravity="center"/>

                <!-- Female IPL Team Badge -->
                <LinearLayout
                    android:id="@+id/female_ipl_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_ipl_call_team_badge"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/female_ipl_dot"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:background="@drawable/bg_team_circle" />

                    <TextView
                        android:id="@+id/tv_female_ipl_team"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/poppins_bold"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Female Mute Indicator -->
                <ImageView
                    android:id="@+id/femaleMute"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="8dp"
                    android:src="@drawable/mute_img"
                    android:visibility="invisible"
                    android:contentDescription="Muted"/>

            </LinearLayout>

        </RelativeLayout>

    </LinearLayout>

    <!-- ===== Inline quick-gift row — "Tap to send" (one tap sends instantly).
         Replaces the floating Send-Gift button. Cards are populated at runtime
         from GiftManager.getCachedGifts() and wired to the same send pipeline. -->
    <LinearLayout
        android:id="@+id/quick_gift_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header: "🎁 Tap to send" + "One tap · sends instantly" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎁"
                android:textSize="16sp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to send"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One tap · sends instantly"
                android:textColor="#8E8AA3"
                android:textSize="12sp"
                android:fontFamily="sans-serif" />

        </LinearLayout>

        <!-- 4 quick-gift cards -->
        <LinearLayout
            android:id="@+id/quick_gift_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="4"
            android:baselineAligned="false">

            <LinearLayout
                android:id="@+id/gift_card_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_quick_gift_card"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_quick_gift_1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Gift" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/coin_d"
                        android:contentDescription="Coins" />

                    <TextView
                        android:id="@+id/tv_quick_gift_coins_1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/gift_card_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_quick_gift_card"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_quick_gift_2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Gift" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/coin_d"
                        android:contentDescription="Coins" />

                    <TextView
                        android:id="@+id/tv_quick_gift_coins_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/gift_card_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_quick_gift_card"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_quick_gift_3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Gift" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/coin_d"
                        android:contentDescription="Coins" />

                    <TextView
                        android:id="@+id/tv_quick_gift_coins_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/gift_card_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_quick_gift_card"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="10dp"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/iv_quick_gift_4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Gift" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/coin_d"
                        android:contentDescription="Coins" />

                    <TextView
                        android:id="@+id/tv_quick_gift_coins_4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- Control Buttons Container (Bottom) -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="40dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Video Call Toggle Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_buttons"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <FrameLayout
                android:id="@+id/video_button_frame"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/btn_video_call"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/videocall_img"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Video"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                app:layout_constraintTop_toBottomOf="@id/video_button_frame"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Microphone Toggle Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/btn_MuteUnmute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/unmute_img"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Microphone"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- End Call Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:id="@+id/btn_endCall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_end_call_bg"
                    android:src="@drawable/endcall"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="End Call"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>

        <!-- Speaker Toggle Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/btn_speaker"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/speakeron_img"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Speaker"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/ludo_button_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/users_container"
        app:layout_constraintVertical_bias="0.75">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/ludo_button_bg"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/ludo_badge_bg"
                android:gravity="center"
                android:text="L"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_ludo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Play Ludo"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- Gift Button (Professional Design) — replaced by inline quick-gift row;
         kept (hidden) because MaleAudioCallingActivity still binds giftButtonCard. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/gift_button_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="28dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="#E91E63"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/users_container"
        app:layout_constraintVertical_bias="0.75">
        
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">
            
            <ImageView
                android:id="@+id/iv_gift"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/gift_png"
                android:layout_marginEnd="8dp"
                android:contentDescription="Send Gift"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send Gift"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.02"/>
                
        </LinearLayout>
        
    </androidx.cardview.widget.CardView>

    <ImageView
        android:id="@+id/iv_gift_image"
        android:layout_width="@dimen/_95sdp"
        android:layout_height="95dp"
        android:src="@drawable/gift_png"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gift_button_card"
        android:contentDescription="Gift Animation"/>

    <!-- Debug Buttons (Hidden in production) -->
    <Button
        android:id="@+id/JoinButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Join"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/LeaveButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leave"
        tools:ignore="MissingConstraints" />

    <!-- Black Screen Overlay (for transitions) -->
    <ImageView
        android:id="@+id/blackscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/black"
        android:visibility="gone"
        android:contentDescription="Loading"/>

    <include
        android:id="@+id/remoteBlurOverlay"
        layout="@layout/overlay_remote_blur_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Face Detection Overlay -->
    <include
        android:id="@+id/faceDetectionOverlay"
        layout="@layout/overlay_face_detection"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>