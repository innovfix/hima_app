<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app AI support chat.

  Styling follows the app's existing AI chat exactly (item_ai_chat_ai.xml /
  item_ai_chat_user.xml) so this reads as the same product: Poppins, white
  toolbar with black_light text like Help & Support, accent #ff1383.

  Input area swaps by the server's input_mode: chips / text / yesno / none.
  The app never decides which — see SupportBotActivity.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- Same shared toolbar every other profile/help screen uses
         (layout_profile_flow_toolbar), so this cannot drift from them. -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:elevation="2dp"
        app:contentInsetLeft="0dp"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/include_profile_toolbar"
            layout="@layout/layout_profile_flow_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Conversation -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/input_area"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <!-- Input area: exactly one child is visible at a time -->
    <FrameLayout
        android:id="@+id/input_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- input_mode = text -->
        <LinearLayout
            android:id="@+id/ll_text_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_message"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:fontFamily="@font/poppins_regular"
                android:hint="@string/support_bot_type_hint"
                android:imeOptions="actionSend"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="4"
                android:minHeight="44dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/black_light"
                android:textColorHint="@color/text_light_grey"
                android:textSize="13sp" />

            <ImageView
                android:id="@+id/iv_send"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chat_send_btn"
                android:contentDescription="Send"
                android:padding="11dp"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />

        </LinearLayout>

        <!-- input_mode = yesno : the feedback CTA. The ONLY thing that can
             resolve a ticket is the positive button here. -->
        <LinearLayout
            android:id="@+id/ll_yesno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_feedback_prompt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/black_light"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_solved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bot_yes"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:paddingVertical="13dp"
                    android:text="@string/support_bot_yes_solved"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btn_not_solved"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_bot_no"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:paddingVertical="13dp"
                    android:text="@string/support_bot_still_need_help"
                    android:textColor="@color/black_light"
                    android:textSize="13sp" />

            </LinearLayout>

        </LinearLayout>


        <!-- Spec #9: rating, shown ONLY after the user confirms it's resolved.
             Asking before they confirm would be asking them to rate an answer
             they have not accepted. -->
        <LinearLayout
            android:id="@+id/ll_rating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="@string/support_bot_rate_prompt"
                android:textColor="@color/black_light"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_rate_sad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/support_bot_rate_sad"
                    android:textColor="@color/grey_medium"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btn_rate_neutral"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/support_bot_rate_neutral"
                    android:textColor="@color/grey_medium"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btn_rate_great"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:padding="6dp"
                    android:text="@string/support_bot_rate_great"
                    android:textColor="@color/grey_medium"
                    android:textSize="11sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- input_mode = none : terminal, escalated -->
        <TextView
            android:id="@+id/tv_view_ticket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="14dp"
            android:background="@drawable/bg_bot_yes"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:paddingVertical="13dp"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:visibility="gone" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
