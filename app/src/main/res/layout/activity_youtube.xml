<?xml version="1.0" encoding="utf-8"?>
<!-- 
    PROFESSIONAL GETTING STARTED UI DESIGN
    
    Design Features:
    - Modern dark gradient background with professional color scheme
    - Clean, minimalist layout with improved spacing
    - Professional typography with Poppins font
    - Elevated card design for video player
    - Improved visual hierarchy and contrast
    - Contemporary button styling with subtle animations
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_professional_gradient"
    tools:context=".activities.LoginActivity">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_left_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.06" />
    
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_right_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.94" />
    
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_top_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.08" />
    
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/gl_bottom_margin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.90" />

    <!-- Header Section -->
    <ImageView
        android:id="@+id/iv_logo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:contentDescription="@string/edit"
        android:scaleType="fitXY"
        android:src="@drawable/logo"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.035"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_default="percent"
        app:layout_constraintWidth_percent="0.09"
        app:tint="@color/white"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/tv_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:text="@string/app_name"
        android:textColor="@color/professional_text_primary"
        android:textSize="22sp"
        android:fontFamily="@font/poppins_medium"
        app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
        app:layout_constraintStart_toEndOf="@+id/iv_logo"
        app:layout_constraintTop_toTopOf="@+id/iv_logo" />

    <TextView
        android:id="@+id/tv_skip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/skip"
        android:textColor="@color/professional_text_secondary"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_medium"
        android:layout_marginEnd="20dp"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_logo" />

    <!-- Professional Video Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_video"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.55"
        android:layout_marginTop="20dp"
        app:cardElevation="16dp"
        app:cardCornerRadius="20dp"
        app:cardBackgroundColor="@color/professional_card_bg"
        app:layout_constraintEnd_toEndOf="@id/gl_right_margin"
        app:layout_constraintStart_toStartOf="@id/gl_left_margin"
        app:layout_constraintTop_toBottomOf="@+id/gl_top_margin">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/card_video_professional">

            <com.pierfrancescosoffritti.androidyoutubeplayer.core.player.views.YouTubePlayerView
                android:id="@+id/youtube_player_view"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="9:16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHeight_default="percent"
                app:layout_constraintHeight_percent="0.96"
                app:layout_constraintWidth_default="percent"
                app:layout_constraintWidth_percent="0.96" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- Content Section -->
    <TextView
        android:id="@+id/tl_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/getting_started"
        android:textColor="@color/professional_text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:fontFamily="@font/poppins_bold"
        android:layout_marginTop="28dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/gl_left_margin"
        app:layout_constraintEnd_toEndOf="@id/gl_right_margin"
        app:layout_constraintTop_toBottomOf="@+id/cv_video" />

    <TextView
        android:id="@+id/tl_title_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/getting_started_hint"
        android:textColor="@color/professional_text_secondary"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_regular"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="@id/gl_left_margin"
        app:layout_constraintEnd_toEndOf="@id/gl_right_margin"
        app:layout_constraintTop_toBottomOf="@+id/tl_title" />

    <!-- Professional CTA Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_complete"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:textAllCaps="false"
        app:layout_constraintTop_toTopOf="@+id/gl_bottom_margin"
        app:layout_constraintEnd_toEndOf="@id/gl_right_margin"
        android:fontFamily="@font/poppins_semibold"
        android:text="@string/complete"
        android:textSize="16sp"
        android:letterSpacing="0.02"
        app:cornerRadius="16dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        android:backgroundTint="@color/professional_accent"
        app:elevation="8dp"
        app:layout_constraintStart_toStartOf="@id/gl_left_margin"
        app:rippleColor="@color/professional_accent_light"
        android:stateListAnimator="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>
