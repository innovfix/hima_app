<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:background="#0D0D10"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Drifting "smoke" glows (animated in code) -->
    <View
        android:id="@+id/glow_tl"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_marginStart="-90dp"
        android:layout_marginTop="-90dp"
        android:background="@drawable/bg_call_glow_pink"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glow_br"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="-110dp"
        android:background="@drawable/bg_call_glow_purple"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Status Bar Padding -->
    <View
        android:id="@+id/status_bar_padding"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/poppins_semibold"
        android:text="Audio Session"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Connection Status -->
    <LinearLayout
        android:id="@+id/connection_status_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toBottomOf="@id/tv_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_connection_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting"
            android:fontFamily="@font/poppins_medium"
            android:textColor="#9A9AA6"
            android:textSize="13sp" />

        <!-- Animated Connecting Dots -->
        <LinearLayout
            android:id="@+id/ll_connecting_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="6dp"
            android:gravity="center">

            <View
                android:id="@+id/dot1"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/connecting_dot"
                android:alpha="1.0" />

            <View
                android:id="@+id/dot2"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/connecting_dot"
                android:alpha="0.5" />

            <View
                android:id="@+id/dot3"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/connecting_dot"
                android:alpha="0.3" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top User Avatar Container -->
    <FrameLayout
        android:id="@+id/fl_top_avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/connection_status_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Rotating gradient ring -->
        <View
            android:id="@+id/wave_ring_1"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/ring_call_gradient" />

        <!-- Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="55dp"
            app:cardElevation="4dp"
            app:strokeColor="#0D0D10"
            app:strokeWidth="4dp">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>

    <!-- Connection Line (subtle on dark) -->
    <View
        android:id="@+id/connection_line_bg"
        android:visibility="invisible"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_marginVertical="20dp"
        android:background="#1C1C22"
        app:layout_constraintTop_toBottomOf="@id/fl_top_avatar_container"
        app:layout_constraintBottom_toTopOf="@id/fl_bottom_avatar_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Ripples behind the arrows (animated in code) -->
    <View
        android:id="@+id/call_ripple_1"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:alpha="0"
        android:background="@drawable/ripple_ring_call"
        app:layout_constraintTop_toTopOf="@id/iv_double_arrow"
        app:layout_constraintBottom_toBottomOf="@id/iv_double_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/call_ripple_2"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:alpha="0"
        android:background="@drawable/ripple_ring_call"
        app:layout_constraintTop_toTopOf="@id/iv_double_arrow"
        app:layout_constraintBottom_toBottomOf="@id/iv_double_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <View
        android:id="@+id/call_ripple_3"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:alpha="0"
        android:background="@drawable/ripple_ring_call"
        app:layout_constraintTop_toTopOf="@id/iv_double_arrow"
        app:layout_constraintBottom_toBottomOf="@id/iv_double_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Animated Double Arrow Icon -->
    <ImageView
        android:id="@+id/iv_double_arrow"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/double_arrow_anim"
        android:alpha="0.95"
        app:layout_constraintTop_toTopOf="@id/connection_line_bg"
        app:layout_constraintBottom_toBottomOf="@id/connection_line_bg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hidden Circular Progress (kept for compatibility) -->
    <ProgressBar
        android:id="@+id/circular_progress"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Hidden Wave Rings (kept for compatibility) -->
    <View
        android:id="@+id/wave_ring_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/wave_ring_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Bottom User Avatar Container -->
    <FrameLayout
        android:id="@+id/fl_bottom_avatar_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/ll_info_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Subtle Pulse Ring -->
        <View
            android:id="@+id/pulse_ring"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/pulse_ring_pink"
            android:alpha="0.25" />

        <!-- Bottom Avatar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="55dp"
            app:cardElevation="4dp"
            app:strokeColor="#231A2E"
            app:strokeWidth="3dp">

            <ImageView
                android:id="@+id/iv_caller_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/logo" />
        </com.google.android.material.card.MaterialCardView>

        <!-- You Badge -->
        <TextView
            android:id="@+id/tv_you"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="-8dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="You"
            android:textColor="#3A1466"
            android:textSize="11sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_call_name_pill"
            android:elevation="2dp" />
    </FrameLayout>

    <!-- Info Container -->
    <LinearLayout
        android:id="@+id/ll_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="20dp"
        android:layout_marginHorizontal="32dp"
        app:layout_constraintBottom_toTopOf="@id/progress_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Connection Message -->
        <TextView
            android:id="@+id/tl_wait_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="Connecting with user..."
            android:textAlignment="center"
            android:textColor="#B8B8C2"
            android:textSize="14sp" />

        <!-- User Name (Initially Hidden) -->
        <TextView
            android:id="@+id/tv_caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Progress Container -->
    <LinearLayout
        android:id="@+id/progress_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="48dp"
        android:layout_marginBottom="20dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toTopOf="@id/tv_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Progress Text -->
        <TextView
            android:id="@+id/tv_progress_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connecting..."
            android:fontFamily="@font/poppins_medium"
            android:textColor="#8A8A99"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <!-- Modern Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:visibility="gone"
            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/progress_bar_background"
            android:indeterminate="false"
            android:max="100"
            android:progress="10"
            android:progressDrawable="@drawable/curved_progress_bar" />

        <!-- Timer Text - Hidden by default -->
        <TextView
            android:id="@+id/tv_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#8A8A99"
            android:textSize="10sp"
            android:text="00:00"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Cancel Button -->
    <TextView
        android:id="@+id/tv_cancel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Cancel"
        android:gravity="center"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:background="@drawable/bg_call_cancel"
        android:paddingHorizontal="24dp"
        android:paddingVertical="18dp"
        android:layout_marginHorizontal="22dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Hidden FrameLayout for compatibility -->
    <FrameLayout
        android:id="@+id/fl_connection_animation"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
