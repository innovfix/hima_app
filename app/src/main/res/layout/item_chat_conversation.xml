<?xml version="1.0" encoding="utf-8"?>
<!-- Chat list row. Buttons are styled in code by ChatListAdapter.bind():
     online => tinted circle (pink call / purple video) + coin/rate (male) or
     "Online" (female), offline => grey circle + "Offline". IDs preserved. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:rippleColor="@color/light_grey">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- Top row: date (left) + pin + bell (right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_medium"
                android:maxLines="1"
                android:text="2m"
                android:textColor="@color/grey_medium"
                android:textSize="11sp"
                tools:text="May 15" />

            <ImageView
                android:id="@+id/iv_pin"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/chat_pin_action"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_pin_outline"
                app:tint="@color/chat_list_bell_inactive" />

            <ImageView
                android:id="@+id/iv_notify_bell"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/notify_bell_default_desc"
                android:focusable="true"
                android:padding="6dp"
                android:src="@drawable/ic_notifications_off"
                app:tint="@color/chat_list_bell_inactive" />
        </LinearLayout>

        <!-- Main row: avatar | name+message | call buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatar + online dot -->
            <FrameLayout
                android:id="@+id/fl_image_container"
                android:layout_width="54dp"
                android:layout_height="54dp">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_user_image"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:src="@drawable/small_profile"
                    app:civ_border_color="@color/grey_extra_light"
                    app:civ_border_width="2dp"
                    tools:src="@drawable/small_profile" />

                <View
                    android:id="@+id/v_online_indicator"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="1dp"
                    android:layout_marginBottom="1dp"
                    android:background="@drawable/circle_bg_green"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <!-- Name + message -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:text="User Name"
                    android:textColor="@color/black_light"
                    android:textSize="16sp"
                    tools:text="Jacob" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_last_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_regular"
                        android:maxLines="1"
                        android:text="Last message preview..."
                        android:textColor="@color/grey_medium"
                        android:textSize="13sp"
                        tools:text="Hi" />

                    <TextView
                        android:id="@+id/tv_unread_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/circle_bg_red"
                        android:fontFamily="@font/poppins_bold"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:minWidth="18dp"
                        android:minHeight="18dp"
                        android:paddingHorizontal="5dp"
                        android:text="3"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:visibility="gone"
                        tools:text="5"
                        tools:visibility="visible" />
                </LinearLayout>
            </LinearLayout>

            <!-- Call buttons (aligned with avatar) -->
            <LinearLayout
                android:id="@+id/call_buttons_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Audio column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:minWidth="52dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btn_audio_call"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_bg_grey"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/iv_audio_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/grey_medium" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_audio_coin"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginEnd="3dp"
                            android:contentDescription="@null"
                            android:src="@drawable/coin_d"
                            android:visibility="gone"
                            tools:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_audio_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="Offline"
                            android:textColor="@color/grey_medium"
                            android:textSize="10sp"
                            tools:text="Offline" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Video column -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:gravity="center_horizontal"
                    android:minWidth="52dp"
                    android:orientation="vertical">

                    <FrameLayout
                        android:id="@+id/btn_video_call"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_bg_grey"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/iv_video_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_video_modern"
                            app:tint="@color/grey_medium" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_video_coin"
                            android:layout_width="11dp"
                            android:layout_height="11dp"
                            android:layout_marginEnd="3dp"
                            android:contentDescription="@null"
                            android:src="@drawable/coin_d"
                            android:visibility="gone"
                            tools:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_video_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="Offline"
                            android:textColor="@color/grey_medium"
                            android:textSize="10sp"
                            tools:text="Offline" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Blocked badge — shown in place of call buttons -->
                <TextView
                    android:id="@+id/tv_blocked_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/chat_blocked_indicator"
                    android:textColor="#B91C1C"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
