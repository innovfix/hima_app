<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white"
    app:rippleColor="@color/light_grey"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <!-- Card background highlight overlay — hidden in white theme. -->
    <View
        android:id="@+id/v_card_top_highlight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- User Image — below the top row (time + pin/bell). -->
        <FrameLayout
            android:id="@+id/fl_image_container"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_notify_bell">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_user_image"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/small_profile"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/grey_extra_light"
                tools:src="@drawable/small_profile" />

            <!-- Online Indicator -->
            <View
                android:id="@+id/v_online_indicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/circle_bg_green"
                android:visibility="gone" />
        </FrameLayout>

        <!-- User Name — top-aligned with avatar, packed chain with last_message below. -->
        <TextView
            android:id="@+id/tv_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/poppins_semibold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="User Name"
            android:textColor="@color/black_light"
            android:textSize="16sp"
            app:layout_constraintBottom_toTopOf="@id/tv_last_message"
            app:layout_constraintEnd_toStartOf="@id/call_buttons_row"
            app:layout_constraintStart_toEndOf="@id/fl_image_container"
            app:layout_constraintTop_toTopOf="@id/fl_image_container"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Sarah Johnson" />

        <!-- Pin chat — modern compact icon to the left of bell. -->
        <ImageView
            android:id="@+id/iv_pin"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/chat_pin_action"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_pin_outline"
            app:layout_constraintBottom_toBottomOf="@id/iv_notify_bell"
            app:layout_constraintEnd_toStartOf="@id/iv_notify_bell"
            app:layout_constraintTop_toTopOf="@id/iv_notify_bell"
            app:tint="@color/chat_list_bell_inactive" />

        <!-- Last Message — 8dp directly below the user name. -->
        <TextView
            android:id="@+id/tv_last_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:fontFamily="@font/poppins_regular"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Last message preview..."
            android:textColor="@color/grey_medium"
            android:textSize="13sp"
            app:layout_constraintBottom_toBottomOf="@id/fl_image_container"
            app:layout_constraintEnd_toStartOf="@id/call_buttons_row"
            app:layout_constraintStart_toEndOf="@id/fl_image_container"
            app:layout_constraintTop_toBottomOf="@id/tv_user_name"
            tools:text="Hey! How are you doing today?" />

        <!-- Unread Count Badge — inline with the time, to its left, so it never
             collides with the call buttons row below. -->
        <TextView
            android:id="@+id/tv_unread_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="18dp"
            android:minHeight="18dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/circle_bg_red"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:paddingHorizontal="5dp"
            android:text="3"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/tv_time"
            app:layout_constraintEnd_toStartOf="@id/tv_time"
            app:layout_constraintTop_toTopOf="@id/tv_time"
            tools:text="5"
            tools:visibility="visible" />

        <!-- Notify bell — modern compact icon at top-right. End-aligned to parent
             (sits at the card's right padding edge — symmetric with the date on left). -->
        <ImageView
            android:id="@+id/iv_notify_bell"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/notify_bell_default_desc"
            android:focusable="true"
            android:padding="6dp"
            android:src="@drawable/ic_notifications_off"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/chat_list_bell_inactive" />

        <!-- Time — TOP-LEFT corner. Vertically centered with the bell so they sit
             on the same line. Start edge aligned to card padding (= 14dp from card
             edge), matching the bell's right edge alignment. -->
        <TextView
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:maxLines="1"
            android:text="2m"
            android:textColor="@color/grey_medium"
            android:textSize="11sp"
            app:layout_constraintBottom_toBottomOf="@id/iv_notify_bell"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_notify_bell"
            tools:text="Just now" />

        <!-- NEW indicator — hidden; not used in chat tab. -->
        <TextView
            android:id="@+id/tv_new_chat"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            android:text="NEW" />

        <!-- Audio & Video Call Buttons — same row as avatar+name, vertically centered. -->
        <LinearLayout
            android:id="@+id/call_buttons_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/fl_image_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/fl_image_container">

            <!-- Audio column: white CardView with pink elevation + pink phone icon. -->
            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_audio_call"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginVertical="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:outlineAmbientShadowColor="#E91E63"
                    android:outlineSpotShadowColor="#E91E63"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_audio_icon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/audio"
                        app:tint="#E91E63" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_audio_coin"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/coin_d" />

                    <TextView
                        android:id="@+id/tv_audio_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="10/min"
                        android:textColor="@color/black_light"
                        android:textSize="11sp"
                        tools:text="10/min" />
                </LinearLayout>
            </LinearLayout>

            <!-- Video column: white CardView with purple elevation + purple video icon. -->
            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_video_call"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginVertical="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:outlineAmbientShadowColor="#9C27B0"
                    android:outlineSpotShadowColor="#9C27B0"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_video_icon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/video"
                        app:tint="#9C27B0" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_video_coin"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:contentDescription="@null"
                        android:src="@drawable/coin_d" />

                    <TextView
                        android:id="@+id/tv_video_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="60/min"
                        android:textColor="@color/black_light"
                        android:textSize="11sp"
                        tools:text="60/min" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>

