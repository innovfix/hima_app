<?xml version="1.0" encoding="utf-8"?>
<!-- My Warnings — themed to match home/earnings: grey bg, white sticky
     header, white cards with badge headers. All IDs preserved. -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_extra_light">

    <!-- ══ White sticky header ══ -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:fitsSystemWindows="true"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_back"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="6dp"
            app:cardBackgroundColor="@color/grey_extra_light"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Back"
                android:rotation="180"
                android:src="@drawable/right_arrow"
                app:tint="@color/black_light" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@+id/cv_back"
            app:layout_constraintStart_toEndOf="@+id/cv_back"
            app:layout_constraintTop_toTopOf="@+id/cv_back">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:letterSpacing="-0.01"
                android:text="My Warnings"
                android:textColor="@color/black_light"
                android:textSize="19sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Your account warning status"
                android:textColor="@color/grey_medium"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- History/more button (top-right) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_more_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/grey_extra_light"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/cv_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cv_back">

            <ImageView
                android:id="@+id/iv_more"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="History"
                android:src="@drawable/baseline_more_vert_24"
                app:tint="@color/black_light" />
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ══ Scrollable content ══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="110dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:layout_marginTop="80dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorAccent"
                android:visibility="gone" />

            <!-- ══ HERO STATUS CARD — big green tick, level, summary ══ -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="1dp"
                app:strokeColor="#E9EDF2"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="28dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <!-- Big circular status icon (pink tick — brand themed) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        app:cardBackgroundColor="#FFF0F7"
                        app:cardCornerRadius="42dp"
                        app:cardElevation="0dp"
                        app:strokeColor="#FBCFE8"
                        app:strokeWidth="2dp">

                        <ImageView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:contentDescription="Status"
                            android:src="@drawable/baseline_check_24"
                            app:tint="@color/colorAccent" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- "All Good" headline -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="-0.01"
                        android:text="All Good"
                        android:textColor="@color/black_light"
                        android:textSize="22sp" />

                    <!-- Current level pill (API-driven text — pink brand) -->
                    <TextView
                        android:id="@+id/tv_current_level"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/d_button_bg"
                        android:backgroundTint="#FFF0F7"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text=""
                        android:textAllCaps="true"
                        android:textColor="@color/colorAccent"
                        android:textSize="11sp"
                        tools:text="CURRENT LEVEL : GOOD STANDING" />

                    <!-- Hidden — kept for binding compatibility -->
                    <TextView
                        android:id="@+id/tv_current_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="16sp"
                        android:visibility="gone"
                        tools:text="Level 2: Strict Warning" />

                    <TextView
                        android:id="@+id/tv_total_warnings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:text=""
                        android:textColor="@color/grey_medium"
                        android:textSize="13sp"
                        android:visibility="gone" />

                    <!-- Full-width divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="20dp"
                        android:background="@color/grey_extra_light" />

                    <!-- Details list (no background, clean inside the card) -->
                    <TextView
                        android:id="@+id/tv_current_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="start"
                        android:lineSpacingExtra="6dp"
                        android:text=""
                        android:textColor="@color/black_light"
                        android:textSize="13sp"
                        tools:text="You can take calls normally.\nNo restrictions.\nFull earnings enabled." />

                    <!-- View History link (right-aligned) -->
                    <TextView
                        android:id="@+id/tv_history_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_marginTop="16dp"
                        android:drawableEnd="@drawable/ic_chevron_right"
                        android:drawablePadding="4dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="View Warning History"
                        android:textColor="@color/colorAccent"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:drawableTint="@color/colorAccent" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Optional warning system image card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_warning_system_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="18dp"
                app:cardElevation="1dp"
                app:strokeColor="#E9EDF2"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/iv_warning_system_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@android:color/transparent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Info note card (community guidelines reminder — pink themed) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FFF0F7"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="#FBCFE8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info_outline"
                        app:tint="@color/colorAccent" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="2dp"
                        android:text="Repeated violations may lead to account suspension. Please follow our community guidelines."
                        android:textColor="#9D215C"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ══ Empty state ══ -->
            <LinearLayout
                android:id="@+id/ll_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="40dp"
                android:paddingTop="60dp"
                android:paddingEnd="40dp"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardBackgroundColor="#F0FDF4"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_check_24"
                        app:tint="#16A34A" />
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text=""
                    android:textColor="@color/black_light"
                    android:textSize="20sp"
                    tools:text="No Warnings!" />

                <TextView
                    android:id="@+id/tv_empty_subtitle"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text=""
                    android:textColor="@color/grey_medium"
                    android:textSize="14sp"
                    tools:text="You have no warnings from admins. Keep up the great work!" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="#F0FDF4"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#BBF7D0"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:text="Account in Good Standing ✓"
                        android:textColor="#15803D"
                        android:textSize="12sp" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Hidden RecyclerView (kept for binding compatibility) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_warnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
