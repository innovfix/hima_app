<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8">

    <!-- ===== GRADIENT HEADER ===== -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_warning_header_pink"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="28dp"
        android:elevation="6dp">

        <!-- Back + More row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Back"
                    android:src="@drawable/right_arrow"
                    android:rotation="180"
                    app:tint="@color/white" />

            </androidx.cardview.widget.CardView>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- More / History Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_more_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:visibility="gone"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#33FFFFFF">

                <ImageView
                    android:id="@+id/iv_more"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="History"
                    android:src="@drawable/baseline_more_vert_24"
                    app:tint="@color/white" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Title & Subtitle -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="My Warnings"
            android:textColor="@color/white"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Your account warning status"
            android:textColor="#DDFFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

    <!-- ===== SCROLLABLE CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:layout_marginTop="160dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="80dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorAccent"
                android:visibility="gone" />

            <!-- ===== CURRENT WARNING SUMMARY CARD ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="#F3F4F6"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- ── Gradient top band ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_warning_header_pink"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp">

                        <!-- Large warning icon -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#33FFFFFF">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_warning"
                                app:tint="@color/white" />

                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="CURRENT WARNING"
                                android:textColor="#DDFFFFFF"
                                android:textSize="11sp"
                                android:letterSpacing="0.08"
                                android:visibility="gone" />

                            <!-- Level badge – set by code -->
                            <TextView
                                android:id="@+id/tv_current_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_warning_badge_white"
                                android:fontFamily="@font/poppins_semibold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:text=""
                                android:textAllCaps="true"
                                android:textColor="#BE185D"
                                android:textSize="11sp"
                                tools:text="STRICT WARNING" />

                        </LinearLayout>

                    </LinearLayout>

                    <!-- ── White content section ── -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:paddingTop="16dp"
                        android:paddingBottom="20dp">

                        <!-- Hidden title (kept for code compatibility) -->
                        <TextView
                            android:id="@+id/tv_current_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:text=""
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:visibility="gone"
                            tools:text="Level 2: Strict Warning" />

                        <!-- Hidden count (kept for code compatibility) -->
                        <TextView
                            android:id="@+id/tv_total_warnings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:text=""
                            android:textColor="#6B7280"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <!-- Details styled note box -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:cardBackgroundColor="#FFF1F7"
                            app:strokeColor="#F9A8D4"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <!-- Left accent line -->
                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_warning_left_accent_pink"
                                    android:layout_marginEnd="12dp" />

                                <TextView
                                    android:id="@+id/tv_current_details"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/poppins_regular"
                                    android:lineSpacingExtra="4dp"
                                    android:text=""
                                    android:textColor="#9D174D"
                                    android:textSize="13sp"
                                    android:visibility="visible"
                                    tools:text="If issues continue:\n- You will be blocked from taking calls for 1 hours\n- Your activity will be reviewed" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                        <!-- View History hint (only visible when history exists, handled by ivMore visibility) -->
                        <TextView
                            android:id="@+id/tv_history_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="14dp"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            android:drawablePadding="4dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="View Warning History"
                            android:textColor="#EC4899"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:drawableTint="#EC4899" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_warning_system_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#FBCFE8"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/iv_warning_system_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@android:color/transparent" />

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== GOOD STANDING INFO (visible when summary shown) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#FDF2F8"
                app:strokeColor="#FBCFE8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info_outline"
                        app:tint="#DB2777" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="2dp"
                        android:text="Repeated violations may lead to account suspension. Please follow our community guidelines."
                        android:textColor="#9D174D"
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- ===== EMPTY STATE ===== -->
            <LinearLayout
                android:id="@+id/ll_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="60dp"
                android:paddingBottom="40dp"
                android:paddingStart="40dp"
                android:paddingEnd="40dp"
                android:visibility="gone">

                <!-- Green circle icon -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    app:cardCornerRadius="50dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0FDF4">

                    <ImageView
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_gravity="center"
                        android:src="@drawable/baseline_check_24"
                        app:tint="#16A34A" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tv_empty_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:text=""
                    android:textColor="#1F2937"
                    android:textSize="20sp"
                    tools:text="No Warnings!" />

                <TextView
                    android:id="@+id/tv_empty_subtitle"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text=""
                    android:textColor="#6B7280"
                    android:textSize="14sp"
                    tools:text="You have no warnings from admins. Keep up the great work!" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F0FDF4"
                    app:strokeColor="#BBF7D0"
                    app:strokeWidth="1dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="8dp"
                        android:fontFamily="@font/poppins_medium"
                        android:text="Account in Good Standing ✓"
                        android:textColor="#15803D"
                        android:textSize="12sp" />

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Hidden RecyclerView (kept for code compatibility) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_warnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
