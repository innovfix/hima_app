<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6F8"
    android:orientation="vertical">

    <!-- ===== LIGHT HEADER ===== -->
    <LinearLayout
        android:id="@+id/header_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="2dp"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="14dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <!-- Back Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/onboarding_back_btn_bg"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Back"
                android:rotation="180"
                android:src="@drawable/right_arrow"
                app:tint="@color/onboarding_title" />
        </androidx.cardview.widget.CardView>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="My Warnings"
                android:textColor="@color/onboarding_title"
                android:textSize="22sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:text="Your account warning status"
                android:textColor="@color/grey_medium"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- More / History Button -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_more_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/onboarding_back_btn_bg"
            app:cardCornerRadius="13dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_more"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="History"
                android:src="@drawable/baseline_more_vert_24"
                app:tint="@color/onboarding_title" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- ===== SCROLLABLE CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:layout_marginTop="80dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/colorAccent"
                android:visibility="gone" />

            <!-- ===== CURRENT WARNING SUMMARY CARD (has-warning state) ===== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="2dp"
                app:strokeColor="#F3F4F6"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_warning_header_pink"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingTop="18dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="18dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardBackgroundColor="#33FFFFFF"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp">

                            <ImageView
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_warning"
                                app:tint="@color/white" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:letterSpacing="0.08"
                                android:text="CURRENT WARNING"
                                android:textColor="#DDFFFFFF"
                                android:textSize="11sp"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_current_level"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:background="@drawable/bg_warning_badge_white"
                                android:fontFamily="@font/poppins_semibold"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                android:textAllCaps="true"
                                android:textColor="#BE185D"
                                android:textSize="11sp"
                                tools:text="STRICT WARNING" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="20dp"
                        android:paddingTop="16dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="20dp">

                        <TextView
                            android:id="@+id/tv_current_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_semibold"
                            android:textColor="#1F2937"
                            android:textSize="16sp"
                            android:visibility="gone"
                            tools:text="Level 2: Strict Warning" />

                        <TextView
                            android:id="@+id/tv_total_warnings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="#6B7280"
                            android:textSize="13sp"
                            android:visibility="gone" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#FFF1F7"
                            app:cardCornerRadius="12dp"
                            app:cardElevation="0dp"
                            app:strokeColor="#F9A8D4"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="14dp">

                                <View
                                    android:layout_width="4dp"
                                    android:layout_height="match_parent"
                                    android:layout_marginEnd="12dp"
                                    android:background="@drawable/bg_warning_left_accent_pink" />

                                <TextView
                                    android:id="@+id/tv_current_details"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/poppins_regular"
                                    android:lineSpacingExtra="4dp"
                                    android:textColor="#9D174D"
                                    android:textSize="13sp"
                                    tools:text="If issues continue:\n- You will be blocked from taking calls" />
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tv_history_hint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="end"
                            android:layout_marginTop="14dp"
                            android:drawableEnd="@drawable/ic_chevron_right"
                            android:drawablePadding="4dp"
                            android:fontFamily="@font/poppins_medium"
                            android:text="View Warning History"
                            android:textColor="#EC4899"
                            android:textSize="12sp"
                            android:visibility="gone"
                            app:drawableTint="#EC4899" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_warning_system_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#FBCFE8"
                app:strokeWidth="1dp">

                <ImageView
                    android:id="@+id/iv_warning_system_image"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:scaleType="fitCenter"
                    android:src="@android:color/transparent"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Pink note (has-warning state) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_info_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="14dp"
                android:visibility="gone"
                app:cardBackgroundColor="#FDF2F8"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="#FBCFE8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_info_outline"
                        app:tint="#DB2777"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_regular"
                        android:lineSpacingExtra="2dp"
                        android:text="Repeated violations may lead to account suspension. Please follow our community guidelines."
                        android:textColor="#9D174D"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== GOOD STANDING STATE ("All Good") ===== -->
            <LinearLayout
                android:id="@+id/ll_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- All Good card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#F1F2F5"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="22dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="24dp">

                        <!-- Pink check circle (self-drawing checkmark AVD) -->
                        <ImageView
                            android:id="@+id/iv_empty_check"
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_gravity="center_horizontal"
                            android:background="@drawable/circle_bg_pink_light"
                            android:padding="24dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/avd_check_draw"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_empty_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="18dp"
                            android:fontFamily="@font/poppins_bold"
                            android:text="All Good"
                            android:textColor="@color/onboarding_title"
                            android:textSize="24sp"
                            tools:ignore="HardcodedText" />

                        <!-- CURRENT LEVEL pill -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_pill_pink_light"
                            android:fontFamily="@font/poppins_semibold"
                            android:paddingHorizontal="18dp"
                            android:paddingVertical="7dp"
                            android:text="CURRENT LEVEL : GOOD STANDING"
                            android:textColor="@color/colorAccent"
                            android:textSize="11sp"
                            tools:ignore="HardcodedText" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="22dp"
                            android:background="#F0F0F0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="You can take calls normally."
                            android:textColor="@color/grey_medium"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="No restrictions."
                            android:textColor="@color/grey_medium"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:fontFamily="@font/poppins_regular"
                            android:text="Full earnings enabled."
                            android:textColor="@color/grey_medium"
                            android:textSize="14sp"
                            tools:ignore="HardcodedText" />

                        <!-- kept for code compatibility (activity may set it) -->
                        <TextView
                            android:id="@+id/tv_empty_subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_regular"
                            android:textColor="@color/grey_medium"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Pink note (good-standing) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginTop="14dp"
                    app:cardBackgroundColor="#FDF2F8"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#FBCFE8"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:background="@drawable/circle_bg_accent"
                            android:gravity="center"
                            android:text="!"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:fontFamily="@font/poppins_regular"
                            android:lineSpacingExtra="2dp"
                            android:text="Repeated violations may lead to account suspension. Please follow our community guidelines."
                            android:textColor="#9D174D"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_warnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
