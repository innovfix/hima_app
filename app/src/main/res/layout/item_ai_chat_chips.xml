<?xml version="1.0" encoding="utf-8"?>
<!--
  Server-driven option chips rendered under a bot message.
  Flexbox so long labels ("Coins cut but call did not connect") wrap instead
  of truncating. Padding matches item_ai_chat_ai.xml so chips line up with the
  bubble above them.
-->
<com.google.android.flexbox.FlexboxLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chips_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="14dp"
    android:paddingTop="2dp"
    android:paddingBottom="6dp"
    app:alignItems="flex_start"
    app:flexWrap="wrap"
    app:justifyContent="flex_start" />
