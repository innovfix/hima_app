<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grey_extra_light">

    <!-- Header: "Messages / Friends & community" -->
    <LinearLayout
        android:id="@+id/chat_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="42dp"
            android:layout_height="42dp"
            app:cardBackgroundColor="@color/colorAccent"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_chat_bubble"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:letterSpacing="-0.02"
                android:text="@string/chat_list_title"
                android:textColor="@color/black_light"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="Friends &amp; community"
                android:textColor="@color/grey_medium"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Spacer pushes the decorative cluster to the far end -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Decorative hearts + sparkles cluster (top-right) — mirrors male Friends hub -->
        <FrameLayout
            android:layout_width="124dp"
            android:layout_height="80dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="8dp"
                android:alpha="0.95"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FF5E9F" />

            <ImageView
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="22dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FF6FAB" />

            <ImageView
                android:layout_width="15dp"
                android:layout_height="15dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="34dp"
                android:alpha="0.85"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FF85B8" />

            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="46dp"
                android:alpha="0.9"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_outline"
                app:tint="#FF85B8" />

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="46dp"
                android:layout_marginEnd="28dp"
                android:alpha="0.8"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FF85B8" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="64dp"
                android:alpha="0.75"
                android:contentDescription="@null"
                android:src="@drawable/ic_heart_filled"
                app:tint="#FFA0C6" />

            <ImageView
                android:layout_width="11dp"
                android:layout_height="11dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="14dp"
                android:layout_marginEnd="78dp"
                android:alpha="0.8"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                app:tint="#FFB3D4" />

            <ImageView
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="42dp"
                android:layout_marginEnd="92dp"
                android:alpha="0.65"
                android:contentDescription="@null"
                android:src="@drawable/ic_sparkle"
                app:tint="#FFB3D4" />
        </FrameLayout>
    </LinearLayout>

    <!-- Friends-Gated Chat: segmented-pill tabs (Variant B) — Friends | Requests | Sent -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabs_creator_chat"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_segmented_tabs"
        android:padding="3dp"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/chat_header"
        app:tabGravity="fill"
        app:tabMode="fixed"
        app:tabIndicator="@drawable/bg_tab_pill_selected"
        app:tabIndicatorColor="@color/colorAccent"
        app:tabIndicatorFullWidth="true"
        app:tabIndicatorGravity="stretch"
        app:tabMinWidth="0dp"
        app:tabPaddingStart="4dp"
        app:tabPaddingEnd="4dp"
        app:tabRippleColor="@null"
        app:tabSelectedTextColor="@color/white"
        app:tabTextAppearance="@style/CreatorChatTabText"
        app:tabTextColor="#6B7280" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_creator_chat"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabs_creator_chat" />

</androidx.constraintlayout.widget.ConstraintLayout>
