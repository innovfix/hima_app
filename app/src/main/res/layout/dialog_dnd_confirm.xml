<?xml version="1.0" encoding="utf-8"?>
<!-- B16 — DND confirm card (replaces the plain system AlertDialog). Shown when a
     creator enables DND while still available: turning it on switches her Audio &
     Video availability off, then enables DND. Matches B16_DND_CONFIRM_CARD mockup. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dnd_dialog"
    android:paddingHorizontal="20dp"
    android:paddingTop="22dp"
    android:paddingBottom="18dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_dnd_confirm_icon">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_notifications_off"
            app:tint="@color/pink" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:text="@string/dnd_confirm_title"
        android:textColor="#1C1B22"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="4dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:lineSpacingMultiplier="1.25"
        android:text="@string/dnd_confirm_body"
        android:textColor="#6B7280"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:text="@string/dnd_confirm_warning"
        android:textColor="@color/pink"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dnd_confirm_cancel"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:text="@string/dnd_confirm_cancel"
            android:textAllCaps="false"
            android:textColor="#1C1B22"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
            app:backgroundTint="#F2EFF4"
            app:cornerRadius="12dp"
            app:elevation="0dp"
            app:rippleColor="#22000000" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dnd_confirm_positive"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:text="@string/dnd_confirm_positive"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
            app:backgroundTint="@color/pink"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
