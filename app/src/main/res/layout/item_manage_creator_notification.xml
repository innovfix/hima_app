<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_creator_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/small_profile"
                tools:src="@drawable/small_profile" />

            <View
                android:id="@+id/v_online_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="end|bottom"
                android:background="@drawable/bg_online_dot"
                android:contentDescription="@string/online_now_desc"
                android:visibility="gone"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/iv_action_bell"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/circle_bg_accent"
                android:contentDescription="@null"
                android:padding="4dp"
                android:src="@drawable/ic_notifications_active"
                android:visibility="gone"
                app:tint="@color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_creator_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/black_light"
                android:textSize="14sp"
                tools:text="Creator name" />

            <TextView
                android:id="@+id/tv_trigger_reason"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/grey_medium"
                android:textSize="11sp"
                tools:text="@string/notify_bell_default_desc" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="8dp">

            <ImageView
                android:id="@+id/iv_action_check"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_notify_check_circle"
                android:contentDescription="@null"
                android:padding="6dp"
                android:scaleX="0"
                android:scaleY="0"
                android:src="@drawable/ic_check"
                android:visibility="gone"
                app:tint="@color/white" />
        </FrameLayout>

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_creator_notify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:thumbTint="@color/switch_thumb_color_selector"
            app:trackTint="@color/switch_track_color_selector" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
