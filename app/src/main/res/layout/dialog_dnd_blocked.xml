<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dnd_dialog"
    android:padding="24dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center_horizontal"
        android:contentDescription="@null"
        android:src="@drawable/ic_notifications_off"
        app:tint="#E11D48" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dnd_blocked_title"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:layout_marginTop="14dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/dnd_blocked_body"
        android:textColor="#6B7280"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:layout_marginTop="6dp"
        android:layout_marginHorizontal="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dnd_blocked_cta"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/dnd_blocked_cta"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/white"
            app:backgroundTint="@color/pink"
            app:cornerRadius="14dp" />

        <ProgressBar
            android:id="@+id/pb_dnd_blocked"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:visibility="gone" android:indeterminateDrawable="@drawable/heart_loader_white" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_dnd_blocked_cancel"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:text="@string/dnd_blocked_cancel"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:fontFamily="@font/poppins_semibold"
        android:textColor="#6B7280" />

</LinearLayout>
