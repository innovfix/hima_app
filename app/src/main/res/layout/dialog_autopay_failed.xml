<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_autopay_failed_dialog"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="32dp"
    android:paddingBottom="28dp">

    <!-- Pink icon circle -->
    <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_daily_coins_coin"
        android:backgroundTint="#FFE6F3">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_lock_closed"
            app:tint="@color/colorAccent" />
    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvAutopayFailedTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/poppins_bold"
        android:text="Autopay Failed"
        android:textColor="#1A1A1A"
        android:textSize="20sp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvAutopayFailedSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="Your autopay was cancelled or payment failed.\nChat sending has been blocked."
        android:textColor="#666666"
        android:textSize="13sp" />

    <!-- Info note -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_daily_bonus_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/coin_d" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_regular"
            android:text="Your coin balance is safe — still usable for calls."
            android:textColor="@color/colorAccent"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Primary CTA -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBuyCoins"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_autopay_failed_button"
        android:backgroundTint="@null"
        android:fontFamily="@font/poppins_semibold"
        android:text="Buy Coins for Calls"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="15sp"
        app:cornerRadius="26dp"
        app:elevation="0dp" />

    <!-- Dismiss -->
    <TextView
        android:id="@+id/tvDismiss"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/poppins_regular"
        android:padding="6dp"
        android:text="Dismiss"
        android:textColor="#9CA3AF"
        android:textSize="13sp" />

</LinearLayout>
