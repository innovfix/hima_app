<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/white"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Icon -->
            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/baseline_close_24"
                android:tint="@color/white"
                android:scaleType="centerInside"
                android:padding="14dp"
                android:background="@drawable/circle_bg_primary_flat"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Block icon" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Block User?"
                android:textSize="20sp"
                android:textColor="#1F2937"
                android:fontFamily="@font/poppins_semibold"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Message -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Once you block this user, you won't be able to send or receive messages from them. You can unblock them anytime."
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:layout_marginBottom="16dp"
                android:lineSpacingExtra="2dp" />

            <!-- B099 follow-up — WhatsApp-style "also delete chat" option.
                 When ticked, the existing chat-block call still fires AND the
                 local chat list for this peer is cleared so the user doesn't
                 keep seeing the conversation history on this device.

                 Creator QA bug #5 — marginBottom was 20dp against the divider's 16dp
                 below it, so the rule sat off-centre in its own gap and the block read
                 as lopsided. 16dp both sides now, matching the message spacing above.
                 The button row also carried android:spacing="12dp"; LinearLayout has no
                 such attribute, so it was silently ignored — removed. The real gap comes
                 from btn_cancel's end margin, which is now marginEnd (RTL-correct) rather
                 than marginRight. -->
            <CheckBox
                android:id="@+id/cb_also_delete_chat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Also delete chat for me"
                android:textSize="13sp"
                android:textColor="#374151"
                android:fontFamily="@font/poppins_regular"
                android:layout_gravity="start"
                android:layout_marginBottom="16dp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E5E7EB"
                android:layout_marginBottom="16dp" />

            <!-- Buttons Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <!-- BUG 16 — these were bespoke r25 pills. Now on the canonical
                     Widget.Hima.Button.Secondary / .Primary pair (r12), so this dialog and
                     the Delete Account CTA agree. The dead dialog_block_confirmation.xml,
                     which asked the same question at r12 in red #F44336, was deleted rather
                     than restyled — it had zero references. -->
                <!-- Cancel Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.Hima.Button.Secondary"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Cancel"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:textColor="#6B7280"
                    app:strokeColor="#D1D5DB"
                    app:strokeWidth="1.5dp"
                    app:rippleColor="#F3F4F6" />

                <!-- Block Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_block"
                    style="@style/Widget.Hima.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Block"
                    android:stateListAnimator="@null"
                    android:minHeight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>























