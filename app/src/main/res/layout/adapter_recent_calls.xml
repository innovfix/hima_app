<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:rippleColor="@color/light_grey"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="14dp">

        <!-- Date Section (Hidden) -->
        <TextView
            android:id="@+id/callDate"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:fontFamily="@font/poppins_medium"
            android:text="Date"
            android:textColor="@color/grey_medium"
            android:textSize="11sp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/ll_date"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Profile Image — matches Home: 58dp circle with light-pink border. -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/profile_container"
            android:layout_width="58dp"
            android:layout_height="58dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_profile"
                android:layout_width="58dp"
                android:layout_height="58dp"
                app:cardCornerRadius="29dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:strokeWidth="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/iv_image"
                    android:layout_width="58dp"
                    android:layout_height="58dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/coin"
                    app:civ_border_color="#FFE5F1"
                    app:civ_border_width="2dp"
                    tools:ignore="ContentDescription" />
            </com.google.android.material.card.MaterialCardView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- User Info — Name, Date, Duration stacked vertically and evenly spaced. -->
        <LinearLayout
            android:id="@+id/ll_user_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/profile_container"
            app:layout_constraintEnd_toStartOf="@+id/buttons_container"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/profile_container"
            app:layout_constraintTop_toTopOf="@id/profile_container"
            app:layout_constraintVertical_bias="0.5">

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:maxLines="1"
                android:text="Username"
                android:textColor="@color/black_light"
                android:textSize="16sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/grey_extra_light"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <TextView
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_medium"
                        android:maxLines="1"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:text="Today 08:16 PM"
                        android:textColor="@color/grey_medium"
                        android:textSize="10sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_chat_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFE9F2"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="1dp"
                    app:rippleColor="#1AE91E63"
                    app:strokeColor="#E91E63"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_chat_bubble"
                            app:tint="#E91E63" />

                        <TextView
                            android:id="@+id/tv_chat_now"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="@string/chat_now"
                            android:textColor="#E91E63"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Duration row — clock icon + seconds text, evenly below the date. -->
            <LinearLayout
                android:id="@+id/ll_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Duration"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_clock"
                    app:tint="@color/colorAccent" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="1 min"
                    android:textColor="@color/colorAccent"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Side Container - Audio + Video columns matching Home design. -->
        <LinearLayout
            android:id="@+id/buttons_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/profile_container"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/profile_container">

            <!-- Audio column: pink circle on top, coin + label below. -->
            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/iv_audio_circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginVertical="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:outlineAmbientShadowColor="#E91E63"
                    android:outlineSpotShadowColor="#E91E63"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_audio"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/audio"
                        app:tint="#E91E63" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_audio_coin"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/coin_d" />

                    <TextView
                        android:id="@+id/tv_audio_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Audio"
                        android:textColor="@color/black_light"
                        android:textSize="11sp"
                        tools:text="Audio" />
                </LinearLayout>
            </LinearLayout>

            <!-- Vertical divider between audio and video columns. -->
            <View
                android:layout_width="1dp"
                android:layout_height="42dp"
                android:layout_marginHorizontal="4dp"
                android:background="#33000000" />

            <!-- Video column: purple circle on top, coin + label below. -->
            <LinearLayout
                android:layout_width="68dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/iv_video_circle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginVertical="3dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:outlineAmbientShadowColor="#9C27B0"
                    android:outlineSpotShadowColor="#9C27B0"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/iv_video"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/video"
                        app:tint="#9C27B0" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_video_coin"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:src="@drawable/coin_d" />

                    <TextView
                        android:id="@+id/tv_video_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="3dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="Video"
                        android:textColor="@color/black_light"
                        android:textSize="11sp"
                        tools:text="Video" />
                </LinearLayout>
            </LinearLayout>

            <!-- Old bottom-row container kept hidden (Amount/Chat refs preserved for binding). -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:orientation="horizontal">

                <!-- Amount TextView for Creator Side (Below Audio) -->
                <TextView
                    android:id="@+id/tv_amount"
                    android:layout_width="40dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:text="₹0"
                    android:gravity="center"
                    android:textColor="@color/green"
                    android:textSize="9sp"
                    android:fontFamily="@font/poppins_bold"
                    android:textStyle="bold"
                    android:visibility="gone"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:background="@drawable/rounded_green_light_bg" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/iv_chat_circle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/grey_extra_light"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="2dp"
                    app:rippleColor="@color/colorAccent">

                    <ImageView
                        android:id="@+id/iv_chat"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_chat_bubble"
                        app:tint="@color/grey_medium" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>

        <!-- Hidden Divider -->
        <View
            android:id="@+id/v_divider"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>