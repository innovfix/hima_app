<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F3F6">

    <!-- App bar -->
    <LinearLayout
        android:id="@+id/app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"
        android:elevation="2dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#333333"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/tv_toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Ticket"
            android:textColor="#20242C"
            android:textSize="17sp"
            android:fontFamily="@font/poppins_semibold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:padding="14dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- meta row: status badge + date -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="Active"
                    android:textColor="@android:color/white"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="11dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/rounded_background"
                    android:backgroundTint="#E91E63" />

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text=""
                    android:textColor="#8B94A4"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular" />

            </RelativeLayout>

            <!-- ONE unified card: your issue + reply -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ◉ Your issue -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="◉ YOUR ISSUE"
                        android:textColor="#C11F6A"
                        android:textSize="11sp"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/poppins_semibold" />

                    <TextView
                        android:id="@+id/tv_topic"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text=""
                        android:textColor="#8B94A4"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/poppins_regular"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tv_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text=""
                        android:textColor="#2A2F38"
                        android:textSize="14sp"
                        android:lineSpacingExtra="3dp"
                        android:fontFamily="@font/poppins_regular" />

                    <TextView
                        android:id="@+id/tv_user_att_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="📎 You attached"
                        android:textColor="#8B94A4"
                        android:textSize="11sp"
                        android:fontFamily="@font/poppins_medium"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/ll_user_thumbs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        android:visibility="gone" />

                    <!-- divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="15dp"
                        android:background="#ECEEF3" />

                    <!-- 💬 Reply from Support -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 REPLY FROM SUPPORT"
                        android:textColor="#2B62C4"
                        android:textSize="11sp"
                        android:letterSpacing="0.04"
                        android:fontFamily="@font/poppins_semibold" />

                    <!-- reply present -->
                    <LinearLayout
                        android:id="@+id/ll_reply_wrap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="10dp"
                        android:padding="13dp"
                        android:background="@drawable/bg_reply_box"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tv_reply"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#2A2F38"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:id="@+id/tv_admin_att_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="📎 Support attached"
                            android:textColor="#8B94A4"
                            android:textSize="11sp"
                            android:fontFamily="@font/poppins_medium"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/ll_admin_thumbs"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- no reply yet -->
                    <LinearLayout
                        android:id="@+id/ll_no_reply"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No reply yet — our team will respond here."
                            android:textColor="#8B94A4"
                            android:textSize="12.5sp"
                            android:textStyle="italic"
                            android:fontFamily="@font/poppins_regular" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="⏳ Waiting for the support team"
                            android:textColor="#B26A06"
                            android:textSize="12sp"
                            android:fontFamily="@font/poppins_medium"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="9dp"
                            android:background="@drawable/bg_pending_pill" />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
