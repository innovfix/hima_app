<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp"
    android:backgroundTint="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="11dp">

        <!-- Transaction Icon Background -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cv_icon_background"
            android:layout_width="38dp"
            android:layout_height="38dp"
            app:cardCornerRadius="19dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F8F9FA"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_transaction_icon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_wallet_add"
                android:contentDescription="@string/edit" />

        </androidx.cardview.widget.CardView>

        <!-- Transaction Title -->
        <TextView
            android:id="@+id/tv_transaction_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:text="Audio session with Akhila076"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="#1F2937"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@+id/cv_icon_background"
            app:layout_constraintEnd_toStartOf="@+id/iv_coin"
            app:layout_constraintTop_toTopOf="@+id/cv_icon_background"
            app:layout_constraintHorizontal_bias="0" />

        <!-- Transaction Date/Time and Duration -->
        <TextView
            android:id="@+id/tv_transaction_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="Oct 07 · 22 sec"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#6B7280"
            android:lineSpacingExtra="0dp"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="@+id/tv_transaction_title"
            app:layout_constraintEnd_toStartOf="@+id/iv_coin"
            app:layout_constraintTop_toBottomOf="@+id/tv_transaction_title" />

        <!-- Transaction Hint (Session ID) - Hidden by default -->
        <TextView
            android:id="@+id/tv_transaction_hint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:text="Session ID: 12345"
            android:textSize="10sp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="#9CA3AF"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toStartOf="@+id/tv_transaction_date"
            app:layout_constraintEnd_toStartOf="@+id/iv_coin"
            app:layout_constraintTop_toBottomOf="@+id/tv_transaction_date" />

        <!-- Coin Icon -->
        <ImageView
            android:id="@+id/iv_coin"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/coin_d"
            android:layout_marginEnd="4dp"
            app:layout_constraintEnd_toStartOf="@+id/tv_coins"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:contentDescription="@string/edit" />

        <!-- Coins Amount -->
        <TextView
            android:id="@+id/tv_coins"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-10"
            android:textSize="15sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#EF4444"
            android:gravity="end"
            android:maxLines="1"
            app:layout_constraintEnd_toStartOf="@+id/tv_bonus"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- F1: inline duration-bonus for a call row, e.g. "+₹3" (gold). Gone unless bonus>0. -->
        <TextView
            android:id="@+id/tv_bonus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_bold"
            android:textColor="#C08A00"
            android:maxLines="1"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_coins"
            tools:text="+₹3" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>