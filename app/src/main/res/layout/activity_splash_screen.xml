<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="@drawable/splash_gradient_background"
    tools:context=".activities.SplashScreenActivity">

    <!-- Animated background circles -->
    <View
        android:id="@+id/circle1"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:alpha="0.1"
        android:background="@drawable/splash_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.2" />

    <View
        android:id="@+id/circle2"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:alpha="0.15"
        android:background="@drawable/splash_circle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.9"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.7" />

    <!-- Center content container -->
    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo container with animated ring -->
        <androidx.cardview.widget.CardView
            android:id="@+id/logoContainer"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:elevation="16dp"
            app:cardBackgroundColor="@color/colorPrimary"
            app:cardCornerRadius="80dp"
            app:cardElevation="16dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="35dp">

                <ImageView
                    android:id="@+id/imageViewLogo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:src="@drawable/logo"
                    android:contentDescription="@string/app_name" />

            </FrameLayout>

        </androidx.cardview.widget.CardView>

        <!-- Animated ring around logo -->
        <View
            android:id="@+id/pulseRing"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginTop="-170dp"
            android:alpha="0.6"
            android:background="@drawable/splash_pulse_ring" />

        <!-- App name with fade animation -->
        <TextView
            android:id="@+id/appNameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:alpha="0"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.1"
            android:text="@string/app_name"
            android:textColor="@android:color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Tagline with slide up animation -->
        <TextView
            android:id="@+id/taglineText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.05"
            android:text="Where Feelings Connect"
            android:textColor="#E0FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

    <!-- Loading animation at bottom -->
    <LinearLayout
        android:id="@+id/loadingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="64dp"
        android:alpha="0"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Modern loading dots — fixed height gives physical room for the upward bounce -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_horizontal|bottom"
            android:orientation="horizontal">

            <View
                android:id="@+id/loadingDot1"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/splash_loading_dot" />

            <View
                android:id="@+id/loadingDot2"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/splash_loading_dot" />

            <View
                android:id="@+id/loadingDot3"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/splash_loading_dot" />

        </LinearLayout>

        <TextView
            android:id="@+id/loadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-light"
            android:text="Loading..."
            android:textColor="#C0FFFFFF"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Particle effect overlay (optional) -->
    <View
        android:id="@+id/particleOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.05"
        android:background="@drawable/splash_particle_effect" />

</androidx.constraintlayout.widget.ConstraintLayout>