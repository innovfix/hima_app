<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <!-- Top App Bar with Elevation -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/top_bar_card"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:cardElevation="2dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/chat_surface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="10dp"
            android:background="@color/chat_surface">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_back"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="@color/chat_header_control_bg"
                app:contentPadding="0dp">

                <ImageView
                    android:id="@+id/iv_back"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_back"
                    android:contentDescription="@string/chat_back_desc"
                    app:tint="@color/chat_attach_tint" />

            </androidx.cardview.widget.CardView>

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_user"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/chat_peer_avatar_desc"
                android:src="@drawable/logo"
                app:civ_border_width="2dp"
                app:civ_border_color="#FFE5F1" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Username"
                    android:textSize="17sp"
                    android:textColor="@color/chat_text_received"
                    android:fontFamily="@font/poppins_semibold"
                    android:letterSpacing="-0.01"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="1dp">

                    <View
                        android:id="@+id/v_online_indicator"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:visibility="gone"
                        android:background="@drawable/splash_circle"
                        android:backgroundTint="@color/online_green" />

                    <TextView
                        android:id="@+id/tv_user_status"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text=""
                        android:textSize="12sp"
                        android:textColor="@color/online_green"
                        android:fontFamily="@font/poppins_medium"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </LinearLayout>

            <!-- Call Buttons Container -->
            <LinearLayout
                android:id="@+id/call_buttons_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginEnd="4dp"
                android:visibility="gone">

                <!-- Audio Call — icon + rate label -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginEnd="20dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_audio_call"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:rippleColor="#1AE91E63"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_audio_call"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/audio"
                                android:contentDescription="@string/chat_audio_call_desc"
                                app:tint="#E91E63" />
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/coin_d"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_audio_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="10/min"
                            android:textSize="9sp"
                            android:textColor="#E91E63"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Video Call — icon + rate label -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cv_video_call"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:rippleColor="#1A9C27B0"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_video_call"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/video"
                                android:contentDescription="@string/chat_video_call_desc"
                                app:tint="#9C27B0" />
                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                        <ImageView
                            android:layout_width="9dp"
                            android:layout_height="9dp"
                            android:src="@drawable/coin_d"
                            android:layout_marginEnd="2dp"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tv_video_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="60/min"
                            android:textSize="9sp"
                            android:textColor="#9C27B0"
                            android:fontFamily="@font/poppins_medium"
                            android:includeFontPadding="false" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <ImageView
                android:id="@+id/iv_more"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/baseline_more_vert_24"
                android:contentDescription="@string/chat_more_desc"
                android:padding="14dp"
                app:tint="@color/chat_attach_tint" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Call Rate Banner (below top bar, above messages) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_rate_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="#FFF1F7"
        app:cardCornerRadius="14dp"
        app:cardElevation="0dp"
        app:strokeColor="#FFD6E6"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar_card"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/coin_d"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tv_rate_banner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/colorAccent"
                android:textSize="12sp"
                android:letterSpacing="0.01"
                tools:text="Audio 10 coins/min  ·  Video 60 coins/min" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Add as friend banner (below rate banner, above messages) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/banner_add_friend"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginTop="6dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/grey_extra_light"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cv_rate_banner">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

            <TextView
                android:id="@+id/tv_banner_add_friend_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/chat_text_received"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Add Alex as a friend?" />

            <LinearLayout
                android:id="@+id/banner_add_friend_actions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="end"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_banner_add_friend_title">

                <TextView
                    android:id="@+id/btn_banner_not_now"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/selectableItemBackground"
                    android:fontFamily="@font/poppins_medium"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="6dp"
                    android:text="@string/chat_add_friend_not_now"
                    android:textColor="@color/grey_medium"
                    android:textSize="14sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_banner_accept_friend"
                    style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="40dp"
                    android:paddingHorizontal="16dp"
                    android:text="@string/chat_add_friend_yes"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:backgroundTint="@color/colorAccent" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Messages List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_messages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_chat_wallpaper"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/banner_add_friend"
        app:layout_constraintBottom_toTopOf="@id/message_input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_new_messages"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="10dp"
        android:minHeight="40dp"
        android:paddingHorizontal="14dp"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:visibility="gone"
        app:backgroundTint="@color/colorAccent"
        app:cornerRadius="20dp"
        app:icon="@drawable/ic_arrow_down"
        app:iconGravity="textStart"
        app:iconPadding="4dp"
        app:layout_constraintBottom_toTopOf="@id/message_input_container"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1 new message" />

    <!-- Shown when history fails to load (e.g. 429) and there is nothing to show -->
    <LinearLayout
        android:id="@+id/layout_history_error"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/banner_add_friend"
        app:layout_constraintBottom_toTopOf="@id/message_input_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_history_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="@string/chat_history_error_generic"
            android:textColor="#6B7280"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_history_retry"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/chat_history_retry"
            android:textAllCaps="false" />
    </LinearLayout>

    <!-- Message Input Container -->
    <LinearLayout
        android:id="@+id/message_input_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/chat_surface"
        android:elevation="4dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/layout_reply_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#F3F4F6"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:visibility="gone">

            <View
                android:layout_width="3dp"
                android:layout_height="36dp"
                android:background="@color/colorAccent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_reply_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="#6B7280"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_reply_snippet"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="2"
                    android:textColor="#374151"
                    android:textSize="14sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/iv_reply_close"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/chat_reply_clear"
                android:padding="8dp"
                android:src="@drawable/baseline_close_24"
                app:tint="#6B7280" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/recording_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/chat_recording_bar_bg"
            android:gravity="center_vertical"
            android:minHeight="42dp"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp"
            android:visibility="gone">

            <View
                android:id="@+id/v_recording_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/chat_recording_dot" />

            <TextView
                android:id="@+id/tv_recording_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/chat_recording_timer_zero"
                android:textColor="@color/chat_text_received"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_recording_hint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_regular"
                android:gravity="end"
                android:text="@string/chat_recording_slide_cancel"
                android:textColor="@color/grey_medium"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/chat_input_background">

                <ImageView
                    android:id="@+id/iv_attach"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clickable="true"
                    android:contentDescription="@string/chat_attach_desc"
                    android:focusable="true"
                    android:padding="10dp"
                    android:src="@drawable/baseline_add_24"
                    app:tint="@color/chat_attach_tint" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/chat_input_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="6dp"
                android:paddingVertical="2dp">

                <EditText
                    android:id="@+id/et_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/poppins_regular"
                    android:hint="@string/chat_input_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="2000"
                    android:maxLines="4"
                    android:paddingVertical="12dp"
                    android:scrollbars="vertical"
                    android:textColor="@color/chat_text_received"
                    android:textColorHint="@color/chat_time_received"
                    android:textSize="15sp" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp">

                <ImageButton
                    android:id="@+id/btn_mic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chat_send_btn"
                    android:contentDescription="@string/chat_record_audio_desc"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_mic" />

                <ImageButton
                    android:id="@+id/btn_send"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_chat_send_btn"
                    android:contentDescription="@string/chat_send_message_desc"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_send"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>



