<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:paddingVertical="3dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:clipChildren="false">

        <LinearLayout
            android:id="@+id/bubble_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="280dp"
            android:background="@drawable/chat_bubble_receiver"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp"
            android:elevation="1dp">

            <include
                android:id="@+id/layout_reply_quote"
                layout="@layout/view_reply_quote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hey! How are you?"
                android:textSize="14.5sp"
                android:textColor="@color/chat_text_received"
                android:fontFamily="@font/poppins_regular"
                android:lineHeight="20dp"
                android:lineSpacingExtra="1dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="3dp">

                <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:30 AM"
                    android:textSize="10sp"
                    android:textColor="@color/chat_time_received"
                    android:letterSpacing="0.02"
                    android:fontFamily="@font/poppins_regular" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_reaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/bubble_container"
            android:layout_alignEnd="@id/bubble_container"
            android:layout_marginTop="-14dp"
            android:layout_marginEnd="-8dp"
            android:minWidth="28dp"
            android:minHeight="28dp"
            android:padding="6dp"
            android:gravity="center"
            android:text="👍"
            android:textSize="16sp"
            android:background="@drawable/bg_reaction_circle"
            android:elevation="3dp"
            android:visibility="gone" />

    </RelativeLayout>

</LinearLayout>


