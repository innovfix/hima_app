<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".activities.HelpAndSupportActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:elevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Back Button Card with Subtle Shadow -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cv_back"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="1dp"
                app:cardBackgroundColor="#F8F9FA">

            <ImageView
                android:id="@+id/iv_back"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                android:contentDescription="Back"
                android:src="@drawable/right_arrow"
                android:rotation="180"
                    app:tint="#374151" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:text="Help and Support"
                android:textColor="#212121"
                android:textSize="20sp"
                android:fontFamily="@font/poppins_medium" />

        </LinearLayout>

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Content Container -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Your Tickets Section -->
            <TextView
                android:id="@+id/tv_your_tickets_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your tickets"
                android:textColor="#212121"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginBottom="12dp"
                android:visibility="visible" />

            <!-- Tickets Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_your_tickets"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:visibility="visible">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <View
                        android:id="@+id/icon_bg_ticket"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/pink_extra_light"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/iv_ticket_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/pink"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_ticket"
                        app:layout_constraintEnd_toEndOf="@+id/icon_bg_ticket"
                        app:layout_constraintStart_toStartOf="@+id/icon_bg_ticket"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_ticket" />

                    <LinearLayout
                        android:id="@+id/ll_ticket_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintEnd_toStartOf="@+id/iv_arrow"
                        app:layout_constraintStart_toEndOf="@+id/icon_bg_ticket"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_ticket"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_ticket">

                        <TextView
                            android:id="@+id/tv_raised_ticket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Raised Ticket"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold" />

                        <TextView
                            android:id="@+id/tv_active_tickets"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No ticket raised"
                            android:textColor="#9E9E9E"
                            android:textSize="14sp"
                            android:fontFamily="@font/poppins_regular"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_arrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/right_arrow"
                        app:tint="#9E9E9E"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_ticket"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_ticket" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Create a new ticket Section (for Male users) -->
            <TextView
                android:id="@+id/tv_create_ticket_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create a new ticket"
                android:textColor="#212121"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <!-- Raise New Ticket Card (for Male users) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_raise_ticket"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                android:visibility="gone">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <View
                        android:id="@+id/icon_bg_raise_ticket"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="@color/pink_extra_light"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageView
                        android:id="@+id/iv_raise_ticket_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/pink"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_raise_ticket"
                        app:layout_constraintEnd_toEndOf="@+id/icon_bg_raise_ticket"
                        app:layout_constraintStart_toStartOf="@+id/icon_bg_raise_ticket"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_raise_ticket" />

                    <LinearLayout
                        android:id="@+id/ll_raise_ticket_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        app:layout_constraintEnd_toStartOf="@+id/iv_raise_arrow"
                        app:layout_constraintStart_toEndOf="@+id/icon_bg_raise_ticket"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_raise_ticket"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_raise_ticket">

                        <TextView
                            android:id="@+id/tv_raise_ticket"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Raise new ticket"
                            android:textColor="#212121"
                            android:textSize="16sp"
                            android:fontFamily="@font/poppins_semibold" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/iv_raise_arrow"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/right_arrow"
                        app:tint="#9E9E9E"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_raise_ticket"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_raise_ticket" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Select Category Section -->
            <TextView
                android:id="@+id/tv_select_category_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Please select a category"
                android:textColor="#212121"
                android:textSize="18sp"
                android:fontFamily="@font/poppins_semibold"
                android:layout_marginBottom="12dp" />

            <!-- RecyclerView for Categories -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_categories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:listitem="@layout/item_category" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No categories available"
        android:textColor="#9E9E9E"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_regular"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

