<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_menu_background"
    android:padding="8dp"
    android:elevation="8dp">

    <!-- Accept as friend (female overflow menu — visibility toggled in code) -->
    <TextView
        android:id="@+id/item_accept_as_friend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/chat_add_friend_menu_item"
        android:textSize="14sp"
        android:textColor="#1F2937"
        android:fontFamily="@font/poppins_medium"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:visibility="gone" />

    <!-- Audio / Video enable toggles removed: managed elsewhere
         (Profile screen's call-availability section), so the chat overflow
         menu now only carries Accept-as-friend + Block User. -->

    <!-- Divider -->
    <View
        android:id="@+id/divider_before_block_user"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:visibility="gone" />

    <!-- Block User Item -->
    <TextView
        android:id="@+id/item_block_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Block User"
        android:textSize="14sp"
        android:textColor="#1F2937"
        android:fontFamily="@font/poppins_medium"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- TC_CH_004: Clear chat — empties the thread locally, thread stays in list -->
    <TextView
        android:id="@+id/item_clear_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/chat_clearchat_action"
        android:textSize="14sp"
        android:textColor="#1F2937"
        android:fontFamily="@font/poppins_medium"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

    <!-- TC_CH_004: Delete chat — removes the whole thread from the list (red, destructive) -->
    <TextView
        android:id="@+id/item_delete_chat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="@string/chat_deletechat_action"
        android:textSize="14sp"
        android:textColor="#DC2626"
        android:fontFamily="@font/poppins_medium"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

</LinearLayout>
