<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/popup_menu_background"
    android:padding="8dp"
    android:elevation="8dp">

    <!-- Audio Calls Toggle Item -->
    <LinearLayout
        android:id="@+id/item_audio_calls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:minWidth="200dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Audio Calls"
            android:textSize="14sp"
            android:textColor="#1F2937"
            android:fontFamily="@font/poppins_medium" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_audio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:thumbTint="@color/switch_thumb_color_selector"
            app:trackTint="@color/switch_track_color_selector" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Video Calls Toggle Item -->
    <LinearLayout
        android:id="@+id/item_video_calls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:minWidth="200dp"
        android:background="?attr/selectableItemBackground">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Video Calls"
            android:textSize="14sp"
            android:textColor="#1F2937"
            android:fontFamily="@font/poppins_medium" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_video"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:thumbTint="@color/switch_thumb_color_selector"
            app:trackTint="@color/switch_track_color_selector" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Block User Item -->
    <TextView
        android:id="@+id/item_block_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:text="Block User"
        android:textSize="14sp"
        android:textColor="#1F2937"
        android:fontFamily="@font/poppins_medium"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical" />

</LinearLayout>


