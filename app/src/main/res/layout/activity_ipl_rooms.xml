<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#070E1A">

    <!-- Fantasy Header Banner -->
    <LinearLayout
        android:id="@+id/header_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ipl_room_header_bg"
        android:orientation="vertical"
        android:paddingTop="48dp"
        android:paddingBottom="28dp"
        android:paddingHorizontal="20dp">

        <!-- Back + Title Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_baseline_arrow_back_ios_24"
                android:padding="6dp"
                android:contentDescription="Back"
                app:tint="@color/white"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fantasy_ipl_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:fontFamily="@font/poppins_bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/fantasy_ipl_subtitle"
                    android:textColor="#B0FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_regular"/>
            </LinearLayout>

            <!-- Cricket Ball Icon with glow effect -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <View
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_team_circle"
                    android:backgroundTint="#20FF6B35"
                    android:alpha="0.5" />

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_cricket_ball"
                    android:contentDescription="Cricket"/>
            </FrameLayout>
        </LinearLayout>

        <!-- Live Match Count Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Live indicator dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_team_circle"
                android:backgroundTint="#FF3D3D" />

            <TextView
                android:id="@+id/tv_live_rooms_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="@string/fantasy_live_rooms"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Rooms RecyclerView wrapped in SwipeRefreshLayout for pull-to-refresh -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="170dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_rooms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="12dp"
            android:paddingBottom="100dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/adapter_ipl_room"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/ll_empty_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="170dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_cricket_ball"
            android:alpha="0.3"
            android:contentDescription="No rooms"/>

        <TextView
            android:id="@+id/tv_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/fantasy_no_rooms"
            android:textColor="#80FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold"/>

        <TextView
            android:id="@+id/tv_empty_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/fantasy_no_rooms_sub"
            android:textColor="#50FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular"/>
    </LinearLayout>

    <!-- FAB: Create Room -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fab_create_room"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="24dp"
        android:text="@string/create_room"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_bold"
        android:textAllCaps="false"
        android:textAlignment="center"
        android:gravity="center"
        android:elevation="12dp"
        app:backgroundTint="#FF6B35"
        app:cornerRadius="28dp"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
