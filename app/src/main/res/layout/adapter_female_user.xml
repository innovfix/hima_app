<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="8dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:rippleColor="#33FFFFFF"
    app:strokeColor="#40FFFFFF"
    app:strokeWidth="1dp">

    <!-- Full-card gradient background + diagonal shimmer.
         Sits as first child so MaterialCardView clips it to 16dp corners. -->
    <View
        android:id="@+id/v_card_top_highlight"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_user_card" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="14dp">

        <!-- Profile Image with Online Indicator -->
        <FrameLayout
            android:id="@+id/card_profile"
            android:layout_width="58dp"
            android:layout_height="58dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_profile"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/small_profile"
                app:civ_border_color="#D040E0"
                app:civ_border_width="2.5dp"
                tools:src="@drawable/small_profile" />

            <!-- Online Indicator Dot -->
            <View
                android:id="@+id/online_indicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/circle_bg_green"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Right-side text column -->
        <LinearLayout
            android:id="@+id/text_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/card_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_profile"
            app:layout_constraintTop_toTopOf="@id/card_profile">

            <!-- Top row: name + NEW + STAR + IPL chip / time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:text="User Name"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    tools:text="Sarah" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/starBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFC107"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    tools:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="⭐ STAR"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- IPL Team Badge (top-right of name row) — chip background is
                     set to the team color at bind time so every team is visible. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ipl_team_badge_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#22000000"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <TextView
                            android:id="@+id/tv_ipl_team_abbr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="MI"
                            android:textColor="@color/white"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Bottom row: last message + time_bottom + unread badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_last_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:text="@string/tap_to_call_and_chat"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    tools:text="Hey! How are you doing today?" />

                <!-- Time (bottom-right) — always below the last message -->
                <TextView
                    android:id="@+id/tv_time_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="10:30 AM"
                    tools:visibility="visible" />

                <!-- Unread Count Badge -->
                <TextView
                    android:id="@+id/tv_unread_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minWidth="22dp"
                    android:minHeight="22dp"
                    android:background="@drawable/circle_bg_red"
                    android:backgroundTint="@color/colorAccent"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="5"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Audio & Video Call Buttons -->
            <LinearLayout
                android:id="@+id/call_buttons_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btn_audio_call"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/button_audio_gradient"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    tools:ignore="UselessParent">

                    <ImageView
                        android:id="@+id/iv_audio_icon"
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_phone"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/iv_audio_coin"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/coin_d" />

                    <TextView
                        android:id="@+id/tv_audio_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="10/min"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        tools:text="10/min" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btn_video_call"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/button_video_gradient"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    tools:ignore="UselessParent">

                    <ImageView
                        android:id="@+id/iv_video_icon"
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:contentDescription="@null"
                        android:src="@drawable/baseline_video_chat_24"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/iv_video_coin"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="5dp"
                        android:contentDescription="@null"
                        android:src="@drawable/coin_d" />

                    <TextView
                        android:id="@+id/tv_video_rate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="60/min"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        tools:text="60/min" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- NEW badge — top-left edge of the card, modern pill with bottom-rounded
         corners so it visually "hangs" from the card's top edge. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/newUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginTop="0dp"
        android:layout_marginStart="20dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_new_badge_tab"
            android:paddingHorizontal="12dp"
            android:paddingVertical="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.18"
                android:text="NEW"
                android:textColor="@color/white"
                android:textSize="9sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</com.google.android.material.card.MaterialCardView>
