<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Profile Image Section (Left Side) - Reduced Height -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_profile"
            android:layout_width="130dp"
            android:layout_height="140dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="3dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/floating_buttons">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Profile Image -->
                <ImageView
                    android:id="@+id/iv_profile"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/star" />

                <!-- Full Gradient Overlay -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/profile_gradient_shade" />

                <!-- Click to View Badge at Bottom -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:background="#CC000000"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/ic_info"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Click to view"
                        android:textColor="@color/white"
                        android:fontFamily="@font/poppins_medium"
                        android:textSize="8sp"
                        android:letterSpacing="0.02" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- IPL Team Badge (Bottom-Left of Profile Image) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/ipl_team_badge_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="28dp"
            android:visibility="gone"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="10dp"
            app:cardElevation="4dp"
            app:layout_constraintBottom_toBottomOf="@id/card_profile"
            app:layout_constraintStart_toStartOf="@id/card_profile">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_ipl_team_badge_small"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/ipl_team_dot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/bg_team_circle" />

                <TextView
                    android:id="@+id/tv_ipl_team_abbr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="@color/white"
                    android:textSize="8sp"
                    android:text="MI" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- New User Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/newUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="6dp"
            android:visibility="visible"
            app:cardBackgroundColor="@color/colorAccent"
            app:cardCornerRadius="8dp"
            app:cardElevation="3dp"
            app:layout_constraintEnd_toEndOf="@id/card_profile"
            app:layout_constraintTop_toTopOf="@id/card_profile">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="NEW"
                android:textColor="@color/white"
                android:textSize="8sp"
                android:letterSpacing="0.08" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Online Indicator Badge (Right Side) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/onlineIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_marginTop="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="#10B981"
            app:cardCornerRadius="8dp"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="5dp"
                android:paddingVertical="2dp">

                <View
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="3dp"
                    android:background="@drawable/online_indicator" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ONLINE"
                    android:textColor="@color/white"
                    android:fontFamily="@font/poppins_semibold"
                    android:textSize="8sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Right Side Content Area -->
        <LinearLayout
            android:id="@+id/content_area"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/floating_buttons">

            <!-- Name -->
            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_bold"
                android:maxLines="1"
                android:text="Username"
                android:textColor="@color/creator_name_text"
                android:textSize="17sp"
                android:letterSpacing="-0.01" />

            <!-- Language Tag -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/language_tag_background"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_language"
                    app:tint="@color/creator_language_text" />

                <TextView
                    android:id="@+id/tv_language"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Tamil"
                    android:textColor="@color/creator_language_text"
                    android:textSize="9sp"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Single Interest Tag -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_interests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false" />

            <!-- Bio/Summary Section -->
            <TextView
                android:id="@+id/tv_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_regular"
                android:lineHeight="15dp"
                android:maxLines="2"
                android:text="Let's Explore the world and be smiley."
                android:textColor="@color/creator_description_text"
                android:textSize="10.5sp"
                android:letterSpacing="0.01" />
        </LinearLayout>

        <!-- Action Buttons (Bottom) -->
        <LinearLayout
            android:id="@+id/floating_buttons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/card_profile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Audio Call Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_audio"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/colorAccent"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_audio_gradient"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/iv_audio"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_phone_premium"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/iv_audio_coin"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/coin_d" />

                    <TextView
                        android:id="@+id/tv_iv_audio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="10/min"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.01" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Video Call Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_video"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="22dp"
                app:cardElevation="3dp"
                app:rippleColor="@color/white"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/button_video_gradient"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:id="@+id/iv_video"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginEnd="4dp"
                        android:src="@drawable/ic_video_premium"
                        app:tint="@color/white" />

                    <ImageView
                        android:id="@+id/iv_video_coin"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:layout_marginEnd="3dp"
                        android:src="@drawable/coin_d" />

                    <TextView
                        android:id="@+id/tv_video"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:text="60/min"
                        android:textColor="@color/white"
                        android:textSize="11sp"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.01" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
