<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:rippleColor="@color/light_grey"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <!-- Card background highlight overlay — hidden in white theme. -->
    <View
        android:id="@+id/v_card_top_highlight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:padding="14dp">

        <!-- NEW badge — separate row at top-right, above all other content. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/newUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardBackgroundColor="#FF2E9A"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:includeFontPadding="false"
                android:letterSpacing="0.15"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="NEW"
                android:textColor="@color/white"
                android:textSize="9sp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile Image with Online Indicator — below the NEW badge row. -->
        <FrameLayout
            android:id="@+id/card_profile"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/newUser"
            app:layout_constraintVertical_bias="0.0"
            app:layout_goneMarginTop="0dp">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_profile"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/small_profile"
                app:civ_border_color="#FFE5F1"
                app:civ_border_width="2dp"
                tools:src="@drawable/small_profile" />

            <!-- Online Indicator Dot -->
            <View
                android:id="@+id/online_indicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/circle_bg_green"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Right-side row — HORIZONTAL: name + call buttons.
             Vertically centered with the profile pic. -->
        <LinearLayout
            android:id="@+id/text_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/card_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_profile"
            app:layout_constraintTop_toTopOf="@id/card_profile">

            <!-- Name row (left, takes available width). -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:text="User Name"
                    android:textColor="@color/black_light"
                    android:textSize="16sp"
                    tools:text="Sarah" />


                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/starBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFC107"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    tools:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="⭐ STAR"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- IPL Team Badge (top-right of name row) — chip background is
                     set to the team color at bind time so every team is visible. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ipl_team_badge_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#22000000"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <TextView
                            android:id="@+id/tv_ipl_team_abbr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="MI"
                            android:textColor="@color/white"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Bottom row: last message + time_bottom + unread badge -->
            <!-- Bottom row hidden in All tab — reference design shows only name + call buttons. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:visibility="gone"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_last_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:text="@string/tap_to_call_and_chat"
                    android:textColor="@color/grey_medium"
                    android:textSize="13sp"
                    tools:text="Hey! How are you doing today?" />

                <!-- Time (bottom-right) — always below the last message -->
                <TextView
                    android:id="@+id/tv_time_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text=""
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="10:30 AM"
                    tools:visibility="visible" />

                <!-- Unread Count Badge -->
                <TextView
                    android:id="@+id/tv_unread_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minWidth="22dp"
                    android:minHeight="22dp"
                    android:background="@drawable/circle_bg_red"
                    android:backgroundTint="@color/colorAccent"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="5"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- Audio & Video Call Buttons — fixed width on the right of the row. -->
            <LinearLayout
                android:id="@+id/call_buttons_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Audio column: pink CIRCLE on top, coin + 10/min text below.
                     Fixed 68dp width so "Unavailable" can't expand and break the row. -->
                <LinearLayout
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_audio_call"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginVertical="3dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp">

                        <ImageView
                            android:id="@+id/iv_audio_icon"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/audio"
                            app:tint="#E91E63" />
                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_audio_coin"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/coin_d" />

                        <TextView
                            android:id="@+id/tv_audio_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="10/min"
                            android:textColor="@color/black_light"
                            android:textSize="11sp"
                            tools:text="10/min" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Vertical divider between audio and video columns. -->
                <View
                    android:layout_width="1dp"
                    android:layout_height="42dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="#33FFFFFF" />

                <!-- Video column: purple CIRCLE on top, coin + 60/min text below.
                     Fixed 68dp width so "Unavailable" can't expand and break the row. -->
                <LinearLayout
                    android:layout_width="68dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btn_video_call"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginVertical="3dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="@color/white"
                        app:cardCornerRadius="20dp"
                        app:cardElevation="3dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:id="@+id/iv_video_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/video"
                            app:tint="#9C27B0" />
                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_video_coin"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:contentDescription="@null"
                            android:src="@drawable/coin_d" />

                        <TextView
                            android:id="@+id/tv_video_rate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/poppins_semibold"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:text="60/min"
                            android:textColor="@color/black_light"
                            android:textSize="11sp"
                            tools:text="60/min" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
