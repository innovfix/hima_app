<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:rippleColor="@color/light_grey"
    app:strokeColor="#F0F0F0"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <!-- Profile Image with Online Indicator -->
        <FrameLayout
            android:id="@+id/card_profile"
            android:layout_width="58dp"
            android:layout_height="58dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_profile"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/small_profile"
                app:civ_border_color="#FFE5F1"
                app:civ_border_width="2dp"
                tools:src="@drawable/small_profile" />

            <!-- Online Indicator Dot -->
            <View
                android:id="@+id/online_indicator"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="2dp"
                android:layout_marginBottom="2dp"
                android:background="@drawable/circle_bg_green"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Right-side text column -->
        <LinearLayout
            android:id="@+id/text_column"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="@id/card_profile"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_profile"
            app:layout_constraintTop_toTopOf="@id/card_profile">

            <!-- Top row: name + NEW + STAR + IPL chip / time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_semibold"
                    android:maxLines="1"
                    android:text="User Name"
                    android:textColor="@color/creator_name_text"
                    android:textSize="16sp"
                    tools:text="Sarah" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/newUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/colorAccent"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    tools:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="NEW"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/starBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#FFC107"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="0dp"
                    tools:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_bold"
                        android:letterSpacing="0.06"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="1dp"
                        android:text="⭐ STAR"
                        android:textColor="@color/white"
                        android:textSize="8sp" />
                </com.google.android.material.card.MaterialCardView>

                <!-- IPL Team Badge (top-right of name row) — chip background is
                     set to the team color at bind time so every team is visible. -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/ipl_team_badge_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="8dp"
                    app:cardElevation="0dp"
                    app:strokeColor="#22000000"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp">

                        <TextView
                            android:id="@+id/tv_ipl_team_abbr"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:text="MI"
                            android:textColor="@color/white"
                            android:textSize="9sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Bottom row: last message + time_bottom + unread badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_last_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins_regular"
                    android:maxLines="1"
                    android:text="@string/tap_to_call_and_chat"
                    android:textColor="@color/grey_medium"
                    android:textSize="13sp"
                    tools:text="Hey! How are you doing today?" />

                <!-- Time (bottom-right) — always below the last message -->
                <TextView
                    android:id="@+id/tv_time_bottom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="@font/poppins_regular"
                    android:text=""
                    android:textColor="@color/grey_medium"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="10:30 AM"
                    tools:visibility="visible" />

                <!-- Unread Count Badge -->
                <TextView
                    android:id="@+id/tv_unread_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:minWidth="22dp"
                    android:minHeight="22dp"
                    android:background="@drawable/circle_bg_red"
                    android:backgroundTint="@color/colorAccent"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:paddingHorizontal="6dp"
                    android:text="0"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:visibility="gone"
                    tools:text="5"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
