<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#0F172A"
    android:paddingBottom="32dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="#2A3A52"/>

    <!-- Header with cricket ball -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:layout_marginTop="20dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_cricket_ball"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_ipl_room"
            android:textColor="#F0FFFFFF"
            android:textSize="20sp"
            android:fontFamily="@font/poppins_bold"/>
    </LinearLayout>

    <!-- Today's match label -->
    <TextView
        android:id="@+id/tv_match_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="18dp"
        android:text="Today's Match"
        android:textColor="#70FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_medium"/>

    <TextView
        android:id="@+id/tv_match_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="4dp"
        android:textColor="#FFFFFFFF"
        android:textSize="18sp"
        android:fontFamily="@font/poppins_bold"
        tools:text="MI vs CSK"
        xmlns:tools="http://schemas.android.com/tools"/>

    <!-- Choose your team header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="Choose your team"
        android:textColor="#70FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_medium"/>

    <!-- Team chips row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="20dp">

        <LinearLayout
            android:id="@+id/ll_team_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Room Name Input -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:text="Room Name"
        android:textColor="#70FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@font/poppins_medium"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#40FFFFFF"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:counterEnabled="true"
        app:counterMaxLength="30">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_room_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter room name"
            android:textColor="#F0FFFFFF"
            android:textColorHint="#50FFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_regular"
            android:maxLength="30"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:background="@android:color/transparent"/>

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Create Button (Fantasy Orange Gradient) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_create_room"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_fantasy_create_btn"
        android:text="@string/create_ipl_room"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:fontFamily="@font/poppins_bold"
        android:textAllCaps="false"
        android:enabled="false"
        android:alpha="0.5"
        app:backgroundTint="@null"
        app:cornerRadius="26dp"/>

</LinearLayout>
