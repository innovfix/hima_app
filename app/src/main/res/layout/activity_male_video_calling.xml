<?xml version="1.0" encoding="utf-8"?>
<!-- 
    PROFESSIONAL VIDEO CALLING UI DESIGN
    
    Design Features:
    - Clean dark gradient background (elegant navy blue gradient)
    - Centered timer with icon at the top
    - Professional user avatar cards with shadows
    - Control buttons at bottom in horizontal layout
    - Improved spacing and alignment throughout
    - Minimalist design with focus on call functionality
-->
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@drawable/professional_call_background">

    <!-- Local Video Preview (Small window in top-right) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/localCardView"
        android:layout_width="100dp"
        android:layout_height="140dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="80dp"
        android:visibility="visible"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/local_video_view_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/black"/>
    </androidx.cardview.widget.CardView>

    <!-- Remote Video Container (Full screen background) -->
    <FrameLayout
        android:id="@+id/remote_video_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black" />

    <!-- Top Bar Container -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:elevation="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Connection Quality Indicator -->
        <ImageView
            android:id="@+id/iv_signal_strength"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_signal_strong"
            android:contentDescription="Signal Strength"
            android:layout_marginEnd="8dp"/>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Timer Container -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/timer_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/professional_timer_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <!-- Timer Icon -->
            <ImageView
                android:id="@+id/iv_timer_icon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_timer_professional"
                android:layout_marginEnd="6dp"
                android:contentDescription="Timer"
                app:tint="#1A237E"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Timer Text -->
            <TextView
                android:id="@+id/tvRemainingTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"
                app:layout_constraintStart_toEndOf="@id/iv_timer_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <!-- Plus Icon (for adding time) -->
            <ImageView
                android:id="@+id/iv_plus"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/baseline_add_24"
                android:visibility="gone"
                android:contentDescription="Add Time"
                app:tint="#FFFFFF"
                app:layout_constraintStart_toEndOf="@id/tvRemainingTime"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <!-- Menu Button (Hidden) -->
        <ImageView
            android:id="@+id/btn_menu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:visibility="invisible"
            android:contentDescription="Menu"/>

    </LinearLayout>

    <!-- User Avatars Container (Center) -->
    <LinearLayout
        android:id="@+id/users_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:elevation="10dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/controls_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <!-- Female User Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="24dp">

            <!-- Female Avatar with Professional Border -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="60dp"
                app:cardElevation="12dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/iv_female_user"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:padding="3dp"
                    android:background="#FFFFFF"
                    android:contentDescription="Female User"/>

            </androidx.cardview.widget.CardView>

            <!-- Female Name -->
            <TextView
                android:id="@+id/tv_female_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="120dp"/>

        </LinearLayout>

        <!-- Male User Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="24dp">

            <!-- Male Avatar with Professional Border -->
            <androidx.cardview.widget.CardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardCornerRadius="60dp"
                app:cardElevation="12dp"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/iv_male_user"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:scaleType="centerCrop"
                    android:padding="3dp"
                    android:background="#FFFFFF"
                    android:contentDescription="Male User"/>

            </androidx.cardview.widget.CardView>

            <!-- Male Name -->
            <TextView
                android:id="@+id/tv_male_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="120dp"/>

        </LinearLayout>

    </LinearLayout>

    <!-- Control Buttons Container (Bottom) -->
    <LinearLayout
        android:id="@+id/controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="24dp"
        android:paddingBottom="40dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Microphone Toggle Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/btn_MuteUnmute"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/unmute_img"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Microphone"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mic"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- Speaker Toggle Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp">

                <ImageView
                    android:id="@+id/btn_speaker"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/speakeron_img"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Speaker"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Speaker"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"/>

        </LinearLayout>

        <!-- End Call Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:layout_width="64dp"
                android:layout_height="64dp">

                <ImageView
                    android:id="@+id/btn_endCall"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_end_call_bg"
                    android:src="@drawable/endcall"
                    android:padding="16dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="End Call"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="End"
                android:textColor="#E53935"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-medium"/>

        </LinearLayout>

        <!-- Video Toggle Button -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_buttons"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:visibility="visible">

            <FrameLayout
                android:id="@+id/video_button_frame"
                android:layout_width="56dp"
                android:layout_height="56dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/btn_video_call"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/professional_control_button_bg"
                    android:src="@drawable/audiocall_img"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Video"/>

            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Video"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif"
                app:layout_constraintTop_toBottomOf="@id/video_button_frame"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <!-- Debug Buttons (Hidden in production) -->
    <Button
        android:id="@+id/JoinButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Join"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/LeaveButton"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Leave"
        tools:ignore="MissingConstraints" />

    <!-- Camera Preview (for internal use) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:visibility="gone"
        tools:ignore="MissingConstraints" />

    <!-- Black Screen Overlay (for transitions) -->
    <ImageView
        android:id="@+id/blackscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@color/black"
        android:visibility="gone"
        android:contentDescription="Loading"/>

</androidx.constraintlayout.widget.ConstraintLayout>