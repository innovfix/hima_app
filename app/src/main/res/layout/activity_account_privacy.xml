<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    tools:context=".activities.AccountPrivacyActivity">

    <!-- Top App Bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@android:color/white"
        android:elevation="2dp"
        app:contentInsetLeft="0dp"
        app:contentInsetStart="0dp"
        app:contentInsetStartWithNavigation="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/include_profile_toolbar"
            layout="@layout/layout_profile_flow_toolbar"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Content Container -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Privacy Policy Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_privacy_policy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="false"
                app:rippleColor="#E0E0E0">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <!-- Icon Circle Background -->
                    <View
                        android:id="@+id/icon_bg_privacy"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#E3F2FD"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_privacy_policy"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/privacy_policy"
                        android:src="@drawable/link"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_privacy"
                        app:layout_constraintEnd_toEndOf="@+id/icon_bg_privacy"
                        app:layout_constraintStart_toStartOf="@+id/icon_bg_privacy"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_privacy"
                        app:tint="#1976D2" />

                    <TextView
                        android:id="@+id/tv_privacy_policy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/privacy_policy"
                        android:textColor="@color/black_light"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_privacy"
                        app:layout_constraintEnd_toStartOf="@+id/iv_privacy_policy_arrow"
                        app:layout_constraintStart_toEndOf="@+id/icon_bg_privacy"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_privacy" />

                    <ImageView
                        android:id="@+id/iv_privacy_policy_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/privacy_policy"
                        android:src="@drawable/right_arrow"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_privacy"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_privacy"
                        app:tint="@color/grey_medium" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Delete Account Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_delete_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@android:color/white"
                app:cardCornerRadius="14dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="false"
                app:rippleColor="#E0E0E0">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="14dp">

                    <!-- Icon Circle Background -->
                    <View
                        android:id="@+id/icon_bg_delete"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/circle_background"
                        android:backgroundTint="#FFEBEE"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:id="@+id/iv_delete_account"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/delete_account"
                        android:src="@drawable/delete"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_delete"
                        app:layout_constraintEnd_toEndOf="@+id/icon_bg_delete"
                        app:layout_constraintStart_toStartOf="@+id/icon_bg_delete"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_delete"
                        app:tint="#D32F2F" />

                    <TextView
                        android:id="@+id/tv_delete_account"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/delete_account"
                        android:textColor="@color/black_light"
                        android:textSize="16sp"
                        android:fontFamily="@font/poppins_medium"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_delete"
                        app:layout_constraintEnd_toStartOf="@+id/iv_delete_account_arrow"
                        app:layout_constraintStart_toEndOf="@+id/icon_bg_delete"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_delete" />

                    <ImageView
                        android:id="@+id/iv_delete_account_arrow"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@string/delete_account"
                        android:src="@drawable/right_arrow"
                        app:layout_constraintBottom_toBottomOf="@+id/icon_bg_delete"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/icon_bg_delete"
                        app:tint="@color/grey_medium" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>