<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingVertical="3dp">

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/bubble_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chat_bubble_receiver"
            android:maxWidth="280dp"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/chat_audio_play_received_bg"
                    android:clickable="true"
                    android:contentDescription="@null"
                    android:focusable="true"
                    android:padding="14dp"
                    android:src="@drawable/play" />

                <ProgressBar
                    android:id="@+id/progress_audio"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="120dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="10dp"
                    android:max="100"
                    android:minHeight="4dp"
                    android:progress="0"
                    android:progressDrawable="@drawable/chat_audio_progress_received" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="0:00"
                    android:textColor="@color/chat_text_received"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/poppins_regular"
                android:text="10:31 AM"
                android:textColor="@color/chat_time_received"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_reaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignEnd="@id/bubble_container"
            android:layout_below="@id/bubble_container"
            android:layout_marginEnd="-8dp"
            android:layout_marginTop="-14dp"
            android:background="@drawable/bg_reaction_circle"
            android:elevation="3dp"
            android:gravity="center"
            android:minWidth="28dp"
            android:minHeight="28dp"
            android:padding="6dp"
            android:text="👍"
            android:textSize="16sp"
            android:visibility="gone" />
    </RelativeLayout>
</LinearLayout>
