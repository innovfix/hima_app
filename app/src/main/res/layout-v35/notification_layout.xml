<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 15+ (API 35+) notification layout override.
  Prevents text from expanding under the action buttons on newer SystemUI versions.
  Lower API levels keep using res/layout/notification_layout.xml unchanged.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageView
        android:id="@+id/profile_image"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop" />

    <!-- Use weight so the text block never overlaps the end action buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/caller_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Caller"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/call_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Incoming Audio Session"
            android:textSize="14sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btn_decline"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:padding="2dp"
            android:src="@drawable/endcall"
            android:background="@null" />

        <ImageView
            android:id="@+id/btn_accept"
            android:layout_width="41dp"
            android:layout_height="41dp"
            android:scaleType="centerCrop"
            android:padding="2dp"
            android:src="@drawable/accept_audio"
            android:background="@null" />
    </LinearLayout>

</LinearLayout>

