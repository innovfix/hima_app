<?xml version="1.0" encoding="utf-8"?>
<!-- Premium Bottom Navigation Background with Enhanced Shadow and Glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Outer Glow / Shadow Layer -->
    <item 
        android:top="-12dp" 
        android:left="-8dp" 
        android:right="-8dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#15000000" />
            <corners
                android:topLeftRadius="40dp"
                android:topRightRadius="40dp" />
        </shape>
    </item>
    
    <!-- Middle Shadow Layer -->
    <item 
        android:top="-6dp" 
        android:left="-4dp" 
        android:right="-4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A000000" />
            <corners
                android:topLeftRadius="36dp"
                android:topRightRadius="36dp" />
        </shape>
    </item>
    
    <!-- Main Background with Subtle Gradient -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#FFFFFF"
                android:centerColor="#FDFDFD"
                android:endColor="#F8F9FA"
                android:type="linear" />
            
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp" />
        </shape>
    </item>
    
    <!-- Top Highlight Line (Glass effect) -->
    <item 
        android:top="0dp"
        android:left="16dp"
        android:right="16dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#40FFFFFF" />
        </shape>
    </item>
    
    <!-- Subtle Border -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#F0F0F0" />
            
            <corners
                android:topLeftRadius="32dp"
                android:topRightRadius="32dp" />
        </shape>
    </item>
    
</layer-list>

