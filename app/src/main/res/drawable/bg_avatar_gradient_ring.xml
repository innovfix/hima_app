<?xml version="1.0" encoding="utf-8"?>
<!-- Pink→purple sweep gradient ring: 52dp outer, white 44dp centre creates the ring effect -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:centerColor="#7C3AED"
                android:endColor="#FF1383"
                android:startColor="#FF1383"
                android:type="sweep" />
        </shape>
    </item>
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>
