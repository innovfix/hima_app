<?xml version="1.0" encoding="utf-8"?>
<!-- Video FAB — glassmorphic green pill.
     Layer 1: top-to-bottom rich green gradient + bright-green glass-rim stroke
     Layer 2: top-edge white shine for the glass reflection -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: deep green glass base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4CAF50"
                android:centerColor="#2E7D32"
                android:endColor="#1B5E20" />
            <stroke
                android:width="1.5dp"
                android:color="#81C784" />
            <corners android:radius="40dp" />
        </shape>
    </item>

    <!-- Layer 2: top-edge white shine -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#55FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="40dp" />
        </shape>
    </item>

</layer-list>
