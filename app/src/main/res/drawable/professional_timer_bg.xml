<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-glass timer pill — same base + stroke style as the mic/video/speaker
     control buttons so the top bar and the bottom controls feel like one
     coherent set of glass surfaces. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#80000000" />
    <stroke android:width="1.5dp" android:color="#B3FFFFFF" />
    <corners android:radius="999dp" />
</shape>
