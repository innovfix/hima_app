<?xml version="1.0" encoding="utf-8"?>
<!--
  The "My issue isn't listed" escape hatch.

  Was a dashed outline in light grey, which is the universal styling for
  DISABLED — so the one chip the spec insists is always available looked like
  the one chip you could not press.

  Now: solid pale fill, real border, dark text. Visually secondary to the pink
  options (we want people to pick a real category first) but unambiguously a
  button.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/light_grey" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="@color/grey_medium" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/grey_extra_light" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="@color/light_grey" />
        </shape>
    </item>
</selector>
