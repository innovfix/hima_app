<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient Ring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FF1383"
                android:centerColor="#FF3A9B"
                android:endColor="#FF5FB5"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- White Inner Circle -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</layer-list>

