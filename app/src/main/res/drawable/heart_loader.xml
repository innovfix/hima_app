<?xml version="1.0" encoding="utf-8"?>
<!--
    Hima branded loader — gradient heart (for light backgrounds).
    One loop (~2.6s): outline draws itself -> heart fills bottom->top ->
    soft beat at full -> drains back down -> repeat.
    Drop-in indeterminateDrawable for any indeterminate ProgressBar.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="48dp"
            android:height="48dp"
            android:viewportWidth="64"
            android:viewportHeight="64">

            <group
                android:name="beat"
                android:pivotX="32"
                android:pivotY="32">

                <!-- faint resting outline -->
                <path
                    android:name="bg"
                    android:pathData="M32,58 C12,42 4,30 4,20 C4,11 11,5 19,5 C25,5 30,9 32,14 C34,9 39,5 45,5 C53,5 60,11 60,20 C60,30 52,42 32,58 Z"
                    android:fillColor="#00000000"
                    android:strokeColor="#33223D"
                    android:strokeWidth="3" />

                <!-- liquid fill, clipped to the heart -->
                <group android:name="clip">
                    <clip-path
                        android:name="cp"
                        android:pathData="M32,58 C12,42 4,30 4,20 C4,11 11,5 19,5 C25,5 30,9 32,14 C34,9 39,5 45,5 C53,5 60,11 60,20 C60,30 52,42 32,58 Z" />
                    <group
                        android:name="fillmove"
                        android:translateY="64">
                        <path android:name="fill" android:pathData="M0,0 L64,0 L64,64 L0,64 Z">
                            <aapt:attr name="android:fillColor">
                                <gradient
                                    android:type="linear"
                                    android:startX="0" android:startY="64"
                                    android:endX="0" android:endY="0">
                                    <item android:offset="0" android:color="#A01446" />
                                    <item android:offset="1" android:color="#6A1ED8" />
                                </gradient>
                            </aapt:attr>
                        </path>
                    </group>
                </group>

                <!-- self-drawing outline on top -->
                <path
                    android:name="outline"
                    android:pathData="M32,58 C12,42 4,30 4,20 C4,11 11,5 19,5 C25,5 30,9 32,14 C34,9 39,5 45,5 C53,5 60,11 60,20 C60,30 52,42 32,58 Z"
                    android:fillColor="#00000000"
                    android:strokeWidth="3"
                    android:trimPathStart="0"
                    android:trimPathEnd="0">
                    <aapt:attr name="android:strokeColor">
                        <gradient
                            android:type="linear"
                            android:startX="8" android:startY="56"
                            android:endX="56" android:endY="8">
                            <item android:offset="0" android:color="#A01446" />
                            <item android:offset="1" android:color="#6A1ED8" />
                        </gradient>
                    </aapt:attr>
                </path>
            </group>
        </vector>
    </aapt:attr>

    <!-- fill rises then drains -->
    <target android:name="fillmove">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:repeatCount="infinite"
                android:interpolator="@android:interpolator/fast_out_slow_in">
                <propertyValuesHolder android:propertyName="translateY" android:valueType="floatType">
                    <keyframe android:fraction="0.0"  android:value="64" />
                    <keyframe android:fraction="0.18" android:value="64" />
                    <keyframe android:fraction="0.55" android:value="0" />
                    <keyframe android:fraction="0.70" android:value="0" />
                    <keyframe android:fraction="0.96" android:value="64" />
                    <keyframe android:fraction="1.0"  android:value="64" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- outline draws itself in the first ~18% -->
    <target android:name="outline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="trimPathEnd" android:valueType="floatType">
                    <keyframe android:fraction="0.0"  android:value="0" />
                    <keyframe android:fraction="0.18" android:value="1" />
                    <keyframe android:fraction="1.0"  android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>

    <!-- soft heartbeat at the full moment -->
    <target android:name="beat">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="2600"
                android:repeatCount="infinite">
                <propertyValuesHolder android:propertyName="scaleX" android:valueType="floatType">
                    <keyframe android:fraction="0.0"  android:value="1" />
                    <keyframe android:fraction="0.52" android:value="1" />
                    <keyframe android:fraction="0.60" android:value="1.08" />
                    <keyframe android:fraction="0.68" android:value="0.97" />
                    <keyframe android:fraction="0.76" android:value="1" />
                    <keyframe android:fraction="1.0"  android:value="1" />
                </propertyValuesHolder>
                <propertyValuesHolder android:propertyName="scaleY" android:valueType="floatType">
                    <keyframe android:fraction="0.0"  android:value="1" />
                    <keyframe android:fraction="0.52" android:value="1" />
                    <keyframe android:fraction="0.60" android:value="1.08" />
                    <keyframe android:fraction="0.68" android:value="0.97" />
                    <keyframe android:fraction="0.76" android:value="1" />
                    <keyframe android:fraction="1.0"  android:value="1" />
                </propertyValuesHolder>
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
