<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#552388F2" />
            <stroke android:width="1.5dp" android:color="#992388F2" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="#332388F2" />
            <stroke android:width="1dp" android:color="#662388F2" />
        </shape>
    </item>

</selector>
