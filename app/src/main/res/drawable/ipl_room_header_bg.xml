<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#1A0533"
                android:centerColor="#0D1F4B"
                android:endColor="#061A3A"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item android:top="80dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#15FF6B35"
                android:endColor="#00000000"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="28dp"
                android:bottomRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
