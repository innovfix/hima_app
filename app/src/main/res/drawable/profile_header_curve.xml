<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Main gradient background (top → bottom so top edge matches status bar) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#EC4899"
                android:startColor="#BE185D"
                android:type="linear" />
        </shape>
    </item>
    
    <!-- Overlay pattern -->
    <item android:bottom="100dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:endColor="#00FFFFFF"
                android:startColor="#20FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
