<?xml version="1.0" encoding="utf-8"?>
<!-- In-call (connected) background: solid near-black #0D0D10 to match the
     connecting screen, so connecting → connected looks consistent. The pink/purple
     glow ripples sit on top (added in the dark-theme pass). Used only by the male
     & female audio-calling layouts. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0D10"/>
        </shape>
    </item>
</layer-list>
