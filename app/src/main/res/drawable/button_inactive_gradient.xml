<?xml version="1.0" encoding="utf-8"?>
<!-- Inactive call button — muted glassmorphic slate pill.
     Layer 1: muted grey-slate gradient + soft glass-rim stroke
     Layer 2: top-edge white shine for the glass reflection -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Layer 1: muted slate glass base -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4A5266"
                android:centerColor="#2D3447"
                android:endColor="#1A2030" />
            <stroke
                android:width="1dp"
                android:color="#5A6478" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <!-- Layer 2: top-edge white shine -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#33FFFFFF"
                android:centerColor="#08FFFFFF"
                android:endColor="#00FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>

</layer-list>
