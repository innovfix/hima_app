<?xml version="1.0" encoding="utf-8"?>
<!-- Friends-Gated Chat: selected-tab pill indicator (tinted by tabIndicatorColor).
     Inset L/R by 3dp so the rounded ends clear the tab-strip edge — the last "Sent"
     pill was being sheared flat at the TabLayout padding boundary. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="3dp"
    android:insetRight="3dp">
    <shape android:shape="rectangle">
        <solid android:color="@android:color/white" />
        <corners android:radius="22dp" />
    </shape>
</inset>
