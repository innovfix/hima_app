<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="true">
        <ripple android:color="#40FFFFFF">
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/pink" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </ripple>
    </item>
    <!-- Disabled: solid grey fill, matching the app-wide disabled button style
         (kyc_button_disabled, as used on FemaleAbout / GetName / SelectLanguage). -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/kyc_button_disabled" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
