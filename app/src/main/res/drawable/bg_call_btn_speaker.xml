<?xml version="1.0" encoding="utf-8"?>
<!-- Dark-glass speaker button — green stroke for identity, dark base for contrast. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#B310B981" />
            <stroke android:width="1.5dp" android:color="#FF10B981" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="#80000000" />
            <stroke android:width="1.5dp" android:color="#CC10B981" />
        </shape>
    </item>

</selector>
