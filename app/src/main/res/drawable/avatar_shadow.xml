<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item
        android:top="4dp"
        android:left="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#40000000" />
            <size
                android:width="150dp"
                android:height="150dp" />
        </shape>
    </item>
    
    <!-- Main avatar ring -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="#FBBF24"
                android:centerColor="#EC4899"
                android:startColor="#A855F7"
                android:type="linear" />
            <size
                android:width="150dp"
                android:height="150dp" />
        </shape>
    </item>
</layer-list>
