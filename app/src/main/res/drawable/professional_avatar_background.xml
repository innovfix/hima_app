<?xml version="1.0" encoding="utf-8"?>
<!-- Professional avatar card with shadow and border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer -->
    <item
        android:top="2dp"
        android:left="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF"/>
        </shape>
    </item>
    
    <!-- Main border -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <stroke
                android:width="3dp"
                android:color="#FFFFFF"/>
        </shape>
    </item>
</layer-list>
