<?xml version="1.0" encoding="utf-8"?>
<!-- Male bottom-nav Favourite icon: filled heart when selected, outline otherwise.
     Tint (pink when checked / grey default) comes from app:itemIconTint. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:drawable="@drawable/ic_heart_filled" />
    <item android:drawable="@drawable/ic_heart_outline" />
</selector>
