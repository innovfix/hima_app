<?xml version="1.0" encoding="utf-8"?>
<!-- Vibrant pink/magenta gradient pill for the home action buttons. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="#FF1383"
        android:centerColor="#C11063"
        android:endColor="#6B0F40" />
    <corners android:radius="40dp" />
</shape>
