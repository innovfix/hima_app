<?xml version="1.0" encoding="utf-8"?>
<!-- Modern NEW tag — hangs from the top edge of a card.
     Sharp top corners + rounded bottom corners create the "tab" effect.
     Brand pink gradient fill matches the "Hi ma" title gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="linear"
        android:angle="0"
        android:startColor="#FF2E9A"
        android:endColor="#FF6FD8" />
    <corners
        android:topLeftRadius="0dp"
        android:topRightRadius="0dp"
        android:bottomLeftRadius="10dp"
        android:bottomRightRadius="10dp" />
</shape>
