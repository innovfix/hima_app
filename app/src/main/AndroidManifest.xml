    <application
        android:name=".BaseApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:replace="android:allowBackup,android:dataExtractionRules,android:fullBackupContent"
        tools:targetApi="31">

        <!-- OneSignal Notification Service Extension for DND suppression
             Runs even when app process is killed; called BEFORE the notification
             is displayed so we can preventDefault() when DND is active. -->
        <meta-data
            android:name="com.onesignal.NotificationServiceExtension"
            android:value="com.gmwapp.hima.onesignal.OneSignalNotificationServiceExtension" />

        <!-- Disable default WorkManager init so Hilt's HiltWorkerFactory is used -->
        <provider
            android:name="androidx.work.impl.WorkManagerInitializer"
            android:authorities="${applicationId}.workmanager-init"
            tools:node="remove" />

